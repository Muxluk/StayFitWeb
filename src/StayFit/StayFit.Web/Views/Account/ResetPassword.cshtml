@model StayFit.Web.Controllers.AccountController.ResetPasswordRequest

@{
    ViewData["Title"] = "Новий пароль";
}

<div class="container d-flex justify-content-center align-items-center min-vh-100" style="padding-top: 2rem;">
    <div class="card shadow-lg border-0 rounded-4 w-100" style="max-width: 450px;">
        <div class="card-body p-5">
            <!-- Індикатор кроків (Крок 3) -->
            <div class="d-flex justify-content-center mb-4">
                <div class="d-flex align-items-center">
                    <div class="step-circle bg-success text-white d-flex justify-content-center align-items-center rounded-circle" style="width: 32px; height: 32px;"><i class="bi bi-check"></i></div>
                    <div class="step-line bg-success" style="height: 2px; width: 40px;"></div>
                    <div class="step-circle bg-success text-white d-flex justify-content-center align-items-center rounded-circle" style="width: 32px; height: 32px;"><i class="bi bi-check"></i></div>
                    <div class="step-line bg-success" style="height: 2px; width: 40px;"></div>
                    <div class="step-circle bg-primary text-white d-flex justify-content-center align-items-center rounded-circle" style="width: 32px; height: 32px;">3</div>
                </div>
            </div>

            <div class="text-center mb-4">
                <h3 class="fw-bold text-dark mb-2">Встановіть новий пароль</h3>
                <p class="text-muted small">Придумайте надійний пароль для вашого акаунту.</p>
            </div>

            <form id="resetForm" asp-action="ResetPassword" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>
                
                <input asp-for="Email" type="hidden" />
                <input asp-for="Token" type="hidden" />

                <div class="form-floating mb-3">
                    <input asp-for="NewPassword" class="form-control rounded-3" id="newPassword" placeholder="Новий пароль" autocomplete="new-password" required />
                    <label asp-for="NewPassword">Новий пароль</label>
                </div>

                <div class="form-floating mb-4">
                    <input asp-for="ConfirmPassword" class="form-control rounded-3" id="confirmPassword" placeholder="Підтвердження" autocomplete="new-password" required />
                    <label asp-for="ConfirmPassword">Підтвердіть пароль</label>
                    <div class="invalid-feedback" id="confirmError">Паролі не співпадають</div>
                </div>

                <!-- Чеклист вимог до пароля -->
                <div class="bg-light p-3 rounded-3 mb-4 small">
                    <div class="fw-medium mb-2 text-dark">Вимоги до пароля:</div>
                    <ul class="list-unstyled mb-0 text-muted" id="passwordChecklist">
                        <li id="reqLength"><i class="bi bi-x-circle text-danger me-2"></i>Мінімум 8 символів</li>
                        <li id="reqUpper"><i class="bi bi-x-circle text-danger me-2"></i>Велика літера (A-Z)</li>
                        <li id="reqLower"><i class="bi bi-x-circle text-danger me-2"></i>Мала літера (a-z)</li>
                        <li id="reqDigit"><i class="bi bi-x-circle text-danger me-2"></i>Цифра (0-9)</li>
                    </ul>
                </div>

                <button type="submit" id="submitBtn" class="btn btn-primary w-100 py-3 rounded-3 fw-bold disabled">
                    Зберегти пароль
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
