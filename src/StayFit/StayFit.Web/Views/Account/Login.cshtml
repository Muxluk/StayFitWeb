@model StayFit.Web.Controllers.AccountController.LoginRequest

@{
    ViewData["Title"] = "Вхід";
}

<div class="container d-flex justify-content-center align-items-center min-vh-100" style="padding-top: 2rem;">
    <div class="card shadow-lg border-0 rounded-4 w-100" style="max-width: 450px;">
        <div class="card-body p-5">
            <div class="text-center mb-4">
                <h2 class="fw-bold text-primary mb-1">
                    <i class="bi bi-activity"></i> StayFit
                </h2>
                <p class="text-muted">Увійдіть до свого акаунту.</p>
            </div>

            <div id="loginAlert" class="alert alert-danger d-none" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <span id="loginAlertText">Сталася помилка.</span>
                <button type="button" class="btn btn-sm btn-outline-danger ms-3 d-none" id="retryBtn">Спробувати знову</button>
            </div>

            <form id="loginForm" asp-action="Login" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 d-none" id="serverValidationSummary"></div>
                
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="form-floating mb-3">
                    <input asp-for="Email" class="form-control rounded-3" autocomplete="username" id="emailInput" placeholder="name@example.com" />
                    <label asp-for="Email">Електронна пошта</label>
                    <span asp-validation-for="Email" class="text-danger small" id="emailError"></span>
                </div>

                <div class="form-floating mb-4">
                    <input asp-for="Password" class="form-control rounded-3" autocomplete="current-password" id="passwordInput" placeholder="Пароль" />
                    <label asp-for="Password">Пароль</label>
                    <span asp-validation-for="Password" class="text-danger small" id="passwordError"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="rememberMe">
                        <label class="form-check-label text-muted small" for="rememberMe">
                            Запам'ятати мене
                        </label>
                    </div>
                    <a asp-action="ForgotPassword" class="text-decoration-none small text-primary fw-medium">Забули пароль?</a>
                </div>

                <button type="submit" id="submitBtn" class="btn btn-primary w-100 py-3 rounded-3 fw-bold mb-3 position-relative">
                    <span id="submitText">Увійти</span>
                    <span id="submitSpinner" class="position-absolute top-50 start-50 translate-middle d-none">
                        <span class="spinner-border spinner-border-sm force-spin" role="status" aria-hidden="true"></span>
                    </span>
                </button>

                <div class="text-center text-muted small">
                    Немає акаунту? <a asp-action="Register" class="text-decoration-none fw-bold">Зареєструватись</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
