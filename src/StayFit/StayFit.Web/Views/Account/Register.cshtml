@model StayFit.Web.Controllers.AccountController.RegisterRequest

@{
    ViewData["Title"] = "Реєстрація";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <h2 class="fw-bold text-primary mb-1">
                            <i class="bi bi-activity"></i> StayFit
                        </h2>
                        <p class="text-muted">Готові стати кращими? Створіть акаунт зараз.</p>
                    </div>

                    <form id="registerForm" asp-action="Register" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none" id="serverValidationSummary"></div>

                        <!-- 1. Дані акаунта -->
                        <h5 class="text-primary border-bottom pb-2 mb-3 mt-4"><i class="bi bi-person-badge me-2"></i>Дані акаунта</h5>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-medium">Електронна пошта *</label>
                                <input asp-for="Email" class="form-control" autocomplete="email" required />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="UserName" class="form-label fw-medium">Ім'я користувача *</label>
                                <input asp-for="UserName" class="form-control" autocomplete="username" required minlength="3" />
                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label fw-medium">Пароль *</label>
                                <input asp-for="Password" class="form-control" id="password" autocomplete="new-password" required minlength="8" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label fw-medium">Підтвердження пароля *</label>
                                <input asp-for="ConfirmPassword" class="form-control" id="confirmPassword" autocomplete="new-password" required />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small" id="confirmPasswordError"></span>
                            </div>
                        </div>

                        <!-- 2. Особисті дані -->
                        <h5 class="text-primary border-bottom pb-2 mb-3 mt-5"><i class="bi bi-file-person me-2"></i>Особисті дані</h5>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Gender" class="form-label fw-medium">Стать *</label>
                                <select asp-for="Gender" class="form-select calc-trigger" id="gender" required>
                                    <option value="" disabled selected>Оберіть стать</option>
                                    <option value="Чоловік">Чоловіча</option>
                                    <option value="Жінка">Жіноча</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DateOfBirth" class="form-label fw-medium">Дата народження *</label>
                                <input asp-for="DateOfBirth" type="date" class="form-control calc-trigger" id="dob" required max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            </div>
                        </div>

                        <!-- 3. Фізичні параметри -->
                        <h5 class="text-primary border-bottom pb-2 mb-3 mt-5"><i class="bi bi-rulers me-2"></i>Фізичні параметри</h5>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="Weight" class="form-label fw-medium">Вага (кг) *</label>
                                <input asp-for="Weight" type="number" step="0.1" min="30" max="300" class="form-control calc-trigger" id="weight" required />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Height" class="form-label fw-medium">Зріст (см) *</label>
                                <input asp-for="Height" type="number" step="1" min="100" max="250" class="form-control calc-trigger" id="height" required />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ActivityLevel" class="form-label fw-medium">Рівень активності *</label>
                                <select asp-for="ActivityLevel" class="form-select calc-trigger" id="activityLevel" required>
                                    <option value="Sedentary">Мінімальний (сидяча робота)</option>
                                    <option value="LightlyActive">Слабкий (тренування 1-3 рази/тиж)</option>
                                    <option value="ModeratelyActive" selected>Помірний (тренування 3-5 разів/тиж)</option>
                                    <option value="VeryActive">Високий (тренування 6-7 разів/тиж)</option>
                                    <option value="SuperActive">Екстремальний (важка фіз. робота)</option>
                                </select>
                            </div>
                        </div>

                        <!-- 4. Розраховані показники -->
                        <h5 class="text-primary border-bottom pb-2 mb-3 mt-5"><i class="bi bi-calculator me-2"></i>Розраховані показники</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <div class="card bg-light border-0 h-100">
                                    <div class="card-body text-center">
                                        <h6 class="text-muted mb-2">Індекс Маси Тіла (ІМТ)</h6>
                                        <h3 class="mb-1 text-primary fw-bold" id="bmiValue">--</h3>
                                        <span class="badge bg-secondary" id="bmiCategory">Невідомо</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card bg-light border-0 h-100">
                                    <div class="card-body text-center">
                                        <h6 class="text-muted mb-2">Базовий метаболізм (BMR)</h6>
                                        <h3 class="mb-1 text-primary fw-bold" id="bmrValue">--</h3>
                                        <small class="text-muted">ккал / день</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card bg-light border-0 h-100">
                                    <div class="card-body text-center">
                                        <h6 class="text-muted mb-2">Добова норма (TDEE)</h6>
                                        <h3 class="mb-1 text-primary fw-bold" id="tdeeValue">--</h3>
                                        <small class="text-muted">ккал / день</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="alert alert-info small">
                            <i class="bi bi-info-circle me-2"></i> Ці показники автоматично збережуться у вашому профілі після реєстрації.
                        </div>

                        <!-- 5. Угода -->
                        <div class="form-check mt-4 mb-4">
                            <input class="form-check-input" type="checkbox" id="agreement" required>
                            <label class="form-check-label text-muted small" for="agreement">
                                Я погоджуюсь з умовами використання та політикою конфіденційності *
                            </label>
                            <div class="invalid-feedback">
                                Ви повинні погодитись з умовами.
                            </div>
                        </div>

                        <button type="submit" id="submitBtn" class="btn btn-primary w-100 py-3 rounded-3 fw-bold mb-3 position-relative">
                            <span id="submitText">Зареєструватись</span>
                            <span id="submitSpinner" class="position-absolute top-50 start-50 translate-middle d-none">
                                <span class="spinner-border spinner-border-sm force-spin" role="status" aria-hidden="true"></span>
                            </span>
                        </button>
                        
                        <div class="text-center text-muted small mt-4">
                            Вже є акаунт? <a asp-action="Login" class="text-decoration-none fw-bold">Увійти</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('registerForm');
            const password = document.getElementById('password');
            const confirmPassword = document.getElementById('confirmPassword');
            const confirmError = document.getElementById('confirmPasswordError');

            const gender = document.getElementById('gender');
            const dob = document.getElementById('dob');
            const weight = document.getElementById('weight');
            const height = document.getElementById('height');
            const activityLevel = document.getElementById('activityLevel');

            const bmiValue = document.getElementById('bmiValue');
            const bmiCategory = document.getElementById('bmiCategory');
            const bmrValue = document.getElementById('bmrValue');
            const tdeeValue = document.getElementById('tdeeValue');

            const serverErrors = document.querySelector('.validation-summary-errors');
            if (serverErrors) {
                document.getElementById('serverValidationSummary').classList.remove('d-none');
            }

            // Password match validation
            const checkPasswords = () => {
                if (confirmPassword.value && password.value !== confirmPassword.value) {
                    confirmPassword.classList.add('is-invalid');
                    confirmPassword.classList.remove('is-valid');
                    confirmError.textContent = "Паролі не співпадають";
                    return false;
                } else if (confirmPassword.value) {
                    confirmPassword.classList.remove('is-invalid');
                    confirmPassword.classList.add('is-valid');
                    confirmError.textContent = "";
                    return true;
                }
                return true;
            };

            password.addEventListener('input', checkPasswords);
            confirmPassword.addEventListener('input', checkPasswords);

            // BMR/TDEE/IMT Calculation
            const calculateMetrics = () => {
                const w = parseFloat(weight.value);
                const h = parseFloat(height.value);
                const g = gender.value;
                const d = dob.value;
                const a = activityLevel.value;

                if (!w || !h || !g || !d || h <= 0 || w <= 0) {
                    bmiValue.textContent = '--';
                    bmrValue.textContent = '--';
                    tdeeValue.textContent = '--';
                    bmiCategory.textContent = 'Невідомо';
                    bmiCategory.className = 'badge bg-secondary';
                    return;
                }

                // Calculate Age
                const birthDate = new Date(d);
                const today = new Date();
                let age = today.getFullYear() - birthDate.getFullYear();
                const m = today.getMonth() - birthDate.getMonth();
                if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) {
                    age--;
                }

                if (age < 0) age = 0;

                // BMI Calculation
                const hm = h / 100; // height in meters
                const bmi = w / (hm * hm);
                bmiValue.textContent = bmi.toFixed(1);

                if (bmi < 18.5) {
                    bmiCategory.textContent = 'Дефіцит ваги';
                    bmiCategory.className = 'badge bg-info';
                } else if (bmi < 25) {
                    bmiCategory.textContent = 'Норма';
                    bmiCategory.className = 'badge bg-success';
                } else if (bmi < 30) {
                    bmiCategory.textContent = 'Надлишкова вага';
                    bmiCategory.className = 'badge bg-warning text-dark';
                } else {
                    bmiCategory.textContent = 'Ожиріння';
                    bmiCategory.className = 'badge bg-danger';
                }

                // BMR Calculation (Mifflin-St Jeor)
                let bmr = (10 * w) + (6.25 * h) - (5 * age);
                if (g === 'Чоловік') {
                    bmr += 5;
                } else {
                    bmr -= 161;
                }
                bmrValue.textContent = Math.round(bmr);

                // TDEE Calculation
                let multiplier = 1.2;
                switch (a) {
                    case 'Sedentary': multiplier = 1.2; break;
                    case 'LightlyActive': multiplier = 1.375; break;
                    case 'ModeratelyActive': multiplier = 1.55; break;
                    case 'VeryActive': multiplier = 1.725; break;
                    case 'SuperActive': multiplier = 1.9; break;
                }
                tdeeValue.textContent = Math.round(bmr * multiplier);
            };

            const calcTriggers = document.querySelectorAll('.calc-trigger');
            calcTriggers.forEach(el => el.addEventListener('input', calculateMetrics));
            calcTriggers.forEach(el => el.addEventListener('change', calculateMetrics));

            // Initial calculation if fields are pre-filled
            calculateMetrics();

            // Submit validation
            form.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    document.getElementById('submitBtn').click();
                }
            });

            form.addEventListener('submit', function (e) {
                if (!form.checkValidity() || !checkPasswords()) {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    // Mark all invalid fields
                    Array.from(form.elements).forEach(input => {
                        if (!input.checkValidity()) {
                            input.classList.add('is-invalid');
                        }
                    });
                } else {
                    const submitBtn = document.getElementById('submitBtn');
                    const submitText = document.getElementById('submitText');
                    const submitSpinner = document.getElementById('submitSpinner');
                    
                    submitBtn.disabled = true;
                    submitText.classList.add('opacity-0');
                    submitSpinner.classList.remove('d-none');
                }
                
                form.classList.add('was-validated');
            });
            
            // Clean up validation state on input
            Array.from(form.elements).forEach(input => {
                input.addEventListener('input', () => {
                    if (input.checkValidity()) {
                        input.classList.remove('is-invalid');
                    }
                });
            });
        });
    </script>
}
