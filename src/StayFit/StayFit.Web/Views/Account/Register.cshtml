@model StayFit.Web.Controllers.AccountController.RegisterRequest

@{
    ViewData["Title"] = "Реєстрація";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <h2 class="fw-bold text-primary mb-1">
                            <i class="bi bi-activity"></i> StayFit
                        </h2>
                        <p class="text-muted">Готові стати кращими? Створіть акаунт зараз.</p>
                    </div>

                    <form id="registerForm" asp-action="Register" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none" id="serverValidationSummary"></div>

                        <!-- 1. Дані акаунта -->
                        <h5 class="text-primary border-bottom pb-2 mb-3 mt-4"><i class="bi bi-person-badge me-2"></i>Дані акаунта</h5>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-medium">Електронна пошта *</label>
                                <input asp-for="Email" class="form-control" autocomplete="email" required />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="UserName" class="form-label fw-medium">Ім'я користувача *</label>
                                <input asp-for="UserName" class="form-control" autocomplete="username" required minlength="3" />
                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label fw-medium">Пароль *</label>
                                <input asp-for="Password" class="form-control" id="password" autocomplete="new-password" required minlength="8" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label fw-medium">Підтвердження пароля *</label>
                                <input asp-for="ConfirmPassword" class="form-control" id="confirmPassword" autocomplete="new-password" required />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small" id="confirmPasswordError"></span>
                            </div>
                        </div>

                        <!-- 2. Особисті дані -->
                        <h5 class="text-primary border-bottom pb-2 mb-3 mt-5"><i class="bi bi-file-person me-2"></i>Особисті дані</h5>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Gender" class="form-label fw-medium">Стать *</label>
                                <select asp-for="Gender" class="form-select calc-trigger" id="gender" required>
                                    <option value="" disabled selected>Оберіть стать</option>
                                    <option value="Чоловік">Чоловіча</option>
                                    <option value="Жінка">Жіноча</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DateOfBirth" class="form-label fw-medium">Дата народження *</label>
                                <input asp-for="DateOfBirth" type="date" class="form-control calc-trigger" id="dob" required max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            </div>
                        </div>

                        <!-- 3. Фізичні параметри -->
                        <h5 class="text-primary border-bottom pb-2 mb-3 mt-5"><i class="bi bi-rulers me-2"></i>Фізичні параметри</h5>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="Weight" class="form-label fw-medium">Вага (кг) *</label>
                                <input asp-for="Weight" type="number" step="0.1" min="30" max="300" class="form-control calc-trigger" id="weight" required />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Height" class="form-label fw-medium">Зріст (см) *</label>
                                <input asp-for="Height" type="number" step="1" min="100" max="250" class="form-control calc-trigger" id="height" required />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ActivityLevel" class="form-label fw-medium">Рівень активності *</label>
                                <select asp-for="ActivityLevel" class="form-select calc-trigger" id="activityLevel" required>
                                    <option value="Sedentary">Мінімальний (сидяча робота)</option>
                                    <option value="LightlyActive">Слабкий (тренування 1-3 рази/тиж)</option>
                                    <option value="ModeratelyActive" selected>Помірний (тренування 3-5 разів/тиж)</option>
                                    <option value="VeryActive">Високий (тренування 6-7 разів/тиж)</option>
                                    <option value="SuperActive">Екстремальний (важка фіз. робота)</option>
                                </select>
                            </div>
                        </div>

                        <!-- 4. Розраховані показники -->
                        <h5 class="text-primary border-bottom pb-2 mb-3 mt-5"><i class="bi bi-calculator me-2"></i>Розраховані показники</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <div class="card bg-light border-0 h-100">
                                    <div class="card-body text-center">
                                        <h6 class="text-muted mb-2">Індекс Маси Тіла (ІМТ)</h6>
                                        <h3 class="mb-1 text-primary fw-bold" id="bmiValue">--</h3>
                                        <span class="badge bg-secondary" id="bmiCategory">Невідомо</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card bg-light border-0 h-100">
                                    <div class="card-body text-center">
                                        <h6 class="text-muted mb-2">Базовий метаболізм (BMR)</h6>
                                        <h3 class="mb-1 text-primary fw-bold" id="bmrValue">--</h3>
                                        <small class="text-muted">ккал / день</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card bg-light border-0 h-100">
                                    <div class="card-body text-center">
                                        <h6 class="text-muted mb-2">Добова норма (TDEE)</h6>
                                        <h3 class="mb-1 text-primary fw-bold" id="tdeeValue">--</h3>
                                        <small class="text-muted">ккал / день</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="alert alert-info small">
                            <i class="bi bi-info-circle me-2"></i> Ці показники автоматично збережуться у вашому профілі після реєстрації.
                        </div>

                        <!-- 5. Угода -->
                        <div class="form-check mt-4 mb-4">
                            <input class="form-check-input" type="checkbox" id="agreement" required>
                            <label class="form-check-label text-muted small" for="agreement">
                                Я погоджуюсь з умовами використання та політикою конфіденційності *
                            </label>
                            <div class="invalid-feedback">
                                Ви повинні погодитись з умовами.
                            </div>
                        </div>

                        <button type="submit" id="submitBtn" class="btn btn-primary w-100 py-3 rounded-3 fw-bold mb-3 position-relative">
                            <span id="submitText">Зареєструватись</span>
                            <span id="submitSpinner" class="position-absolute top-50 start-50 translate-middle d-none">
                                <span class="spinner-border spinner-border-sm force-spin" role="status" aria-hidden="true"></span>
                            </span>
                        </button>
                        
                        <div class="text-center text-muted small mt-4">
                            Вже є акаунт? <a asp-action="Login" class="text-decoration-none fw-bold">Увійти</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
