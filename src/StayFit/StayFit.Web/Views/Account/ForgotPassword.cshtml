@model StayFit.Web.Controllers.AccountController.ForgotPasswordRequest

@{
    ViewData["Title"] = "Відновлення пароля";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-7 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-2">@ViewData["Title"]</h1>
                <p class="text-muted mb-4">
                    Введіть ваш email — ми надішлемо посилання для скидання пароля.
                </p>

                <form asp-action="ForgotPassword" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-success w-100">Надіслати посилання</button>
                </form>

                <hr class="my-3" />
                <p class="text-center text-muted small mb-0">
                    <a asp-action="Login">← Повернутись до входу</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
