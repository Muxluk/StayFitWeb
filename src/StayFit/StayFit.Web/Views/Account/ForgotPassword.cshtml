@model StayFit.Web.Controllers.AccountController.ForgotPasswordRequest

@{
    ViewData["Title"] = "Відновлення пароля";
}

<div class="container d-flex justify-content-center align-items-center min-vh-100" style="padding-top: 2rem;">
    <div class="card shadow-lg border-0 rounded-4 w-100" style="max-width: 450px;">
        <div class="card-body p-5">
            <!-- Індикатор кроків -->
            <div class="d-flex justify-content-center mb-4">
                <div class="d-flex align-items-center">
                    <div class="step-circle bg-primary text-white d-flex justify-content-center align-items-center rounded-circle" style="width: 32px; height: 32px; transition: all 0.4s ease;">1</div>
                    <div class="step-line bg-light" style="height: 2px; width: 40px; transition: all 0.4s ease;" id="stepLine1"></div>
                    <div class="step-circle bg-light text-muted d-flex justify-content-center align-items-center rounded-circle" style="width: 32px; height: 32px; transition: all 0.4s ease;" id="stepIndicator2">2</div>
                    <div class="step-line bg-light" style="height: 2px; width: 40px; transition: all 0.4s ease;" id="stepLine2"></div>
                    <div class="step-circle bg-light text-muted d-flex justify-content-center align-items-center rounded-circle" style="width: 32px; height: 32px; transition: all 0.4s ease;">3</div>
                </div>
            </div>

            <div id="step1">
                <div class="text-center mb-4">
                    <h3 class="fw-bold text-dark mb-2">Забули пароль?</h3>
                    <p class="text-muted small">Введіть електронну пошту, і ми надішлемо вам посилання для скидання пароля.</p>
                </div>

                <div id="alertMsg" class="alert alert-danger d-none small"></div>

                <form id="forgotForm" asp-action="ForgotPassword" method="post" novalidate>
                    <div class="form-floating mb-4">
                        <input asp-for="Email" class="form-control rounded-3" autocomplete="email" id="emailInput" placeholder="name@example.com" />
                        <label asp-for="Email">Електронна пошта</label>
                        <span asp-validation-for="Email" class="text-danger small" id="emailError"></span>
                    </div>

                    <button type="submit" id="submitBtn" class="btn btn-primary w-100 py-3 rounded-3 fw-bold mb-3 position-relative">
                        <span id="submitText">Надіслати посилання</span>
                        <span id="submitSpinner" class="position-absolute top-50 start-50 translate-middle d-none">
                            <span class="spinner-border spinner-border-sm force-spin" role="status" aria-hidden="true"></span>
                        </span>
                    </button>
                    
                    <div class="text-center mt-3">
                        <a asp-action="Login" class="text-decoration-none text-muted small"><i class="bi bi-arrow-left me-1"></i> Повернутись до входу</a>
                    </div>
                </form>
            </div>

            <!-- Step 2: Confirmation UI -->
            <div id="step2" class="d-none text-center">
                <div class="mb-4">
                    <div class="bg-success-subtle text-success rounded-circle d-inline-flex justify-content-center align-items-center mb-3" style="width: 64px; height: 64px;">
                        <i class="bi bi-envelope-check fs-1"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-2">Перевірте пошту</h3>
                    <p class="text-muted small">Ми надіслали посилання для відновлення на <strong id="sentEmail"></strong>. Будь ласка, перейдіть за посиланням, щоб встановити новий пароль.</p>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <p class="text-muted small mb-2">Не отримали лист?</p>
                    <button id="resendBtn" class="btn btn-outline-primary btn-sm rounded-pill px-4" disabled>
                        Надіслати знову (<span id="timer">60</span>с)
                    </button>
                </div>
                
                <div class="text-center mt-4">
                    <a asp-action="Login" class="text-decoration-none text-muted small">Повернутись до входу</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth-helper.js" asp-append-version="true"></script>
}
