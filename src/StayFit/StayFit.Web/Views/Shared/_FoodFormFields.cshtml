@model StayFit.Domain.Entities.Food
@using StayFit.Domain.Enums

<div class="row g-3">
    @* Назва та бренд *@
    <div class="col-md-6">
        <div class="form-floating mb-3">
            <input asp-for="Name" class="form-control" placeholder="Назва продукту" required />
            <label asp-for="Name">Назва продукту</label>
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-floating mb-3">
            <input asp-for="Brand" class="form-control" placeholder="Бренд (необов'язково)" />
            <label asp-for="Brand">Бренд</label>
        </div>
    </div>

    @* Категорія (Візуальний вибір) *@
    <div class="col-12 mb-3">
        <label class="form-label d-block fw-bold mb-2">Категорія продукту</label>
        <input type="hidden" asp-for="Category" id="categoryInput" />
        
        <div class="sf-category-grid">
            @foreach (FoodCategory cat in Enum.GetValues(typeof(FoodCategory)))
            {
                var icon = cat switch {
                    FoodCategory.General => "bi-basket",
                    FoodCategory.Vegetables => "bi-leaf",
                    FoodCategory.Fruits => "bi-apple",
                    FoodCategory.Meat => "bi-egg",
                    FoodCategory.Dairy => "bi-cup-hot",
                    FoodCategory.Sweets => "bi-cookie",
                    FoodCategory.Drinks => "bi-droplet",
                    _ => "bi-box"
                };
                
                <div class="sf-cat-btn @(Model.Category == cat ? "active" : "")" 
                     data-value="@cat" title="@cat">
                    <i class="bi @icon sf-cat-icon"></i>
                    <span class="sf-cat-label">@cat</span>
                </div>
            }
        </div>
    </div>

    @* КБЖВ на 100г *@
    <div class="col-12">
        <div class="card bg-light-subtle border-0 shadow-sm rounded-3">
            <div class="card-body p-3">
                <h6 class="fw-bold mb-3"><i class="bi bi-info-circle me-1"></i> Поживна цінність на 100г</h6>
                <div class="row g-2">
                    <div class="col-6 col-md-3">
                        <div class="form-floating">
                            <input asp-for="CaloriesPer100g" id="inp_cal" class="form-control" placeholder="0" type="number" step="0.1" required />
                            <label asp-for="CaloriesPer100g">Калорії</label>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="form-floating">
                            <input asp-for="ProteinPer100g" id="inp_prot" class="form-control" placeholder="0" type="number" step="0.1" required />
                            <label asp-for="ProteinPer100g">Білки</label>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="form-floating">
                            <input asp-for="FatPer100g" id="inp_fat" class="form-control" placeholder="0" type="number" step="0.1" required />
                            <label asp-for="FatPer100g">Жири</label>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="form-floating">
                            <input asp-for="CarbsPer100g" id="inp_carb" class="form-control" placeholder="0" type="number" step="0.1" required />
                            <label asp-for="CarbsPer100g">Вуглеводи</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Попередній перегляд порції (якщо додаємо зі щоденника) *@
    @if (ViewBag.ShowPortionPreview == true)
    {
        <div class="col-12 mt-4">
            <div class="card border-primary border-opacity-25 rounded-3">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0">Розрахунок порції</h6>
                        <div class="input-group input-group-sm" style="width: 140px;">
                            <input type="number" id="previewGrams" class="form-control" value="100" />
                            <span class="input-group-text">грам</span>
                        </div>
                    </div>
                    <div class="row g-2 text-center">
                        <div class="col-3">
                            <div class="small text-muted mb-1">Калорії</div>
                            <div class="fw-bold text-primary" id="prev_cal">@Model.CaloriesPer100g.ToString("F0")</div>
                        </div>
                        <div class="col-3">
                            <div class="small text-muted mb-1">Білки</div>
                            <div class="fw-bold text-info" id="prev_prot">@Model.ProteinPer100g.ToString("F1")</div>
                        </div>
                        <div class="col-3">
                            <div class="small text-muted mb-1">Жири</div>
                            <div class="fw-bold text-warning" id="prev_fat">@Model.FatPer100g.ToString("F1")</div>
                        </div>
                        <div class="col-3">
                            <div class="small text-muted mb-1">Вуглеводи</div>
                            <div class="fw-bold text-success" id="prev_carb">@Model.CarbsPer100g.ToString("F1")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @* Зображення *@
    <div class="col-12">
        <div class="form-floating mb-3">
            <input asp-for="ImageUrl" class="form-control" placeholder="URL зображення" />
            <label asp-for="ImageUrl">URL зображення (необов'язково)</label>
        </div>
    </div>
</div>
