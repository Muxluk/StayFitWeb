@* _Card.cshtml
   Parameters (passed via ViewData / Html.Partial / PartialAsync):
     Icon       – emoji/icon string, e.g. "🔥"
     Title      – card heading
     Value      – main numeric value string
     Unit       – unit label, e.g. "ккал"
     SubLabel   – secondary line (optional)
     CssClass   – additional CSS class for the card wrapper (optional)
*@
@{
    var icon      = ViewData["Icon"]?.ToString() ?? "";
    var title     = ViewData["Title"]?.ToString() ?? "";
    var value     = ViewData["Value"]?.ToString() ?? "–";
    var unit      = ViewData["Unit"]?.ToString() ?? "";
    var subLabel  = ViewData["SubLabel"]?.ToString() ?? "";
    var cssClass  = ViewData["CssClass"]?.ToString() ?? "";
}

<div class="card sf-card @cssClass">
    <div class="card-body d-flex flex-column gap-1">
        <div class="d-flex align-items-center gap-2">
            @if (!string.IsNullOrEmpty(icon))
            {
                <span class="sf-card-icon">@icon</span>
            }
            <span class="sf-card-label">@title</span>
        </div>
        <div class="d-flex align-items-baseline gap-1">
            <span class="sf-card-value">@value</span>
            @if (!string.IsNullOrEmpty(unit))
            {
                <span class="text-muted small">@unit</span>
            }
        </div>
        @if (!string.IsNullOrEmpty(subLabel))
        {
            <small class="text-muted">@subLabel</small>
        }
        @RenderSection("CardContent", required: false)
    </div>
</div>
