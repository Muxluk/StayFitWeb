@using Microsoft.Extensions.Options
@using StayFit.Application.Options
@inject IWebHostEnvironment HostEnvironment
@inject IOptions<DashboardSettings> DashboardOptions
@{
    var environmentName = HostEnvironment.EnvironmentName;
    var environmentBadgeClass = environmentName switch
    {
        "Development" => "bg-success",
        "Staging" => "bg-warning text-dark",
        "Production" => "bg-danger",
        _ => "bg-secondary"
    };
}

<!DOCTYPE html>
<html lang="uk" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StayFit.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/bundle.min.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm bg-body-tertiary border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Dashboard" asp-action="Index">StayFit.Web</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between" id="navbarSupportedContent">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Dashboard" asp-action="Index">Головна</a>
                        </li>
                        <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="ProductSearch" asp-action="Index">Пошук продуктів</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Food" asp-action="Index">Мої продукти</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Diary" asp-action="Index">Мій щоденник</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Hydration" asp-action="Index">
                                <i class="bi bi-droplet-fill text-info"></i> Моя вода
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Statistics" asp-action="Daily">Статистика</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="NutritionGoal" asp-action="Index">Мої цілі</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Export" asp-action="Index">Експорт</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Index">Адміністрування</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                        {
                            <li class="nav-item d-flex align-items-center me-2">
                                <a asp-controller="Debug" asp-action="Config" class="text-decoration-none" title="Відкрити debug config">
                                    <span class="badge @environmentBadgeClass">ENV: @environmentName</span>
                                </a>
                            </li>

                        }
                        <li class="nav-item d-flex align-items-center me-1">
                            <button id="sf-theme-toggle" class="btn btn-link nav-link px-2" title="Перемкнути тему" onclick="sfToggleTheme()" type="button">
                                <i class="bi bi-moon-fill" id="sf-theme-icon"></i>
                            </button>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item d-flex align-items-center me-2">
                                <div class="dropdown">
                                    <button class="btn btn-link nav-link position-relative" type="button" id="notificationBell" data-bs-toggle="dropdown" aria-expanded="false" title="Сповіщення">
                                        🔔
                                        <span id="notificationBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none">
                                            <span id="notificationCount">0</span>
                                        </span>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="notificationBell" id="notificationDropdown">
                                        <li class="dropdown-header">Сповіщення</li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li id="notificationList" class="p-3 notification-dropdown-list">
                                            <div class="text-center text-muted">Немає сповіщень</div>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li class="text-center p-2 d-flex gap-2">
                                            <button type="button" class="btn btn-sm btn-outline-primary flex-grow-1 d-none" id="markAllReadBtn">
                                                ✓ Прочитати все
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger flex-grow-1 d-none" id="clearAllBtn">
                                                🗑 Очистити все
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Profile" asp-action="Edit" title="Мій профіль">👤 @User.Identity.Name</a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-link nav-link">Вийти</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Вхід</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Register">Реєстрація</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <button type="button"
                class="btn btn-primary support-fab shadow"
                data-bs-toggle="modal"
                data-bs-target="#supportTicketModal"
                aria-label="Звернутися до технічної підтримки"
                title="Звернутися до технічної підтримки">
            ?
        </button>

        <div class="modal fade" id="supportTicketModal" tabindex="-1" aria-labelledby="supportTicketModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="supportTicketModalLabel">Звернення до технічної підтримки</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрити"></button>
                    </div>
                    <form asp-controller="Support" asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div class="modal-body">
                            <div class="mb-3">
                                <label for="supportSubject" class="form-label">Тема</label>
                                <input type="text" class="form-control" id="supportSubject" name="Subject" maxlength="200" required />
                            </div>
                            <div class="mb-3">
                                <label for="supportMessage" class="form-label">Повідомлення</label>
                                <textarea class="form-control" id="supportMessage" name="Message" rows="5" maxlength="2000" required></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <a href="@Url.Action("Index", "Support")" class="btn btn-info">
                                📋 Мої запити
                            </a>
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Скасувати</button>
                            <button type="submit" class="btn btn-primary">Надіслати</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <footer class="border-top footer text-muted">
        <div class="container">
            <div class="row py-3 align-items-center">
                <div class="col-md-6">&copy; 2026 - StayFit</div>
                <div class="col-md-6 text-md-end">
                    <ul class="list-inline mb-0">
                        <li class="list-inline-item"><a class="text-decoration-none text-muted" asp-controller="Home" asp-action="Index">Головна</a></li>
                        <li class="list-inline-item"><a class="text-decoration-none text-muted" asp-controller="Home" asp-action="About">Про нас</a></li>
                        <li class="list-inline-item"><a class="text-decoration-none text-muted" asp-controller="Support" asp-action="Index">Контакти</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </footer>

    @await Html.PartialAsync("_ModalConfirm", new ModalConfirmViewModel())
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="~/js/bundle.min.js" asp-append-version="true"></script>
    <script>
    function sfToggleTheme() {
        var html = document.documentElement;
        var isDark = html.getAttribute('data-bs-theme') === 'dark';
        var next = isDark ? 'light' : 'dark';
        html.setAttribute('data-bs-theme', next);
        localStorage.setItem('sf-theme', next);
        var icon = document.getElementById('sf-theme-icon');
        if (icon) {
            icon.className = next === 'dark' ? 'bi bi-sun-fill' : 'bi bi-moon-fill';
        }
    }
    // Sync icon on load
    (function(){
        var t = document.documentElement.getAttribute('data-bs-theme');
        var icon = document.getElementById('sf-theme-icon');
        if (icon) icon.className = t === 'dark' ? 'bi bi-sun-fill' : 'bi bi-moon-fill';
    })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
