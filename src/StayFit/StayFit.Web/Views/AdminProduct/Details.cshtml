@using StayFit.Domain.Entities
@model Food

@{
    ViewData["Title"] = $"Продукт: {Model.Name}";
}

<div class="container mt-4" style="max-width: 700px;">
    <div class="d-flex align-items-center gap-2 mb-4">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Назад
        </a>
        <h4 class="mb-0"><i class="bi bi-box-seam text-warning me-2"></i>@Model.Name</h4>
    </div>

    <div class="card shadow border-0">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted">Назва</dt>
                <dd class="col-sm-8 fw-semibold">@Model.Name</dd>

                <dt class="col-sm-4 text-muted">Бренд</dt>
                <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Brand) ? "—" : Model.Brand)</dd>

                <dt class="col-sm-4 text-muted">Категорія</dt>
                <dd class="col-sm-8">@Model.Category</dd>

                <dt class="col-sm-4 text-muted">Штрих-код</dt>
                <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Barcode) ? "—" : Model.Barcode)</dd>

                <dt class="col-sm-4 text-muted">Автор (email)</dt>
                <dd class="col-sm-8">@(Model.CreatedByEmail ?? "—")</dd>

                <dt class="col-sm-4 text-muted">Надіслано</dt>
                <dd class="col-sm-8">
                    @(Model.SubmittedAt.HasValue
                        ? Model.SubmittedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        : "—")
                </dd>
            </dl>

            <hr />

            <h6 class="text-muted text-uppercase small mb-3">Харчова цінність на 100 г</h6>
            <div class="row g-3 text-center">
                <div class="col-6 col-md-3">
                    <div class="card bg-primary bg-opacity-10 border-0 p-3">
                        <div class="fs-4 fw-bold text-primary">@Model.CaloriesPer100g</div>
                        <div class="small text-muted">ккал</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card bg-success bg-opacity-10 border-0 p-3">
                        <div class="fs-4 fw-bold text-success">@Model.ProteinPer100g</div>
                        <div class="small text-muted">Білки (г)</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card bg-warning bg-opacity-10 border-0 p-3">
                        <div class="fs-4 fw-bold text-warning">@Model.FatPer100g</div>
                        <div class="small text-muted">Жири (г)</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card bg-info bg-opacity-10 border-0 p-3">
                        <div class="fs-4 fw-bold text-info">@Model.CarbsPer100g</div>
                        <div class="small text-muted">Вуглеводи (г)</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-footer d-flex justify-content-end gap-2">
            <form asp-action="Reject" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger"
                        data-confirm-title="Відхилити продукт"
                        data-confirm-message='Видалити продукт "@Model.Name"? Цю дію не можна скасувати.'
                        data-confirm-button-text="Видалити"
                        data-confirm-button-class="btn-danger">
                    <i class="bi bi-x-lg me-1"></i>Відхилити
                </button>
            </form>
            <form asp-action="Approve" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success"
                        data-confirm-title="Підтвердити продукт"
                        data-confirm-message='Підтвердити продукт "@Model.Name"?'
                        data-confirm-button-text="Підтвердити"
                        data-confirm-button-class="btn-success">
                    <i class="bi bi-check-lg me-1"></i>Схвалити
                </button>
            </form>
        </div>
    </div>
</div>
