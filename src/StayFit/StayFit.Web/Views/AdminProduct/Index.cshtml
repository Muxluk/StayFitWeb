@using StayFit.Domain.Entities
@model IEnumerable<Food>

@{
    ViewData["Title"] = "Модерація продуктів";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-end mb-3 pb-2 border-bottom border-secondary">
        <div>
            <h2 class="text-black mb-1">
                <i class="bi bi-shield-lock text-warning me-2"></i>Модерація продуктів
            </h2>
            <p class="text-black-50 mb-0">Перегляд запропонованих продуктів та перевірка КБЖВ</p>
        </div>
        <div class="text-end">
            <span class="badge rounded-pill bg-danger px-3">
                Очікують: @Model.Count()
            </span>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card bg-dark border-secondary text-center p-5 shadow">
            <div class="card-body">
                <i class="bi bi-check2-circle display-1 text-success"></i>
                <h4 class="mt-3 text-white">Всі продукти перевірено</h4>
                <p class="text-white-50">Нових запитів на модерацію немає.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card bg-dark border-secondary shadow">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0 table-row-hover-dark">
                    <thead class="table-light text-dark">
                        <tr>
                            <th class="ps-3">Назва / Бренд</th>
                            <th class="text-center">Калорії</th> <th class="text-center">Б / Ж / В</th>
                            <th class="text-center">Автор (Email)</th>
                            <th class="text-end pe-3">Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-bold text-white">@item.Name</div>
                                    <div class="small text-light text-white-50-muted opacity-75-muted">
                                        <i class="bi bi-tag small me-1"></i>@(string.IsNullOrEmpty(item.Brand) ? "—" : item.Brand)
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-primary px-2 py-1">@item.CaloriesPer100g ккал</span>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2 small fw-bold">
                                        <span class="text-success">Б: @item.ProteinPer100g</span>
                                        <span class="text-warning">Ж: @item.FatPer100g</span>
                                        <span class="text-info">В: @item.CarbsPer100g</span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="text-white small">@item.CreatedByEmail</span>
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group">
                                        <form asp-action="Approve" asp-route-id="@item.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success fw-bold"
                                                    data-confirm-title="Підтвердити продукт"
                                                    data-confirm-message="Підтвердити?"
                                                    data-confirm-button-text="Підтвердити"
                                                    data-confirm-button-class="btn-success">
                                                ОК
                                            </button>
                                        </form>
                                        <form asp-action="Reject" asp-route-id="@item.Id" method="post" class="d-inline ms-1">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger fw-bold"
                                                    data-confirm-title="Видалити продукт"
                                                    data-confirm-message="Видалити?"
                                                    data-confirm-button-text="Видалити"
                                                    data-confirm-button-class="btn-danger">
                                                <i class="bi bi-trash"></i> Видалити </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

