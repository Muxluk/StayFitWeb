@using StayFit.Domain.Entities
@model IEnumerable<Food>

@{
    ViewData["Title"] = "Модерація продуктів";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-end mb-3 pb-2 border-bottom border-secondary">
        <div>
            <h2 class="mb-1">
                <i class="bi bi-shield-lock text-warning me-2"></i>Модерація продуктів
            </h2>
            <p class="text-muted mb-0">Перегляд запропонованих продуктів та перевірка КБЖУ</p>
        </div>
        <div class="text-end">
            <span class="badge rounded-pill bg-danger px-3 fs-6">
                Очікують: @totalCount
            </span>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Warning"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 shadow text-center p-5">
            <div class="card-body">
                <i class="bi bi-check2-circle display-1 text-success"></i>
                <h4 class="mt-3">Всі продукти перевірено</h4>
                <p class="text-muted">Нових запитів на модерацію немає.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Назва / Бренд</th>
                            <th class="text-center">Калорії</th>
                            <th class="text-center">Б / Ж / В (г)</th>
                            <th class="text-center">Автор</th>
                            <th class="text-center">Надіслано</th>
                            <th class="text-end pe-3">Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-semibold">@item.Name</div>
                                    <div class="small text-muted">
                                        <i class="bi bi-tag small me-1"></i>@(string.IsNullOrEmpty(item.Brand) ? "—" : item.Brand)
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-primary">@item.CaloriesPer100g ккал</span>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2 small fw-semibold">
                                        <span class="text-success">Б: @item.ProteinPer100g</span>
                                        <span class="text-warning">Ж: @item.FatPer100g</span>
                                        <span class="text-info">В: @item.CarbsPer100g</span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="small text-muted">@(item.CreatedByEmail ?? "—")</span>
                                </td>
                                <td class="text-center">
                                    <span class="small text-muted">
                                        @(item.SubmittedAt.HasValue
                                            ? item.SubmittedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                            : "—")
                                    </span>
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group gap-1">
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <form asp-action="Approve" asp-route-id="@item.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success"
                                                    data-confirm-title="Підтвердити продукт"
                                                    data-confirm-message='Підтвердити продукт "@item.Name"?'
                                                    data-confirm-button-text="Підтвердити"
                                                    data-confirm-button-class="btn-success">
                                                <i class="bi bi-check-lg"></i> Схвалити
                                            </button>
                                        </form>
                                        <form asp-action="Reject" asp-route-id="@item.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger"
                                                    data-confirm-title="Відхилити продукт"
                                                    data-confirm-message='Видалити продукт "@item.Name"? Цю дію не можна скасувати.'
                                                    data-confirm-button-text="Видалити"
                                                    data-confirm-button-class="btn-danger">
                                                <i class="bi bi-x-lg"></i> Відхилити
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (totalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(p == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>


