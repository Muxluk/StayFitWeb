@{
    ViewData["Title"] = "Водний баланс";
}

<div class="container mt-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h2>Водний баланс</h2>
        <button class="btn btn-outline-secondary btn-sm" id="waterResetBtn" title="Скинути лічильник">
            ↺ Скинути
        </button>
    </div>

    @* ── Основна картка з прогресом ── *@
    <div class="row mb-4">
        <div class="col-12 col-lg-8">
            <div class="card sf-card">
                <div class="card-body">
                    <div class="d-flex align-items-baseline justify-content-between mb-3">
                        <div>
                            <h5 class="card-title mb-1">Сьогоднішня норма</h5>
                            <p class="text-muted small mb-0">Рекомендується <strong>8 склянок</strong> води на день</p>
                        </div>
                        <div class="text-end">
                            <div class="sf-card-value" id="waterIntake">0</div>
                            <small class="text-muted">/ <span id="waterGoal">8</span> склянок</small>
                        </div>
                    </div>
                    
                    @* ── Прогрес бар через partial ── *@
                    <div id="progressContainer">
                        @await Html.PartialAsync("_ProgressBar", null, new ViewDataDictionary(ViewData)
                        {
                            ["Actual"] = 0.0,
                            ["Target"] = 8.0,
                            ["Color"] = "info",
                            ["ShowLabel"] = true
                        })
                    </div>

                    @* ── Рівень в'язкості (мікрокопія) ── *@
                    <div id="waterDrops" class="sf-water-drops mt-3"></div>

                    <div id="waterWarning" class="alert alert-warning mt-2 py-1 px-2 small" style="display:none;">
                        ⚠️ Ви перевищили рекомендовану норму водовживання!
                    </div>

                    <small class="text-muted d-block mt-2">
                        Натисніть на крапельку щоб відзначити склянку або використайте кнопки нижче
                    </small>
                </div>
            </div>
        </div>

        @* ── Інформація ── *@
        <div class="col-12 col-lg-4">
            <div class="card sf-card">
                <div class="card-body">
                    <h5 class="card-title mb-3">Поради</h5>
                    <ul class="small list-unstyled">
                        <li class="mb-2">
                            <span class="badge bg-info-subtle text-info">1</span>
                            Пийте воду перед, під час і після тренувань
                        </li>
                        <li class="mb-2">
                            <span class="badge bg-info-subtle text-info">2</span>
                            Розподіліть споживання води протягом дня
                        </li>
                        <li class="mb-2">
                            <span class="badge bg-info-subtle text-info">3</span>
                            Гарячі напої теж рахуються!
                        </li>
                        <li class="mb-2">
                            <span class="badge bg-info-subtle text-info">4</span>
                            Прислухайтеся до сигналів своїх потреб
                        </li>
                        <li class="mb-0">
                            <span class="badge bg-info-subtle text-info">5</span>
                            Норма варіює залежно від активності
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    @* ── Кнопки швидкого додавання ── *@
    <div class="row mb-4">
        <div class="col-12">
            <div class="card sf-card">
                <div class="card-body">
                    <h5 class="card-title mb-3">Швидке додавання</h5>
                    <div class="d-grid gap-2 d-sm-flex flex-wrap">
                        <button class="btn btn-lg btn-outline-info water-btn" data-glasses="1" title="Додати ~200мл">
                            💧 200 мл
                        </button>
                        <button class="btn btn-lg btn-outline-info water-btn" data-glasses="1" title="Додати ~300мл">
                            💧 300 мл
                        </button>
                        <button class="btn btn-lg btn-outline-info water-btn" data-glasses="2" title="Додати ~500мл">
                            💧 500 мл
                        </button>
                        <button class="btn btn-lg btn-info water-btn" data-glasses="4" title="Додати половину норми">
                            💧 Половина (4)
                        </button>
                        <button class="btn btn-lg btn-success water-btn" data-glasses="8" title="Заповнити всю норму">
                            💧 Вся норма (8)
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ── Історія сьогодні (розширена версія з часами) ── *@
    <div class="card sf-card">
        <div class="card-body">
            <h5 class="card-title mb-3">Історія водовживання</h5>
            <div id="waterHistory" class="sf-scrollable list-group list-group-flush">
                <div class="list-group-item text-muted text-center py-4">
                    Поки немає записів. Почніть додавати воду!
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/hydration-manager.js" asp-append-version="true"></script>
}
