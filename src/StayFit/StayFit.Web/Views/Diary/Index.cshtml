@model IEnumerable<StayFit.Domain.Entities.FoodLog>

@{
    var date = (DateTime)ViewBag.SelectedDate;
    var logs = Model?.ToList() ?? new List<StayFit.Domain.Entities.FoodLog>();
    
    // Групування по часу прийому їжі (оскільки FoodLog не має поля MealType)
    var mealTypes = new Dictionary<string, List<StayFit.Domain.Entities.FoodLog>>
    {
        { "Сніданок", logs.Where(l => l.LoggedAt.Hour >= 5 && l.LoggedAt.Hour < 11).ToList() },
        { "Обід", logs.Where(l => l.LoggedAt.Hour >= 11 && l.LoggedAt.Hour < 16).ToList() },
        { "Вечеря", logs.Where(l => l.LoggedAt.Hour >= 16 && l.LoggedAt.Hour < 22).ToList() },
        { "Перекус", logs.Where(l => l.LoggedAt.Hour >= 22 || l.LoggedAt.Hour < 5).ToList() }
    };
    
    // Розрахунок Калорійності та КБЖВ
    decimal totalCalories = 0m;
    decimal totalProteins = 0m;
    decimal totalFats = 0m;
    decimal totalCarbs = 0m;
    
    foreach (var log in logs)
    {
        var quantity = (decimal)log.Quantity;
        var food = log.Food;
        totalCalories += (decimal)(food?.CaloriesPer100g ?? 0f) * quantity / 100m;
        totalProteins += (decimal)(food?.ProteinPer100g ?? 0f) * quantity / 100m;
        totalFats += (decimal)(food?.FatPer100g ?? 0f) * quantity / 100m;
        totalCarbs += (decimal)(food?.CarbsPer100g ?? 0f) * quantity / 100m;
    }
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Щоденник харчування</h2>
            <p class="text-muted mb-0">@date.ToLongDateString()</p>
        </div>
        <form method="get" asp-action="Index" class="d-flex gap-2" data-auto-submit-change>
            <input type="date" name="date" value="@date.ToString("yyyy-MM-dd")" class="form-control diary-date-picker" />
        </form>
    </div>

    @if (logs.Any())
    {
        <!-- Загальний підсумок за день -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-sm-3">
                <div class="card stats-card">
                    <div class="card-body text-center">
                        <small class="text-muted d-block mb-1">Калорії</small>
                        <h3 class="mb-0 text-primary">@Math.Round(totalCalories, 0)</h3>
                        <small class="text-muted">ккал</small>
                    </div>
                </div>
            </div>
            <div class="col-6 col-sm-3">
                <div class="card stats-card">
                    <div class="card-body text-center">
                        <small class="text-muted d-block mb-1">Білки</small>
                        <h3 class="mb-0 text-success">@Math.Round(totalProteins, 1)</h3>
                        <small class="text-muted">г</small>
                    </div>
                </div>
            </div>
            <div class="col-6 col-sm-3">
                <div class="card stats-card">
                    <div class="card-body text-center">
                        <small class="text-muted d-block mb-1">Жири</small>
                        <h3 class="mb-0 text-warning">@Math.Round(totalFats, 1)</h3>
                        <small class="text-muted">г</small>
                    </div>
                </div>
            </div>
            <div class="col-6 col-sm-3">
                <div class="card stats-card">
                    <div class="card-body text-center">
                        <small class="text-muted d-block mb-1">Вуглеводи</small>
                        <h3 class="mb-0 text-info">@Math.Round(totalCarbs, 1)</h3>
                        <small class="text-muted">г</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Прийоми їжі -->
        @foreach (var mealType in mealTypes)
        {
            if (mealType.Value.Any())
            {
                var mealCalories = mealType.Value.Sum(l => (decimal)(l.Food?.CaloriesPer100g ?? 0f) * (decimal)l.Quantity / 100m);
                var mealProteins = mealType.Value.Sum(l => (decimal)(l.Food?.ProteinPer100g ?? 0f) * (decimal)l.Quantity / 100m);
                var mealFats = mealType.Value.Sum(l => (decimal)(l.Food?.FatPer100g ?? 0f) * (decimal)l.Quantity / 100m);
                var mealCarbs = mealType.Value.Sum(l => (decimal)(l.Food?.CarbsPer100g ?? 0f) * (decimal)l.Quantity / 100m);

                <div class="card meal-section mb-3 shadow-sm">
                    <div class="card-header meal-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">@mealType.Key</h5>
                            <span class="badge bg-primary">@Math.Round(mealCalories, 0) ккал</span>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr class="small">
                                        <th class="ps-3">Продукт</th>
                                        <th class="text-center">Кількість</th>
                                        <th class="text-center">Ккал</th>
                                        <th class="text-center">Б</th>
                                        <th class="text-center">Ж</th>
                                        <th class="text-center">В</th>
                                        <th class="text-end pe-3">Дії</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in mealType.Value)
                                    {
                                        var calories = (decimal)(log.Food?.CaloriesPer100g ?? 0f) * (decimal)log.Quantity / 100m;
                                        var proteins = (decimal)(log.Food?.ProteinPer100g ?? 0f) * (decimal)log.Quantity / 100m;
                                        var fats = (decimal)(log.Food?.FatPer100g ?? 0f) * (decimal)log.Quantity / 100m;
                                        var carbs = (decimal)(log.Food?.CarbsPer100g ?? 0f) * (decimal)log.Quantity / 100m;

                                        <tr>
                                            <td class="ps-3">
                                                <div>
                                                    <strong>@log.Food?.Name</strong>
                                                </div>
                                            </td>
                                            <td class="text-center small">@log.Quantity г</td>
                                            <td class="text-center small">@Math.Round(calories, 0)</td>
                                            <td class="text-center small">@Math.Round(proteins, 1)</td>
                                            <td class="text-center small">@Math.Round(fats, 1)</td>
                                            <td class="text-center small">@Math.Round(carbs, 1)</td>
                                            <td class="text-end pe-3">
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <form asp-action="DeleteEntry" asp-route-id="@log.Id" method="post" class="d-inline">
                                                        <button type="submit" class="btn btn-outline-danger" title="Видалити"><i class="bi bi-trash"></i></button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                        <tr class="note-row">
                                            <td colspan="7" class="ps-3 pe-3 py-3 bg-light">
                                                <textarea id="note_@log.Id" class="form-control note-textarea" rows="2" maxlength="500" placeholder="Нотатка до цього запису..." data-log-id="@log.Id">@(log.Note ?? "")</textarea>
                                                <div class="d-flex justify-content-between align-items-center mt-2">
                                                    <small class="text-muted"><span id="charcount_@log.Id">@(log.Note?.Length ?? 0)</span>/500 символів</small>
                                                    <button type="button" class="btn btn-sm btn-outline-success save-note-btn" data-log-id="@log.Id">Зберегти</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer bg-light small text-muted">
                        <div class="row text-center g-3">
                            <div class="col-3">
                                <strong>@Math.Round(mealCalories, 0)</strong><br>ккал
                            </div>
                            <div class="col-3">
                                <strong>@Math.Round(mealProteins, 1)</strong><br>г білків
                            </div>
                            <div class="col-3">
                                <strong>@Math.Round(mealFats, 1)</strong><br>г жирів
                            </div>
                            <div class="col-3">
                                <strong>@Math.Round(mealCarbs, 1)</strong><br>г углеводів
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> На цей день немає записів. 
            <a asp-controller="Food" asp-action="Index" class="alert-link">Додати їжу</a>
        </div>
    }

    <div class="d-flex gap-2 mt-4">
        <a asp-controller="Food" asp-action="Index" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Додати продукт
        </a>
        <a asp-controller="Diary" asp-action="DailyDetails" asp-route-date="@date.ToString("yyyy-MM-dd")" class="btn btn-outline-primary">
            <i class="bi bi-bar-chart"></i> Детальна статистика
        </a>
    </div>
</div>

@section Scripts {
}