@model StayFit.Web.Models.DailyDiaryViewModel

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Щоденник: @Model.Date.ToShortDateString()</h2>
        <form asp-action="DailyDetails" method="get" class="d-flex" data-auto-submit-change>
            <input type="date" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" class="form-control" />
        </form>
    </div>

    <div class="row mb-4 text-center">
        <div class="col-md-3">
            <div class="card bg-primary text-white p-3">
                <h5>Калорії</h5>
                <h3>@Model.TotalCalories.ToString("F0")</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white p-3">
                <h5>Білки</h5>
                <h3>@Model.TotalProteins.ToString("F1") г</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark p-3">
                <h5>Жири</h5>
                <h3>@Model.TotalFats.ToString("F1") г</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white p-3">
                <h5>Вуглеводи</h5>
                <h3>@Model.TotalCarbs.ToString("F1") г</h3>
            </div>
        </div>
    </div>

    @foreach (var meal in Model.Meals)
    {
        <div class="card mb-3 shadow-sm">
            <div class="card-header bg-light">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <strong>@meal.Name</strong>
                        <span class="text-muted ms-2">@meal.Time.ToString("HH:mm")</span>
                    </div>
                    <div>
                        <form asp-action="QuickAddMealToday" method="post" class="d-inline">
                            <input type="hidden" name="mealId" value="@meal.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-success me-2" title="Додати знову на сьогодні">
                                <i class="bi bi-plus-circle"></i> Додати знову
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-borderless text-muted small">
                        <tr>
                            <th class="ps-3">Назва</th>
                            <th>Вага</th>
                            <th>Ккал</th>
                            <th>Б</th>
                            <th>Ж</th>
                            <th>В</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in meal.FoodLogs)
                        {
                            <tr>
                                <td class="ps-3">@log.Food?.Name</td>
                                <td>@log.Quantity г</td>
                                <td>@((log.Food?.CaloriesPer100g * log.Quantity / 100)?.ToString("F0"))</td>
                                <td>@((log.Food?.ProteinPer100g * log.Quantity / 100)?.ToString("F1"))</td>
                                <td>@((log.Food?.FatPer100g * log.Quantity / 100)?.ToString("F1"))</td>
                                <td>@((log.Food?.CarbsPer100g * log.Quantity / 100)?.ToString("F1"))</td>
                                <td>
                                    <button class="btn btn-link btn-sm text-danger p-0">Видалити</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <!-- Meal Note Section -->
            <div class="card-footer bg-white">
                <div class="mb-2">
                    <small class="text-muted d-block mb-2">Нотатка:</small>
                    <div class="input-group input-group-sm">
                        <textarea id="note_@meal.Id" class="form-control meal-note" 
                                  placeholder="Добавте нотатку до цього запису..." 
                                  maxlength="500" 
                                  data-meal-id="@meal.Id"
                                  rows="2">@(meal.Note ?? "")</textarea>
                        <button class="btn btn-outline-secondary update-note-btn" 
                                type="button" 
                                data-meal-id="@meal.Id"
                                data-action-url="@Url.Action("UpdateMealNote", "Diary")">
                            Зберегти
                        </button>
                    </div>
                    <small class="text-muted d-block mt-1">
                        <span id="charcount_@meal.Id">@(meal.Note?.Length ?? 0)</span>/500 символів
                    </small>
                </div>
            </div>
        </div>
    }

    <div class="mt-4">
        <a asp-controller="Food" asp-action="Index" class="btn btn-outline-primary">+ Додати продукт</a>
    </div>
</div>

@section Scripts {
}
