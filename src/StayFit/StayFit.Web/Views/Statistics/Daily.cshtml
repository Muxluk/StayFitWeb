@model IEnumerable<StayFit.Domain.Entities.FoodLog>
@using System.Globalization

@{
    ViewData["Title"] = "Статистика за день";

    var selectedDate = ViewBag.SelectedDate is DateTime dateFromController
        ? dateFromController.Date
        : DateTime.Today;

    var rows = Model?.ToList() ?? new List<StayFit.Domain.Entities.FoodLog>();

    decimal totalCalories = 0m;
    decimal totalProtein = 0m;
    decimal totalFat = 0m;
    decimal totalCarbs = 0m;

    foreach (var log in rows)
    {
        var grams = (decimal)log.AmountGrams;
        var food = log.Food;

        totalCalories += (decimal)(food?.CaloriesPer100g ?? 0f) * grams / 100m;
        totalProtein += (decimal)(food?.ProteinPer100g ?? 0f) * grams / 100m;
        totalFat += (decimal)(food?.FatPer100g ?? 0f) * grams / 100m;
        totalCarbs += (decimal)(food?.CarbsPer100g ?? 0f) * grams / 100m;
    }

    var chartItems = new[]
    {
        new { Label = "Калорії", Value = totalCalories, Unit = "ккал", Css = "bg-primary" },
        new { Label = "Білки", Value = totalProtein, Unit = "г", Css = "bg-success" },
        new { Label = "Жири", Value = totalFat, Unit = "г", Css = "bg-warning" },
        new { Label = "Вуглеводи", Value = totalCarbs, Unit = "г", Css = "bg-info" },
    };

    var maxChartValue = chartItems.Max(i => i.Value);
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="mb-0"><i class="bi bi-calendar-day"></i> Статистика за день</h2>
    <a asp-controller="Diary" asp-action="Index" asp-route-date="@selectedDate.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> До щоденника
    </a>
</div>

<partial name="_StatisticsNav" />

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="get" asp-action="Daily" class="card card-body mb-4 bg-light-subtle">
    <div class="row g-3 align-items-end">
        <div class="col-sm-6 col-md-4 col-lg-3">
            <label for="date" class="form-label fw-semibold mb-2"><i class="bi bi-calendar"></i> Оберіть дату</label>
            <input id="date" type="date" name="date" value="@selectedDate.ToString("yyyy-MM-dd")" class="form-control diary-date-picker" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search"></i> Показати
            </button>
        </div>
    </div>
</form>

<div class="row g-3 mb-4">
    <div class="col-12 col-lg-6">
        <div class="card h-100 shadow-sm">
            <div class="card-header fw-semibold bg-light-subtle"><i class="bi bi-file-earmark-bar-graph"></i> Підсумок за день (@selectedDate.ToString("dd.MM.yyyy"))</div>
            <div class="card-body">
                <div class="row text-center g-3">
                    <div class="col-6 col-sm-3">
                        <div class="stats-card">
                            <small class="text-muted d-block mb-1">Калорії</small>
                            <h5 class="mb-0 text-primary">@Math.Round(totalCalories, 0)</h5>
                            <small class="text-muted">ккал</small>
                        </div>
                    </div>
                    <div class="col-6 col-sm-3">
                        <div class="stats-card">
                            <small class="text-muted d-block mb-1">Білки</small>
                            <h5 class="mb-0 text-success">@Math.Round(totalProtein, 1)</h5>
                            <small class="text-muted">г</small>
                        </div>
                    </div>
                    <div class="col-6 col-sm-3">
                        <div class="stats-card">
                            <small class="text-muted d-block mb-1">Жири</small>
                            <h5 class="mb-0 text-warning">@Math.Round(totalFat, 1)</h5>
                            <small class="text-muted">г</small>
                        </div>
                    </div>
                    <div class="col-6 col-sm-3">
                        <div class="stats-card">
                            <small class="text-muted d-block mb-1">Вуглеводи</small>
                            <h5 class="mb-0 text-info">@Math.Round(totalCarbs, 1)</h5>
                            <small class="text-muted">г</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card h-100 shadow-sm">
            <div class="card-header fw-semibold bg-light-subtle"><i class="bi bi-graph-up"></i> Графік показників</div>
            <div class="card-body">
                @foreach (var item in chartItems)
                {
                    var width = maxChartValue <= 0 ? 0 : (item.Value / maxChartValue) * 100m;

                    @await Html.PartialAsync("_ProgressBar", new ProgressBarViewModel
                    {
                        Label = item.Label,
                        ValueText = $"{Math.Round(item.Value, 1)} {item.Unit}",
                        Value = width,
                        Max = 100m,
                        ColorClass = item.Css,
                        ProgressClass = "progress-sm",
                        BarClass = "progress-bar-animated-width",
                        ShowPercentText = false,
                        ContainerClass = "mb-3"
                    })
                }
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header fw-semibold bg-light-subtle"><i class="bi bi-list-ul"></i> Деталізація споживання</div>
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Час</th>
                    <th>Продукт</th>
                    <th class="text-center">Кількість (г)</th>
                    <th class="text-center">Ккал</th>
                    <th class="text-center">Б</th>
                    <th class="text-center">Ж</th>
                    <th class="text-center">В</th>
                </tr>
            </thead>
            <tbody>
                @if (rows.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            <i class="bi bi-info-circle"></i> За обрану дату записів не знайдено.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var log in rows.OrderBy(x => x.LoggedAt))
                    {
                        var grams = (decimal)log.AmountGrams;
                        var food = log.Food;
                        var calories = (decimal)(food?.CaloriesPer100g ?? 0f) * grams / 100m;
                        var protein = (decimal)(food?.ProteinPer100g ?? 0f) * grams / 100m;
                        var fat = (decimal)(food?.FatPer100g ?? 0f) * grams / 100m;
                        var carbs = (decimal)(food?.CarbsPer100g ?? 0f) * grams / 100m;

                        <tr>
                            <td><span class="badge bg-light text-dark">@log.LoggedAt.ToLocalTime().ToString("HH:mm")</span></td>
                            <td>@(food?.Name ?? "-")</td>
                            <td class="text-center">@Math.Round(grams, 1)</td>
                            <td class="text-center">@Math.Round(calories, 1)</td>
                            <td class="text-center">@Math.Round(protein, 1)</td>
                            <td class="text-center">@Math.Round(fat, 1)</td>
                            <td class="text-center">@Math.Round(carbs, 1)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
