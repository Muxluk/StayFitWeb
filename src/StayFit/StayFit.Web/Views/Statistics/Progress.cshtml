@model StayFit.Application.DTOs.ProgressAnalysisDto

@{
    ViewData["Title"] = "Аналіз прогресу";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="mb-0">Статистика харчування</h2>
    <a asp-controller="Diary" asp-action="Index" class="btn btn-outline-secondary btn-sm">До щоденника</a>
</div>

<partial name="_StatisticsNav" />

<form method="get" asp-action="Progress" class="card card-body mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-sm-6 col-md-4 col-lg-3">
            <label for="startDate" class="form-label mb-1">Від дати</label>
            <input id="startDate" type="date" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-sm-6 col-md-4 col-lg-3">
            <label for="endDate" class="form-label mb-1">До дати</label>
            <input id="endDate" type="date" name="endDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Показати</button>
        </div>
    </div>
</form>

<div class="row g-3 mb-4">
    <div class="col-12 col-lg-4">
        <div class="card h-100 text-center">
            <div class="card-header fw-semibold">Досягнення цілі (Калорії)</div>
            <div class="card-body d-flex flex-column justify-content-center align-items-center">
                <div class="display-4 fw-bold text-primary mb-2">@Model.DaysCaloriesMet / @Model.TotalDays</div>
                <div class="text-muted">днів в межах норми (±150 ккал)</div>
            </div>
        </div>
    </div>
    
    <div class="col-12 col-lg-8">
        <div class="card h-100">
            <div class="card-header fw-semibold">Фактичне споживання vs Ціль</div>
            <div class="card-body">
                <canvas id="progressChart" class="stats-chart"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header fw-semibold">Деталізація по днях</div>
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Дата</th>
                    <th>Калорії</th>
                    <th>Білки</th>
                    <th>Жири</th>
                    <th>Вуглеводи</th>
                    <th class="text-center">Ціль виконана</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var day in Model.DailyProgress)
                {
                    <tr>
                        <td>@day.Date.ToString("dd.MM.yyyy")</td>
                        <td>@Math.Round(day.TotalCalories, 1)</td>
                        <td>@Math.Round(day.TotalProtein, 1)</td>
                        <td>@Math.Round(day.TotalFat, 1)</td>
                        <td>@Math.Round(day.TotalCarbs, 1)</td>
                        <td class="text-center">
                            @if(day.CaloriesGoalMet)
                            {
                                <span class="badge bg-success">Так</span>
                            }
                            else if(day.TotalCalories > 0)
                            {
                                <span class="badge bg-danger">Ні</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">-</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var ctx = document.getElementById('progressChart').getContext('2d');
            
            var labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyProgress.Select(d => d.Date.ToString("dd.MM"))));
            var caloriesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyProgress.Select(d => Math.Round(d.TotalCalories, 1))));
            var goalLine = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Enumerable.Repeat(Model.CaloriesGoal, Model.TotalDays)));

            var myChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Спожито калорій',
                            data: caloriesData,
                            backgroundColor: 'rgba(54, 162, 235, 0.6)',
                            borderColor: 'rgba(54, 162, 235, 1)',
                            borderWidth: 1
                        },
                        {
                            label: 'Ціль калорій',
                            data: goalLine,
                            type: 'line',
                            backgroundColor: 'rgba(255, 99, 132, 1)',
                            borderColor: 'rgba(255, 99, 132, 1)',
                            borderWidth: 2,
                            fill: false,
                            pointRadius: 0
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });
        });
    </script>
}
