@model IEnumerable<StayFit.Domain.Entities.FoodLog>
@using System.Globalization

@{
    ViewData["Title"] = "Статистика за тиждень";

    var selectedDate = ViewBag.SelectedDate is DateTime d ? d.Date : DateTime.Today;
    var startOfWeek = selectedDate.AddDays(-(int)selectedDate.DayOfWeek == 0 ? 6 : (int)selectedDate.DayOfWeek - 1);

    var rows = Model?.ToList() ?? new List<StayFit.Domain.Entities.FoodLog>();

    decimal totalCalories = 0m, totalProtein = 0m, totalFat = 0m, totalCarbs = 0m;
    foreach (var log in rows)
    {
        var g = (decimal)log.AmountGrams;
        totalCalories += (decimal)(log.Food?.CaloriesPer100g ?? 0f) * g / 100m;
        totalProtein  += (decimal)(log.Food?.ProteinPer100g  ?? 0f) * g / 100m;
        totalFat      += (decimal)(log.Food?.FatPer100g      ?? 0f) * g / 100m;
        totalCarbs    += (decimal)(log.Food?.CarbsPer100g    ?? 0f) * g / 100m;
    }
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="mb-0">Статистика харчування</h2>
    <a asp-controller="Diary" asp-action="Index" class="btn btn-outline-secondary btn-sm">До щоденника</a>
</div>

<partial name="_StatisticsNav" />

<form method="get" asp-action="Weekly" class="card card-body mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-sm-6 col-md-4 col-lg-3">
            <label for="date" class="form-label mb-1">Початок тижня</label>
            <input id="date" type="date" name="date" value="@selectedDate.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Показати</button>
        </div>
    </div>
</form>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="text-muted small">Калорії</div>
                <div class="fs-5 fw-bold">@Math.Round(totalCalories, 1) ккал</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="text-muted small">Білки</div>
                <div class="fs-5 fw-bold">@Math.Round(totalProtein, 1) г</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="text-muted small">Жири</div>
                <div class="fs-5 fw-bold">@Math.Round(totalFat, 1) г</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="text-muted small">Вуглеводи</div>
                <div class="fs-5 fw-bold">@Math.Round(totalCarbs, 1) г</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header fw-semibold">Деталізація споживання за тиждень</div>
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Дата/Час</th>
                    <th>Продукт</th>
                    <th>Кількість (г)</th>
                    <th>Калорії</th>
                    <th>Білки</th>
                    <th>Жири</th>
                    <th>Вуглеводи</th>
                </tr>
            </thead>
            <tbody>
                @if (!rows.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">За обраний тиждень записів не знайдено.</td>
                    </tr>
                }
                else
                {
                    @foreach (var log in rows.OrderBy(x => x.LoggedAt))
                    {
                        var g2 = (decimal)log.AmountGrams;
                        <tr>
                            <td>@log.LoggedAt.ToLocalTime().ToString("dd.MM HH:mm")</td>
                            <td>@(log.Food?.Name ?? "-")</td>
                            <td>@Math.Round(g2, 1)</td>
                            <td>@Math.Round((decimal)(log.Food?.CaloriesPer100g ?? 0f) * g2 / 100m, 1)</td>
                            <td>@Math.Round((decimal)(log.Food?.ProteinPer100g  ?? 0f) * g2 / 100m, 1)</td>
                            <td>@Math.Round((decimal)(log.Food?.FatPer100g      ?? 0f) * g2 / 100m, 1)</td>
                            <td>@Math.Round((decimal)(log.Food?.CarbsPer100g    ?? 0f) * g2 / 100m, 1)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
