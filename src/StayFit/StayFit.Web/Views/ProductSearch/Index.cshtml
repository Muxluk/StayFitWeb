@model StayFit.Application.DTOs.PagedResult<StayFit.Domain.Entities.Food>
@using StayFit.Domain.Enums

@functions {
    string TranslateCategory(FoodCategory cat) => cat switch {
        FoodCategory.General    => "Загальне",
        FoodCategory.Meat       => "М'ясо",
        FoodCategory.Dairy      => "Молочні",
        FoodCategory.Vegetables => "Овочі",
        FoodCategory.Fruits     => "Фрукти",
        FoodCategory.Sweets     => "Солодощі",
        FoodCategory.Drinks     => "Напої",
        _                       => cat.ToString()
    };

    string CategoryIconClass(FoodCategory cat) => cat switch {
        FoodCategory.General    => "bi bi-fork-knife",
        FoodCategory.Meat       => "bi bi-egg-fried",
        FoodCategory.Dairy      => "bi bi-cup-straw",
        FoodCategory.Vegetables => "bi bi-flower1",
        FoodCategory.Fruits     => "bi bi-apple",
        FoodCategory.Sweets     => "bi bi-cake2",
        FoodCategory.Drinks     => "bi bi-cup-hot",
        _                       => "bi bi-fork-knife"
    };

    bool IsBrokenName(string? name)
    {
        return string.IsNullOrWhiteSpace(name);
    }
}

@{
    ViewData["Title"] = "Пошук продуктів";
    var searchTerm     = ViewBag.SearchTerm as string;
    var categoryFilter = ViewBag.CategoryFilter as FoodCategory?;

    var categoryOptions = new System.Text.StringBuilder();
    categoryOptions.AppendLine("<option value=''>Всі категорії</option>");
    foreach (var cat in Enum.GetValues(typeof(FoodCategory)).Cast<FoodCategory>())
    {
        var sel = categoryFilter == cat ? " selected" : "";
        categoryOptions.AppendLine($"<option value='{cat}'{sel}>{TranslateCategory(cat)}</option>");
    }
}

<div class="container mt-4">

    <div class="d-flex align-items-center mb-3">
        <h2 class="mb-0">Пошук продуктів</h2>
    </div>

    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link active" asp-controller="ProductSearch" asp-action="Index">Локальна база</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="FoodImport" asp-action="Index">Світова база</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Barcode" asp-action="Scan">Штрих-код</a>
        </li>
    </ul>

    @* Search form *@
    <form id="sf-ps-form" method="get" asp-controller="ProductSearch" asp-action="Index"
          class="row g-2 mb-4 align-items-end">
        <div class="col-12 col-sm-5">
            <label class="form-label text-muted sf-ps-field-label">Назва або бренд</label>
            <input type="text" name="searchTerm" id="sf-ps-input"
                   class="form-control"
                   placeholder="Наприклад: куряча грудка..."
                   value="@searchTerm" autocomplete="off" />
        </div>
        <div class="col-12 col-sm-4">
            <label class="form-label text-muted sf-ps-field-label">Категорія</label>
            <select name="category" class="form-select">
                @Html.Raw(categoryOptions.ToString())
            </select>
        </div>
        <div class="col-12 col-sm-3">
            <button type="submit" class="btn btn-primary w-100 sf-ps-search-btn" id="sf-ps-btn">
                <i class="bi bi-search me-1"></i>Шукати
            </button>
        </div>
    </form>

    @* Skeleton cards (hidden until search starts) *@
    <div id="sf-ps-skeleton" class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4 d-none">
        @for (int s = 0; s < 6; s++)
        {
            <div class="col">
                <div class="sf-ps-card">
                    <div class="sf-ps-img-wrap sf-skeleton-shimmer"></div>
                    <div class="card-body d-flex flex-column gap-2">
                        <div class="sf-skeleton-line sf-skeleton-line--lg sf-skeleton-shimmer"></div>
                        <div class="sf-skeleton-line sf-skeleton-line--sm sf-skeleton-shimmer"></div>
                        <div class="sf-ps-macro-row mt-2">
                            <div class="sf-skeleton-macro sf-skeleton-shimmer"></div>
                            <div class="sf-skeleton-macro sf-skeleton-shimmer"></div>
                            <div class="sf-skeleton-macro sf-skeleton-shimmer"></div>
                            <div class="sf-skeleton-macro sf-skeleton-shimmer"></div>
                        </div>
                    </div>
                    <div class="sf-ps-footer">
                        <div class="sf-skeleton-line sf-skeleton-shimmer"></div>
                    </div>
                </div>
            </div>
        }
    </div>

    @* Real results *@
    <div id="sf-ps-results">
        @if (Model == null || !Model.Items.Any())
        {
            if (!string.IsNullOrEmpty(searchTerm))
            {
                <div class="sf-ps-empty">
                    <div class="sf-ps-empty-icon">🔍</div>
                    <h5 class="text-muted">Нічого не знайдено</h5>
                    <p class="text-muted small">Спробуйте інший запит або оберіть іншу категорію</p>
                </div>
            }
            else
            {
                <div class="sf-ps-empty">
                    <div class="sf-ps-empty-icon">🥗</div>
                    <h5 class="text-muted">Введіть запит для пошуку</h5>
                    <p class="text-muted small">Шукайте серед тисяч продуктів нашої бази</p>
                </div>
            }
        }
        else
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <small class="text-muted">
                    Знайдено: <strong>@Model.TotalCount</strong>
                    @if (!string.IsNullOrEmpty(searchTerm))
                    {
                        <span> за запитом «<em>@searchTerm</em>»</span>
                    }
                </small>
            </div>

            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4 mb-4">
                @foreach (var item in Model.Items)
                {
                    <div class="col">
                        <div class="sf-ps-card">

                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <div class="sf-ps-img-wrap">
                                    <img src="@item.ImageUrl" alt="@item.Name"
                                         class="sf-ps-img" loading="lazy" />
                                </div>
                            }
                            else
                            {
                                <div class="sf-ps-img-wrap sf-ps-no-img">
                                    <i class="@CategoryIconClass(item.Category) sf-ps-no-img-icon" aria-hidden="true"></i>
                                </div>
                            }

                            <div class="card-body d-flex flex-column p-3">
                                <div class="mb-auto">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <h5 class="sf-ps-title mb-0">@item.Name</h5>
                                        <span class="text-muted small ms-2" style="white-space: nowrap;">#@item.Id</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.Brand))
                                    {
                                        <p class="sf-ps-brand">@item.Brand</p>
                                    }
                                    <div class="sf-ps-badges">
                                        <span class="sf-ps-category-badge">
                                            <i class="@CategoryIconClass(item.Category) me-1" aria-hidden="true"></i>@TranslateCategory(item.Category)
                                        </span>
                                        @if (item.IsVerified)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle sf-ps-verified">✓ Перевірено</span>
                                        }
                                    </div>
                                </div>

                                <div class="sf-ps-macro-row">
                                    <div class="sf-ps-macro sf-ps-macro--cal">
                                        <span class="sf-ps-macro-val">@item.CaloriesPer100g.ToString("0.#")</span>
                                        <span class="sf-ps-macro-lbl">ккал</span>
                                    </div>
                                    <div class="sf-ps-macro sf-ps-macro--prot">
                                        <span class="sf-ps-macro-val">@item.ProteinPer100g.ToString("0.#")</span>
                                        <span class="sf-ps-macro-lbl">білки</span>
                                    </div>
                                    <div class="sf-ps-macro sf-ps-macro--fat">
                                        <span class="sf-ps-macro-val">@item.FatPer100g.ToString("0.#")</span>
                                        <span class="sf-ps-macro-lbl">жири</span>
                                    </div>
                                    <div class="sf-ps-macro sf-ps-macro--carb">
                                        <span class="sf-ps-macro-val">@item.CarbsPer100g.ToString("0.#")</span>
                                        <span class="sf-ps-macro-lbl">вуглев.</span>
                                    </div>
                                </div>
                                <p class="sf-ps-per100">на 100 г</p>
                            </div>

                            <div class="sf-ps-footer">
                                <form asp-controller="Food" asp-action="AddToLog" method="post">
                                    <input type="hidden" name="foodId" value="@item.Id" />
                                    <div class="d-flex gap-2">
                                        <input type="number" name="quantity"
                                               class="form-control form-control-sm sf-ps-qty"
                                               placeholder="г" value="100" min="1" required />
                                        <button type="submit" class="btn btn-outline-success btn-sm flex-grow-1">
                                            <i class="bi bi-plus-circle me-1"></i>В щоденник
                                        </button>
                                    </div>
                                </form>
                            </div>

                        </div>
                    </div>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Пагінація" class="mb-4">
                    <ul class="pagination justify-content-center flex-wrap">
                        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-route-searchTerm="@searchTerm"
                               asp-route-category="@categoryFilter"
                               asp-route-page="@(Model.PageNumber - 1)"><i class="bi bi-chevron-left"></i></a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                                <a class="page-link"
                                   asp-route-searchTerm="@searchTerm"
                                   asp-route-category="@categoryFilter"
                                   asp-route-page="@i">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-route-searchTerm="@searchTerm"
                               asp-route-category="@categoryFilter"
                               asp-route-page="@(Model.PageNumber + 1)"><i class="bi bi-chevron-right"></i></a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>

</div>

@section Scripts {
}
