@model StayFit.Web.Models.ExportViewModel

@{
    ViewData["Title"] = "Експорт харчування";
}

<div class="container mt-4" style="max-width: 560px;">
    <h2 class="mb-4">📤 Експорт записів харчування</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Export" asp-controller="Export" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="alert alert-danger" style="display:none"
                     id="validationSummary"></div>

                @{
                    var hasSummaryErrors = !ViewData.ModelState.IsValid &&
                                          ViewData.ModelState.ContainsKey(string.Empty);
                }
                @if (hasSummaryErrors)
                {
                    <div class="alert alert-danger">
                        @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                        {
                            <p class="mb-0">@error.ErrorMessage</p>
                        }
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="From" class="form-label fw-semibold"></label>
                    <input asp-for="From" type="date" class="form-control"
                           value="@Model.From.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="From" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="To" class="form-label fw-semibold"></label>
                    <input asp-for="To" type="date" class="form-control"
                           value="@Model.To.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="To" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Format" class="form-label fw-semibold">Формат файлу</label>
                    <div class="d-flex gap-4">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="Format"
                                   value="Csv" id="formatCsv"
                                   checked="@(Model.Format == StayFit.Application.Interfaces.ExportFormat.Csv)" />
                            <label class="form-check-label" for="formatCsv">
                                📄 CSV (Excel)
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="Format"
                                   value="Pdf" id="formatPdf"
                                   checked="@(Model.Format == StayFit.Application.Interfaces.ExportFormat.Pdf)" />
                            <label class="form-check-label" for="formatPdf">
                                📑 PDF (звіт)
                            </label>
                        </div>
                    </div>
                    <span asp-validation-for="Format" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-success w-100">
                    ⬇️ Завантажити файл
                </button>
            </form>
        </div>
    </div>

    <div class="mt-3 text-muted small">
        💡 CSV зручний для відкриття в Excel або Google Sheets.<br />
        PDF — готовий друкований звіт з підсумками.
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
