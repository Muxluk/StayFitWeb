@model StayFit.Web.Models.ExportViewModel

@{
    ViewData["Title"] = "Експорт харчування";
}

<div class="container mt-4 mw-560">
    <div class="mb-4">
        <h2 class="mb-1"><i class="bi bi-download"></i> Експорт записів харчування</h2>
        <p class="text-muted mb-0">Завантажте свої дані щоденника в обраному форматі</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Export" asp-controller="Export" method="post" id="exportForm">
                @Html.AntiForgeryToken()

                <!-- Validation Summary -->
                @{
                    var hasSummaryErrors = !ViewData.ModelState.IsValid &&
                                          ViewData.ModelState.ContainsKey(string.Empty);
                }
                @if (hasSummaryErrors)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-circle"></i> <strong>Помилка експорту:</strong>
                        @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                        {
                            <p class="mb-0">@error.ErrorMessage</p>
                        }
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <!-- Date Range Selection -->
                <div class="mb-4">
                    <h5 class="fw-semibold mb-3"><i class="bi bi-calendar-range"></i> Період експорту</h5>
                    
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="From" class="form-label">Від дати</label>
                            <input asp-for="From" type="date" class="form-control"
                                   value="@Model.From.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="From" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="To" class="form-label">До дати</label>
                            <input asp-for="To" type="date" class="form-control"
                                   value="@Model.To.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="To" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Record Count Preview -->
                    <div class="alert alert-info mt-3 small" id="recordCountInfo">
                        <i class="bi bi-info-circle"></i> Виберіть період для отримання інформації про кількість записів
                    </div>
                </div>

                <hr class="my-4">

                <!-- Format Selection -->
                <div class="mb-4">
                    <h5 class="fw-semibold mb-3"><i class="bi bi-file-earmark"></i> Формат файлу</h5>

                    <div class="export-format-option @(Model.Format == StayFit.Application.Interfaces.ExportFormat.Csv ? "active" : "")">
                        <input class="form-check-input" type="radio" asp-for="Format"
                               value="Csv" id="formatCsv"
                               checked="@(Model.Format == StayFit.Application.Interfaces.ExportFormat.Csv)" />
                        <span class="format-icon text-success"><i class="bi bi-file-earmark-spreadsheet"></i></span>
                        <div class="format-content flex-grow-1">
                            <label class="format-label" for="formatCsv">
                                <h6>CSV (Excel)</h6>
                                <p>Відкривається в Excel, Google Sheets та інших редакторах таблиць. Ідеально для аналізу даних.</p>
                            </label>
                        </div>
                    </div>

                    <div class="export-format-option @(Model.Format == StayFit.Application.Interfaces.ExportFormat.Pdf ? "active" : "")">
                        <input class="form-check-input" type="radio" asp-for="Format"
                               value="Pdf" id="formatPdf"
                               checked="@(Model.Format == StayFit.Application.Interfaces.ExportFormat.Pdf)" />
                        <span class="format-icon text-danger"><i class="bi bi-file-earmark-pdf"></i></span>
                        <div class="format-content flex-grow-1">
                            <label class="format-label" for="formatPdf">
                                <h6>PDF (Звіт)</h6>
                                <p>Готовий до друку звіт з форматуванням та підсумками. Добре виглядає при прегляді та друку.</p>
                            </label>
                        </div>
                    </div>

                    <span asp-validation-for="Format" class="text-danger small"></span>
                </div>

                <!-- Action Button -->
                <button type="submit" class="btn btn-success btn-lg w-100">
                    <i class="bi bi-download"></i> Завантажити файл
                </button>
            </form>

            <hr class="my-4">

            <!-- Info Box -->
            <div class="alert alert-light border small">
                <p class="mb-2">
                    <strong><i class="bi bi-lightbulb"></i> Поради:</strong>
                </p>
                <ul class="mb-0 ps-3">
                    <li><strong>CSV</strong> — використовуйте для детального аналізу в Excel або Google Sheets</li>
                    <li><strong>PDF</strong> — ідеально для збереження звіту або надрукування</li>
                    <li>Великі діапазони дат можуть займати більший простір. Макс. розмір файлу: 50MB</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
