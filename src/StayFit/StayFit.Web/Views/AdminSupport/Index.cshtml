@using StayFit.Domain.Enums
@model StayFit.Application.DTOs.PagedResult<StayFit.Application.DTOs.SupportTicketAdminDto>

@{
    ViewData["Title"] = "Керування зверненнями";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-envelope text-warning"></i> Керування зверненнями</h2>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Назад до панелі
        </a>
    </div>

    <!-- Фільтр -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label text-muted small fw-bold">Статус звернення:</label>
                    <select name="statusFilter" class="form-select">
                        <option value="">Всі статуси</option>
                        <option value="@SupportStatus.New" selected="@(ViewBag.CurrentFilter as SupportStatus? == SupportStatus.New ? "selected" : null)">Нові</option>
                        <option value="@SupportStatus.InProgress" selected="@(ViewBag.CurrentFilter as SupportStatus? == SupportStatus.InProgress ? "selected" : null)">В обробці</option>
                        <option value="@SupportStatus.Closed" selected="@(ViewBag.CurrentFilter as SupportStatus? == SupportStatus.Closed ? "selected" : null)">Закриті</option>
                    </select>
                </div>
                <div class="col-md-auto">
                    <button type="submit" class="btn btn-primary">Фільтрувати</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Скинути</a>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

    <!-- Таблиця -->
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Email користувача</th>
                        <th>Тема</th>
                        <th>Статус</th>
                        <th>Дата створення</th>
                        <th class="text-end">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="6" class="text-center py-4 text-muted">Звернень не знайдено</td></tr>
                    }
                    @foreach (var ticket in Model.Items)
                    {
                        <tr>
                            <td>#@ticket.Id</td>
                            <td>@ticket.UserEmail</td>
                            <td class="fw-bold">@ticket.Subject</td>
                            <td>
                                @if(ticket.Status == SupportStatus.New) { <span class="badge bg-primary">Нове</span> }
                                else if(ticket.Status == SupportStatus.InProgress) { <span class="badge bg-warning text-dark">В обробці</span> }
                                else { <span class="badge bg-success">Закрито</span> }
                            </td>
                            <td>@ticket.CreatedAt.ToString("g")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@ticket.Id" class="btn btn-sm btn-outline-primary">Деталі</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Пагінація -->
    @if (Model.TotalPages > 1)
    {
        <div class="mt-4 d-flex justify-content-center">
            <ul class="pagination">
                <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-statusFilter="@ViewBag.CurrentFilter">Попередня</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-statusFilter="@ViewBag.CurrentFilter">@i</a>
                    </li>
                }
                <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-statusFilter="@ViewBag.CurrentFilter">Наступна</a>
                </li>
            </ul>
        </div>
    }
</div>