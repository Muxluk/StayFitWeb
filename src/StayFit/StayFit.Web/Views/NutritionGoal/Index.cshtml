@model StayFit.Application.DTOs.SetNutritionGoalDto
@{
    ViewData["Title"] = "Мої цілі";
    var goal = ViewBag.Goal as StayFit.Application.DTOs.NutritionGoalDto;
    var logs = ViewBag.CurrentNutrition as IEnumerable<StayFit.Domain.Entities.FoodLog>;

    float curCalories = (float)(logs?.Sum(l => (double)(l.Food?.CaloriesPer100g ?? 0) * (l.Quantity / 100.0)) ?? 0);
    float curProteins = (float)(logs?.Sum(l => (double)(l.Food?.ProteinPer100g ?? 0) * (l.Quantity / 100.0)) ?? 0);
    float curFats = (float)(logs?.Sum(l => (double)(l.Food?.FatPer100g ?? 0) * (l.Quantity / 100.0)) ?? 0);
    float curCarbs = (float)(logs?.Sum(l => (double)(l.Food?.CarbsPer100g ?? 0) * (l.Quantity / 100.0)) ?? 0);
}

<div class="container mt-4">
    <h2>🎯 Встановлення цілей харчування</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="row mt-4">
        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Редагувати цілі</h5>
                    <form asp-action="Index" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        
                        <div class="mb-3">
                            <label asp-for="CaloriesGoal" class="form-label">Ціль калорій (ккал)</label>
                            <input asp-for="CaloriesGoal" class="form-control" type="number" step="1" />
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="ProteinGoal" class="form-label">Білки (г)</label>
                                <input asp-for="ProteinGoal" class="form-control" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="FatGoal" class="form-label">Жири (г)</label>
                                <input asp-for="FatGoal" class="form-control" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="CarbsGoal" class="form-label">Вугл. (г)</label>
                                <input asp-for="CarbsGoal" class="form-control" />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Зберегти зміни</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-4">Прогрес за сьогодні</h5>

                    @if (goal != null)
                    {
                        @await Html.PartialAsync("_ProgressBar", new ProgressBarViewModel
                        {
                            Label = "Калорії",
                            ValueText = $"{curCalories:0} / {goal.CaloriesGoal:0} ккал",
                            Value = (decimal)curCalories,
                            Max = (decimal)goal.CaloriesGoal,
                            ColorClass = curCalories < goal.CaloriesGoal * 0.5f ? "bg-danger" : curCalories <= goal.CaloriesGoal * 1.05f ? "bg-success" : curCalories <= goal.CaloriesGoal * 1.1f ? "bg-warning" : "bg-danger",
                            ProgressClass = "progress-md",
                            TrackClass = "progress-track-default",
                            BarClass = "shadow-sm progress-bar-animated-width"
                        })

                        @await Html.PartialAsync("_ProgressBar", new ProgressBarViewModel
                        {
                            Label = "Білки",
                            ValueText = $"{curProteins:0} / {goal.ProteinGoal:0} г",
                            Value = (decimal)curProteins,
                            Max = (decimal)goal.ProteinGoal,
                            ColorClass = curProteins < goal.ProteinGoal * 0.5f ? "bg-danger" : curProteins <= goal.ProteinGoal * 1.05f ? "bg-success" : curProteins <= goal.ProteinGoal * 1.1f ? "bg-warning" : "bg-danger",
                            ProgressClass = "progress-md",
                            TrackClass = "progress-track-default",
                            BarClass = "shadow-sm progress-bar-animated-width"
                        })

                        @await Html.PartialAsync("_ProgressBar", new ProgressBarViewModel
                        {
                            Label = "Жири",
                            ValueText = $"{curFats:0} / {goal.FatGoal:0} г",
                            Value = (decimal)curFats,
                            Max = (decimal)goal.FatGoal,
                            ColorClass = curFats < goal.FatGoal * 0.5f ? "bg-danger" : curFats <= goal.FatGoal * 1.05f ? "bg-success" : curFats <= goal.FatGoal * 1.1f ? "bg-warning" : "bg-danger",
                            ProgressClass = "progress-md",
                            TrackClass = "progress-track-default",
                            BarClass = "shadow-sm progress-bar-animated-width"
                        })

                        @await Html.PartialAsync("_ProgressBar", new ProgressBarViewModel
                        {
                            Label = "Вуглеводи",
                            ValueText = $"{curCarbs:0} / {goal.CarbsGoal:0} г",
                            Value = (decimal)curCarbs,
                            Max = (decimal)goal.CarbsGoal,
                            ColorClass = curCarbs < goal.CarbsGoal * 0.5f ? "bg-danger" : curCarbs <= goal.CarbsGoal * 1.05f ? "bg-success" : curCarbs <= goal.CarbsGoal * 1.1f ? "bg-warning" : "bg-danger",
                            ProgressClass = "progress-md",
                            TrackClass = "progress-track-default",
                            BarClass = "shadow-sm progress-bar-animated-width"
                        })
                    }
                    else
                    {
                        <p class="text-muted">Встановіть цілі, щоб бачити прогрес.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}