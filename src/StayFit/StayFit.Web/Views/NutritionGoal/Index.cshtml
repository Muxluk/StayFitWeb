@model StayFit.Application.DTOs.SetNutritionGoalDto
@{
    ViewData["Title"] = "Мої цілі";
    var goal = ViewBag.Goal as StayFit.Application.DTOs.NutritionGoalDto;
    var logs = ViewBag.CurrentNutrition as IEnumerable<StayFit.Domain.Entities.FoodLog>;

    float curCalories = (float)(logs?.Sum(l => (double)(l.Food?.CaloriesPer100g ?? 0) * (l.Quantity / 100.0)) ?? 0);
    float curProteins = (float)(logs?.Sum(l => (double)(l.Food?.ProteinPer100g ?? 0) * (l.Quantity / 100.0)) ?? 0);
    float curFats = (float)(logs?.Sum(l => (double)(l.Food?.FatPer100g ?? 0) * (l.Quantity / 100.0)) ?? 0);
    float curCarbs = (float)(logs?.Sum(l => (double)(l.Food?.CarbsPer100g ?? 0) * (l.Quantity / 100.0)) ?? 0);
}

<div class="container mt-4">
    <h2>Встановлення цілей харчування</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4 mt-2">
        @* ── Форма редагування цілей (ліва сторона) ── *@
        <div class="col-12 col-lg-5">
            <div class="card sf-card">
                <div class="card-body">
                    <h5 class="card-title mb-4">Редагувати цілі</h5>
                    <form asp-action="Index" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        @* Калорії *@
                        <div class="mb-3">
                            <label asp-for="CaloriesGoal" class="form-label">Ціль калорій</label>
                            <div class="input-group">
                                <input asp-for="CaloriesGoal" class="form-control form-control-lg" type="number" step="50" min="1000" max="5000" placeholder="2000" />
                                <span class="input-group-text">ккал</span>
                            </div>
                        </div>

                        @* КБЖВ *@
                        <div class="row g-2">
                            <div class="col-sm-4">
                                <label asp-for="ProteinGoal" class="form-label">Білки</label>
                                <div class="input-group">
                                    <input asp-for="ProteinGoal" class="form-control" type="number" step="5" min="0" placeholder="150" />
                                    <span class="input-group-text">г</span>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <label asp-for="FatGoal" class="form-label">Жири</label>
                                <div class="input-group">
                                    <input asp-for="FatGoal" class="form-control" type="number" step="5" min="0" placeholder="60" />
                                    <span class="input-group-text">г</span>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <label asp-for="CarbsGoal" class="form-label">Вуглеводи</label>
                                <div class="input-group">
                                    <input asp-for="CarbsGoal" class="form-control" type="number" step="5" min="0" placeholder="250" />
                                    <span class="input-group-text">г</span>
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 mt-4">Зберегти зміни</button>
                    </form>
                </div>
            </div>
        </div>

        @* ── Прогрес (права сторона) ── *@
        <div class="col-12 col-lg-7">
            <div class="card sf-card">
                <div class="card-body">
                    <h5 class="card-title mb-4">Прогрес за сьогодні</h5>

                    @if (goal != null)
                    {
                        @* Калорії *@
                        <div class="mb-4 pb-3 border-bottom">
                            <div class="d-flex justify-content-between align-items-baseline mb-2">
                                <div>
                                    <span class="fw-semibold">Калорії</span>
                                </div>
                                <div class="text-end">
                                    <span class="sf-card-value">@curCalories.ToString("F0")</span>
                                    <span class="text-muted small">/ @goal.CaloriesGoal.ToString("F0") ккал</span>
                                </div>
                            </div>
                            @await Html.PartialAsync("_ProgressBar", null, new ViewDataDictionary(ViewData)
                            {
                                ["Actual"] = (double)curCalories,
                                ["Target"] = (double)goal.CaloriesGoal,
                                ["Color"] = curCalories > goal.CaloriesGoal * 1.1f ? "danger" : "success"
                            })
                            @if (curCalories > goal.CaloriesGoal)
                            {
                                <small class="text-danger d-block mt-1">Перевищено на @((curCalories - goal.CaloriesGoal).ToString("F0")) ккал</small>
                            }
                        </div>

                        @* Білки *@
                        <div class="mb-4 pb-3 border-bottom">
                            <div class="d-flex justify-content-between align-items-baseline mb-2">
                                <div>
                                    <span class="fw-semibold">Білки</span>
                                </div>
                                <div class="text-end">
                                    <span class="sf-card-value">@curProteins.ToString("F1")</span>
                                    <span class="text-muted small">/ @goal.ProteinGoal.ToString("F0") г</span>
                                </div>
                            </div>
                            @await Html.PartialAsync("_ProgressBar", null, new ViewDataDictionary(ViewData)
                            {
                                ["Actual"] = (double)curProteins,
                                ["Target"] = (double)goal.ProteinGoal,
                                ["Color"] = "info"
                            })
                            @if (curProteins > goal.ProteinGoal)
                            {
                                <small class="text-danger d-block mt-1">Перевищено на @((curProteins - goal.ProteinGoal).ToString("F1")) г</small>
                            }
                        </div>

                        @* Жири *@
                        <div class="mb-4 pb-3 border-bottom">
                            <div class="d-flex justify-content-between align-items-baseline mb-2">
                                <div>
                                    <span class="fw-semibold">Жири</span>
                                </div>
                                <div class="text-end">
                                    <span class="sf-card-value">@curFats.ToString("F1")</span>
                                    <span class="text-muted small">/ @goal.FatGoal.ToString("F0") г</span>
                                </div>
                            </div>
                            @await Html.PartialAsync("_ProgressBar", null, new ViewDataDictionary(ViewData)
                            {
                                ["Actual"] = (double)curFats,
                                ["Target"] = (double)goal.FatGoal,
                                ["Color"] = "warning"
                            })
                            @if (curFats > goal.FatGoal)
                            {
                                <small class="text-danger d-block mt-1">Перевищено на @((curFats - goal.FatGoal).ToString("F1")) г</small>
                            }
                        </div>

                        @* Вуглеводи *@
                        <div class="mb-2">
                            <div class="d-flex justify-content-between align-items-baseline mb-2">
                                <div>
                                    <span class="fw-semibold">Вуглеводи</span>
                                </div>
                                <div class="text-end">
                                    <span class="sf-card-value">@curCarbs.ToString("F1")</span>
                                    <span class="text-muted small">/ @goal.CarbsGoal.ToString("F0") г</span>
                                </div>
                            </div>
                            @await Html.PartialAsync("_ProgressBar", null, new ViewDataDictionary(ViewData)
                            {
                                ["Actual"] = (double)curCarbs,
                                ["Target"] = (double)goal.CarbsGoal,
                                ["Color"] = "primary"
                            })
                            @if (curCarbs > goal.CarbsGoal)
                            {
                                <small class="text-danger d-block mt-1">Перевищено на @((curCarbs - goal.CarbsGoal).ToString("F1")) г</small>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            <strong>Інформація:</strong> Встановіть цілі зліва, щоб бачити прогрес.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* ── Порада (горизонтальна стрічка) ── *@
    <div class="alert alert-light border mt-3 mb-0 py-2 px-3">
        <small class="text-muted">
            <strong>Порада:</strong> Стандартна норма — 2000 ккал з розподілом 50% вуглеводів, 30% білків, 20% жирів.
        </small>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}