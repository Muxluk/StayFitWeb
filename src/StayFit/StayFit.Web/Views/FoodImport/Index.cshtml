@model IEnumerable<StayFit.Domain.Entities.Food>

@{
    ViewData["Title"] = "Імпорт продуктів";
}

<div class="container py-4">
    <div class="sf-card mb-4">
        <div class="card-body">
            <h1 class="h3 fw-bold mb-3">Імпорт з OpenFoodFacts</h1>
            <p class="text-muted">Шукайте продукти у глобальній базі даних та додавайте їх до свого списку.</p>

            <form id="sf-fi-form" asp-action="Index" method="get" class="row g-2">
                <div class="col">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" 
                               class="form-control border-start-0" placeholder="Назва продукту або штрих-код..." required>
                    </div>
                </div>
                <div class="col-auto">
                    <button type="submit" id="sf-fi-btn" class="btn btn-primary px-4">
                        <span id="sf-fi-btn-text">Шукати</span>
                        <span id="sf-fi-btn-spinner" class="spinner-border spinner-border-sm d-none"></span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div id="sf-fi-skeleton" class="d-none">
        <div class="sf-card mb-3 skeleton">
            <div class="card-body py-4"></div>
        </div>
        <div class="sf-card mb-3 skeleton">
            <div class="card-body py-4"></div>
        </div>
    </div>

    <div id="sf-fi-results">
        @if (Model != null)
        {
            if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-search text-muted display-1"></i>
                    <p class="mt-3 text-muted">Нічого не знайдено за вашим запитом.</p>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 g-4">
                    @foreach (var item in Model)
                    {
                        <div class="col">
                            <div class="sf-card h-100">
                                <div class="row g-0">
                                    <div class="col-4">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" class="img-fluid rounded-start h-100 object-fit-cover" alt="@item.Name">
                                        }
                                        else
                                        {
                                            <div class="bg-light d-flex align-items-center justify-content-center h-100 rounded-start">
                                                <i class="bi bi-image text-muted fs-1"></i>
                                            </div>
                                        }
                                    </div>
                                    <div class="col-8">
                                        <div class="card-body">
                                            <h5 class="card-title text-truncate" title="@item.Name">@item.Name</h5>
                                            <p class="card-text small text-muted mb-2">@item.Brand</p>
                                            
                                            <div class="d-flex gap-2 mb-3">
                                                <span class="badge bg-primary">@item.CaloriesPer100g.ToString("F0") ккал</span>
                                                <span class="badge bg-info">@item.ProteinPer100g.ToString("F1") П</span>
                                            </div>

                                            <form asp-action="Import" method="post">
                                                <input type="hidden" name="Name" value="@item.Name" />
                                                <input type="hidden" name="Brand" value="@item.Brand" />
                                                <input type="hidden" name="CaloriesPer100g" value="@item.CaloriesPer100g" />
                                                <input type="hidden" name="ProteinPer100g" value="@item.ProteinPer100g" />
                                                <input type="hidden" name="FatPer100g" value="@item.FatPer100g" />
                                                <input type="hidden" name="CarbsPer100g" value="@item.CarbsPer100g" />
                                                <input type="hidden" name="ImageUrl" value="@item.ImageUrl" />
                                                
                                                <button type="submit" class="btn btn-sm btn-outline-primary w-100">
                                                    <i class="bi bi-plus-lg"></i> Додати
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>

</div>

@section Scripts {
    <script src="~/js/food-import.js" asp-append-version="true"></script>
}