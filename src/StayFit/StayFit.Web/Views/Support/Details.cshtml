@model StayFit.Application.DTOs.SupportTicketDto

@{
    ViewData["Title"] = "Деталі звернення";
}

<div class="container mt-4 mb-5">
    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <!-- Header -->
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h2 class="mb-2"><i class="bi bi-chat-left-dots"></i> @Model.Subject</h2>
                        <div class="text-muted small">
                            <span class="me-3">ID: #@Model.Id</span>
                            <span>@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                    </div>
                    <div>
                        @switch(Model.Status?.Trim().ToLowerInvariant())
                        {
                            case "new":
                                <span class="badge bg-primary fs-6"><i class="bi bi-envelope"></i> Нове</span>
                                break;
                            case "inprogress":
                            case "in_progress":
                            case "processing":
                                <span class="badge bg-warning text-dark fs-6"><i class="bi bi-arrow-repeat"></i> В обробці</span>
                                break;
                            case "closed":
                                <span class="badge bg-success fs-6"><i class="bi bi-check-circle"></i> Закрито</span>
                                break;
                            default:
                                <span class="badge bg-secondary fs-6">@Model.Status</span>
                                break;
                        }
                    </div>
                </div>
            </div>

            <!-- Chat Container -->
            <div class="card shadow-sm mb-4 border-0">
                <div class="card-body p-0 support-chat-scroll">
                    <!-- User's Original Message -->
                    <div class="p-3 border-bottom bg-light-subtle">
                        <div class="d-flex justify-content-end mb-2">
                            <span class="badge bg-light text-dark small">
                                <i class="bi bi-person-circle"></i> Ви
                            </span>
                        </div>
                        <div class="support-chat-user support-chat-bubble-fit ms-auto mb-2">
                            @Model.Message
                        </div>
                        <div class="text-end">
                            <small class="text-muted">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                        </div>
                    </div>

                    <!-- Replies -->
                    @if (Model.Replies != null && Model.Replies.Any())
                    {
                        @foreach (var reply in Model.Replies.OrderBy(r => r.CreatedAt))
                        {
                            <div class="p-3 @(reply.IsAdminReply ? "bg-white" : "bg-light-subtle")">
                                <div class="@(reply.IsAdminReply ? "d-flex justify-content-start" : "d-flex justify-content-end") mb-2">
                                    @if (reply.IsAdminReply)
                                    {
                                        <span class="badge bg-danger small">
                                            <i class="bi bi-shield-check"></i> Технічна підтримка
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark small">
                                            <i class="bi bi-person-circle"></i> Ви
                                        </span>
                                    }
                                </div>
                                
                                @if (reply.IsAdminReply)
                                {
                                    <div class="support-chat-admin mb-2">
                                        @reply.Message
                                    </div>
                                }
                                else
                                {
                                    <div class="support-chat-user support-chat-bubble-fit ms-auto mb-2">
                                        @reply.Message
                                    </div>
                                }

                                <div class="@(reply.IsAdminReply ? "text-start" : "text-end")">
                                    <small class="text-muted">@reply.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                                </div>
                            </div>
                        }
                    }
                    else if (Model.Replies?.Count == 0)
                    {
                        <div class="p-4 text-center text-muted">
                            <i class="bi bi-hourglass-split support-empty-icon"></i><br>
                            <p class="mt-2">Поки що немає відповідей на ваше звернення.<br><small>Адмін розглядає ваш запит.</small></p>
                        </div>
                    }
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex gap-2">
                <a href="@Url.Action("Index", "Support")" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Назад до списку
                </a>
                @if (Model.Status?.Trim().ToLowerInvariant() != "closed")
                {
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#replyModal">
                        <i class="bi bi-reply"></i> Додати коментар
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<!-- Reply Modal -->
@if (Model.Status?.Trim().ToLowerInvariant() != "closed")
{
    <div class="modal fade" id="replyModal" tabindex="-1" aria-labelledby="replyModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-light-subtle">
                    <h5 class="modal-title" id="replyModalLabel"><i class="bi bi-pencil-square"></i> Додати коментар</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" action="@Url.Action("AddReply", "Support")">
                    <div class="modal-body">
                        <input type="hidden" name="ticketId" value="@Model.Id" />
                        <div class="mb-3">
                            <label for="message" class="form-label">Ваш коментар:</label>
                            <textarea class="form-control" id="message" name="message" rows="5" required placeholder="Введіть ваш коментар..."></textarea>
                            <small class="text-muted">Максимум 2000 символів</small>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Скасувати</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-send"></i> Надіслати
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

