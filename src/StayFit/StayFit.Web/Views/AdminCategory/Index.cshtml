@model List<StayFit.Domain.Entities.FoodCategoryEntity>

@{
    ViewData["Title"] = "Управління категоріями продуктів";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>@ViewData["Title"]</h1>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("Create", "AdminCategory")" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Додати категорію
            </a>
        </div>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle"></i> Категорій не знайдено. 
            <a href="@Url.Action("Create", "AdminCategory")" class="alert-link">Додати першу</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th class="admin-category-col-id">ID</th>
                        <th class="admin-category-col-name">Назва</th>
                        <th class="admin-category-col-description">Опис</th>
                        <th class="admin-category-col-status">Статус</th>
                        <th class="admin-category-col-actions">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td><strong>@category.Id</strong></td>
                            <td>@category.Name</td>
                            <td>@(string.IsNullOrEmpty(category.Description) ? "- нема опису -" : category.Description)</td>
                            <td>
                                @if (category.IsActive)
                                {
                                    <span class="badge bg-success">Активна</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Неактивна</span>
                                }
                            </td>
                            <td>
                                <a href="@Url.Action("Edit", "AdminCategory", new { id = category.Id })" 
                                   class="btn btn-sm btn-warning" title="Редагувати">
                                    <i class="bi bi-pencil"></i> Редагувати
                                </a>
                                <form method="post" action="@Url.Action("Delete", "AdminCategory", new { id = category.Id })" 
                                      class="d-inline"
                                      onsubmit="return confirm('Видалити категорію &quot;@category.Name&quot;?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger" title="Видалити">
                                        <i class="bi bi-trash"></i> Видалити
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            <small class="text-muted">
                Всього категорій: <strong>@Model.Count</strong>
            </small>
        </div>
    }
</div>

