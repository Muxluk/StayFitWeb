@model List<StayFit.Domain.Entities.FoodCategoryEntity>

@functions {
    (string icon, string color) CategoryStyle(string name) => name?.ToLower() switch {
        var n when n != null && (n.Contains("м'ясо") || n.Contains("мясо") || n.Contains("meat")) => ("🥩", "danger"),
        var n when n != null && (n.Contains("риба") || n.Contains("морепрод") || n.Contains("fish")) => ("🐟", "info"),
        var n when n != null && (n.Contains("молоч") || n.Contains("dairy")) => ("🥛", "primary"),
        var n when n != null && (n.Contains("овоч") || n.Contains("vegetable")) => ("🥦", "success"),
        var n when n != null && (n.Contains("фрукт") || n.Contains("fruit")) => ("🍎", "warning"),
        var n when n != null && (n.Contains("солод") || n.Contains("sweet") || n.Contains("десерт")) => ("🍰", "pink"),
        var n when n != null && (n.Contains("напій") || n.Contains("напо") || n.Contains("drink")) => ("🥤", "primary"),
        var n when n != null && (n.Contains("зерн") || n.Contains("крупи") || n.Contains("grain")) => ("🌾", "warning"),
        var n when n != null && (n.Contains("горіх") || n.Contains("nuts")) => ("🥜", "secondary"),
        var n when n != null && (n.Contains("яйц") || n.Contains("egg")) => ("🥚", "warning"),
        _ => ("🍽️", "secondary")
    };
}

@{
    ViewData["Title"] = "Управління категоріями";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-end mb-3 pb-2 border-bottom border-secondary">
        <div>
            <h2 class="mb-1">
                <i class="bi bi-tags text-primary me-2"></i>Категорії продуктів
            </h2>
            <p class="text-muted mb-0">Управління категоріями харчових продуктів</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Нова категорія
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <i class="bi bi-tags display-4 text-muted mb-3"></i>
                <h5>Категорій не знайдено</h5>
                <a asp-action="Create" class="btn btn-primary mt-2">
                    <i class="bi bi-plus-lg me-1"></i>Додати першу
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3 sf-admin-category-id-col">ID</th>
                            <th>Назва / Іконка</th>
                            <th>Опис</th>
                            <th class="text-center">Статус</th>
                            <th class="text-center">Продуктів</th>
                            <th class="text-end pe-3">Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in Model)
                        {
                            var (icon, color) = CategoryStyle(category.Name);
                            var dispIcon  = !string.IsNullOrEmpty(category.Icon)  ? category.Icon  : icon;
                            var dispColor = !string.IsNullOrEmpty(category.ColorClass) ? category.ColorClass : color;
                            <tr>
                                <td class="ps-3 text-muted small">#@category.Id</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-@dispColor-subtle text-@dispColor border border-@dispColor-subtle fs-5 lh-1 px-2 py-1">
                                            @dispIcon
                                        </span>
                                        <span class="fw-semibold">@category.Name</span>
                                    </div>
                                </td>
                                <td class="text-muted small">
                                    @(string.IsNullOrEmpty(category.Description) ? "—" : category.Description)
                                </td>
                                <td class="text-center">
                                    @if (category.IsActive)
                                    {
                                        <span class="badge bg-success">Активна</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Неактивна</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">@category.Foods.Count</span>
                                </td>
                                <td class="text-end pe-3">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Edit" asp-route-id="@category.Id"
                                           class="btn btn-sm btn-warning">
                                            <i class="bi bi-pencil"></i> Редагувати
                                        </a>
                                        <form method="post" asp-action="Delete" asp-route-id="@category.Id" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger"
                                                    data-confirm-title="Видалити категорію"
                                                    data-confirm-message='Видалити категорію "@category.Name"? Цю дію не можна скасувати.'
                                                    data-confirm-button-text="Видалити"
                                                    data-confirm-button-class="btn-danger">
                                                <i class="bi bi-trash"></i> Видалити
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer text-muted small border-0">
                Всього категорій: <strong>@Model.Count</strong>
            </div>
        </div>
    }
</div>

