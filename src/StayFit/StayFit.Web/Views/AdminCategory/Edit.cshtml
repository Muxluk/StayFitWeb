@model EditCategoryRequest

@{
    ViewData["Title"] = "Редагувати категорію";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="d-flex align-items-center mb-3">
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary me-3">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <div>
                    <h2 class="mb-0">Редагувати категорію</h2>
                    <p class="text-muted small mb-0">Зміни застосовуються одразу</p>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-warning text-dark py-3 border-0">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-pencil-square fs-5"></i>
                        <span class="fw-semibold">Редагування категорії #@Model.Id</span>
                    </div>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">
                                <i class="bi bi-tag me-1 text-primary"></i>Назва категорії
                            </label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold">
                                <i class="bi bi-card-text me-1 text-secondary"></i>Опис
                                <span class="fw-normal text-muted">(необов'язково)</span>
                            </label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded">
                                <div>
                                    <div class="fw-semibold">Статус категорії</div>
                                    <div class="text-muted small">Неактивні категорії не відображаються в пошуку</div>
                                </div>
                                <div class="form-check form-switch mb-0 ms-3">
                                     <input type="checkbox" asp-for="IsActive" class="form-check-input sf-admin-category-switch" role="switch" />
                                    <label asp-for="IsActive" class="form-check-label visually-hidden">Активна</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Скасувати</a>
                            <button type="submit" class="btn btn-warning px-4">
                                <i class="bi bi-check-lg me-1"></i>Зберегти
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
