@model CreateCategoryRequest

@{
    ViewData["Title"] = "Нова категорія";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="d-flex align-items-center mb-3">
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary me-3">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <div>
                    <h2 class="mb-0">Нова категорія</h2>
                    <p class="text-muted small mb-0">Категорії допомагають групувати продукти харчування</p>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white py-3 border-0">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-tags fs-5"></i>
                        <span class="fw-semibold">Параметри категорії</span>
                    </div>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">
                                <i class="bi bi-tag me-1 text-primary"></i>Назва категорії
                            </label>
                            <input asp-for="Name" class="form-control" placeholder="Напр. Овочі та зелень" />
                            <div class="form-text">Назва відображатиметься у формах і пошуку продуктів</div>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-semibold">
                                <i class="bi bi-card-text me-1 text-secondary"></i>Опис
                                <span class="fw-normal text-muted">(необов'язково)</span>
                            </label>
                            <textarea asp-for="Description" class="form-control" rows="3"
                                      placeholder="Короткий опис категорії..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Скасувати</a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-plus-lg me-1"></i>Створити
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
