@model StayFit.Web.Models.AdminUserEditViewModel

@{
    ViewData["Title"] = "Редагування акаунта користувача";
}

<div class="container mt-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">Редагування акаунта користувача</h2>
        <a asp-action="Details" asp-route-userId="@Model.UserId" class="btn btn-outline-secondary">Назад до деталей</a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger" role="alert">
            <h6 class="alert-heading">Помилки валідації</h6>
            <ul class="mb-0">
                @foreach (var modelState in ViewData.ModelState.Values)
                {
                    foreach (var error in modelState.Errors)
                    {
                        <li>@error.ErrorMessage</li>
                    }
                }
            </ul>
        </div>
    }

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Отримати інформацію акаунта</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" asp-route-userId="@Model.UserId" method="post" class="needs-validation">
                        @Html.AntiForgeryToken()

                        @* Приховане поле для ID користувача *@
                        <input type="hidden" asp-for="UserId" />

                        @* Розділ: Дані входу *@
                        <div class="mb-4">
                            <h6 class="text-muted text-uppercase small mb-3">
                                <i class="bi bi-lock"></i> Дані входу
                            </h6>

                            <div class="mb-3">
                                <label asp-for="UserName" class="form-label"></label>
                                <input type="text" asp-for="UserName" class="form-control" placeholder="Введіть ім'я користувача" />
                                <span asp-validation-for="UserName" class="text-danger small"></span>
                                <small class="text-muted d-block mt-1">3-50 символів</small>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label"></label>
                                <input type="email" asp-for="Email" class="form-control" placeholder="Введіть email" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        @* Розділ: Інформація профілю *@
                        <div class="mb-4">
                            <h6 class="text-muted text-uppercase small mb-3">
                                <i class="bi bi-person"></i> Інформація профілю
                            </h6>

                            <div class="mb-3">
                                <label asp-for="FullName" class="form-label"></label>
                                <input type="text" asp-for="FullName" class="form-control" placeholder="Введіть повне ім'я (необов'язково)" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                                <small class="text-muted d-block mt-1">До 100 символів</small>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="DateOfBirth" class="form-label"></label>
                                        <input type="date" asp-for="DateOfBirth" class="form-control" />
                                        <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                                        <small class="text-muted d-block mt-1">Вік: 13-120 років</small>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="Gender" class="form-label"></label>
                                        <select asp-for="Gender" class="form-select">
                                            <option value="">-- Виберіть --</option>
                                            <option value="Чоловік">Чоловік</option>
                                            <option value="Жінка">Жінка</option>
                                            <option value="Інше">Інше</option>
                                        </select>
                                        <span asp-validation-for="Gender" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* Розділ: Фізичні параметри *@
                        <div class="mb-4">
                            <h6 class="text-muted text-uppercase small mb-3">
                                <i class="bi bi-activity"></i> Фізичні параметри
                            </h6>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="Weight" class="form-label"></label>
                                        <div class="input-group">
                                            <input type="number" asp-for="Weight" class="form-control" placeholder="0.0" step="0.1" />
                                            <span class="input-group-text">кг</span>
                                        </div>
                                        <span asp-validation-for="Weight" class="text-danger small"></span>
                                        <small class="text-muted d-block mt-1">20-300 кг</small>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="Height" class="form-label"></label>
                                        <div class="input-group">
                                            <input type="number" asp-for="Height" class="form-control" placeholder="0.0" step="0.1" />
                                            <span class="input-group-text">см</span>
                                        </div>
                                        <span asp-validation-for="Height" class="text-danger small"></span>
                                        <small class="text-muted d-block mt-1">100-250 см</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* Кнопки дій *@
                        <div class="d-grid gap-2 d-sm-flex justify-content-sm-end">
                            <a asp-action="Details" asp-route-userId="@Model.UserId" class="btn btn-outline-secondary">Скасувати</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Зберегти зміни
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm bg-light">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0">
                        <i class="bi bi-info-circle"></i> Інформація
                    </h6>
                </div>
                <div class="card-body">
                    <p class="small">
                        Цей розділ дозволяє адміністратору редагувати дані акаунта конкретного користувача.
                    </p>
                    <div class="alert alert-info small mb-0">
                        <strong>Важливо:</strong>
                        <ul class="mb-0 mt-2">
                            <li>Ім'я користувача та email обов'язкові</li>
                            <li>Email повинен бути унікальним</li>
                            <li>Дані профілю (ім'я, вага, зріст) використовуються для розрахунків фітнесу</li>
                            <li>Всі зміни логуються в системі</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mt-3">
                <div class="card-header">
                    <h6 class="mb-0">
                        <i class="bi bi-clock-history"></i> Дії адміністратора
                    </h6>
                </div>
                <div class="card-body text-center">
                    <p class="small text-muted">Користувач ID: <strong>@Model.UserId</strong></p>
                    <a asp-action="Details" asp-route-userId="@Model.UserId" class="btn btn-sm btn-outline-info w-100">
                        Повернутися до деталей
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Bootstrap form validation
            var forms = document.querySelectorAll('.needs-validation');
            Array.from(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        });
    </script>
}
