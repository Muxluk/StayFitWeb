@model StayFit.Web.Models.AdminUserEditViewModel

@{
    ViewData["Title"] = "Редагування користувача";
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-pencil-square me-2 text-primary"></i>Редагування користувача</h2>
        <a asp-action="Details" asp-route-userId="@Model.UserId" class="btn btn-light border rounded-3"><i class="bi bi-arrow-left me-2"></i>Назад до деталей</a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <form method="post" asp-action="Edit" asp-controller="AdminUser" asp-route-userId="@Model.UserId">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="UserId" />

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger border-0 rounded-3 shadow-sm mb-4">
                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            </div>
                        }

                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-4">Дані акаунта</h5>
                        <div class="row g-3 mb-5">
                            <div class="col-md-6">
                                <label asp-for="UserName" class="form-label text-muted small fw-bold">Ім'я користувача (Логін)</label>
                                <input asp-for="UserName" class="form-control rounded-3" required />
                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label text-muted small fw-bold">Електронна пошта</label>
                                <input asp-for="Email" class="form-control rounded-3" required />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-4">Особистий профіль</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <label asp-for="FullName" class="form-label text-muted small fw-bold">Повне ім'я</label>
                                <input asp-for="FullName" class="form-control rounded-3" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="DateOfBirth" class="form-label text-muted small fw-bold">Дата народження</label>
                                <input asp-for="DateOfBirth" type="date" class="form-control rounded-3" />
                                <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="Gender" class="form-label text-muted small fw-bold">Стать</label>
                                <select asp-for="Gender" class="form-select rounded-3">
                                    <option value="">Не вказано</option>
                                    <option value="Чоловіча">Чоловіча</option>
                                    <option value="Жіноча">Жіноча</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Weight" class="form-label text-muted small fw-bold">Вага (кг)</label>
                                <input asp-for="Weight" type="number" step="0.1" class="form-control rounded-3" />
                                <span asp-validation-for="Weight" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Height" class="form-label text-muted small fw-bold">Зріст (см)</label>
                                <input asp-for="Height" type="number" step="0.1" class="form-control rounded-3" />
                                <span asp-validation-for="Height" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-3 mt-5 pt-3 border-top">
                            <a asp-action="Details" asp-route-userId="@Model.UserId" class="btn btn-light border rounded-3 px-4">Скасувати</a>
                            <button type="submit" class="btn btn-primary rounded-3 px-5"><i class="bi bi-save me-2"></i>Зберегти зміни</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
