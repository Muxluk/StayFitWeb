@model StayFit.Web.Models.AdminUserDetailsViewModel

@{
    ViewData["Title"] = "Керування акаунтом";
}

<div class="container mt-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">Керування акаунтом</h2>
        <a asp-action="Index" asp-controller="AdminUser" class="btn btn-outline-secondary">Назад до списку</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var modelState in ViewData.ModelState.Values)
                {
                    foreach (var error in modelState.Errors)
                    {
                        <li>@error.ErrorMessage</li>
                    }
                }
            </ul>
        </div>
    }

    @if (Model.User == null)
    {
        <div class="alert alert-warning">Користувача не знайдено.</div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Інформація про користувача</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">ID</dt>
                            <dd class="col-sm-8">@Model.User.UserId</dd>

                            <dt class="col-sm-4">Логін</dt>
                            <dd class="col-sm-8">@Model.User.UserName</dd>

                            <dt class="col-sm-4">Email</dt>
                            <dd class="col-sm-8">@Model.User.Email</dd>

                            <dt class="col-sm-4">Статус</dt>
                            <dd class="col-sm-8">
                                @if (Model.User.IsLocked)
                                {
                                    <span class="badge bg-danger">Заблокований</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Активний</span>
                                }
                            </dd>

                            <dt class="col-sm-4">Lockout End</dt>
                            <dd class="col-sm-8">@(Model.User.LockoutEnd?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "-")</dd>

                            <dt class="col-sm-4">AccessFailed</dt>
                            <dd class="col-sm-8">@Model.User.AccessFailedCount</dd>

                            <dt class="col-sm-4">Повне ім'я</dt>
                            <dd class="col-sm-8">@(Model.User.Profile?.FullName ?? "-")</dd>

                            <dt class="col-sm-4">Дата народження</dt>
                            <dd class="col-sm-8">@(Model.User.Profile?.DateOfBirth?.ToString("dd.MM.yyyy") ?? "-")</dd>

                            <dt class="col-sm-4">Стать</dt>
                            <dd class="col-sm-8">@(Model.User.Profile?.Gender ?? "-")</dd>

                            <dt class="col-sm-4">Вага</dt>
                            <dd class="col-sm-8">@(Model.User.Profile?.Weight?.ToString("0.##") ?? "-")</dd>

                            <dt class="col-sm-4">Зріст</dt>
                            <dd class="col-sm-8">@(Model.User.Profile?.Height?.ToString("0.##") ?? "-")</dd>
                        </dl>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-danger-subtle">
                        <h5 class="mb-0">Ручне скидання пароля</h5>
                    </div>
                    <div class="card-body">
                        <form method="post" asp-action="ResetPassword" asp-controller="AdminUser" asp-route-userId="@Model.User.UserId">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label for="NewPassword" class="form-label">Новий пароль</label>
                                <input type="password" id="NewPassword" name="NewPassword" class="form-control"
                                       value="@Model.ResetPassword.NewPassword" minlength="8" required />
                            </div>

                            <div class="mb-3">
                                <label for="ConfirmPassword" class="form-label">Підтвердження пароля</label>
                                <input type="password" id="ConfirmPassword" name="ConfirmPassword" class="form-control"
                                       value="@Model.ResetPassword.ConfirmPassword" minlength="8" required />
                            </div>

                            <button type="submit" class="btn btn-danger"
                                    data-confirm-title="Скинути пароль"
                                    data-confirm-message="Скинути пароль для цього користувача?"
                                    data-confirm-button-text="Скинути"
                                    data-confirm-button-class="btn-danger">
                                Скинути пароль
                            </button>
                        </form>
                    </div>
                </div>

                <div class="card shadow-sm mt-3">
                    <div class="card-header bg-warning-subtle">
                        <h5 class="mb-0">Дії над акаунтом</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <a asp-action="Edit" asp-controller="AdminUser" asp-route-userId="@Model.User.UserId" 
                               class="btn btn-outline-primary">
                                <i class="bi bi-pencil"></i> Редагувати
                            </a>

                            @if (Model.User.IsLocked)
                            {
                                                                        <form method="post" asp-action="UnblockUser" asp-controller="AdminUser" 
                                                                            asp-route-userId="@Model.User.UserId" class="mb-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-success w-100"
                                            data-confirm-title="Розблокувати користувача"
                                            data-confirm-message="Розблокувати цього користувача?"
                                            data-confirm-button-text="Розблокувати"
                                            data-confirm-button-class="btn-success">
                                        <i class="bi bi-unlock"></i> Розблокувати
                                    </button>
                                </form>
                            }
                            else
                            {
                                  <form method="post" asp-action="BlockUser" asp-controller="AdminUser"
                                      asp-route-userId="@Model.User.UserId" class="mb-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-warning w-100"
                                            data-confirm-title="Заблокувати користувача"
                                            data-confirm-message="Заблокувати цього користувача?"
                                            data-confirm-button-text="Заблокувати"
                                            data-confirm-button-class="btn-warning">
                                        <i class="bi bi-lock"></i> Заблокувати
                                    </button>
                                </form>
                            }

                                <form method="post" asp-action="DeleteUser" asp-controller="AdminUser"
                                    asp-route-userId="@Model.User.UserId" class="mb-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger w-100"
                                        data-confirm-title="Видалити користувача"
                                        data-confirm-message="УВАГА! Видалити цього користувача? Цю дію не можна скасувати!"
                                        data-confirm-button-text="Видалити"
                                        data-confirm-button-class="btn-danger">
                                    <i class="bi bi-trash"></i> Видалити
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
