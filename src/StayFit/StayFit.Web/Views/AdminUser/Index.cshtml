@model AdminUserSearchViewModel

@{
    ViewData["Title"] = "Управління користувачами";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Управління користувачами</h2>
        <div class="text-muted">Всього в системі: <strong>@Model.Users.TotalCount</strong></div>
    </div>

    <!-- Пошук та фільтрація -->
    <div class="card sf-card mb-4">
        <div class="card-body">
            <form id="searchForm" method="get" asp-action="Index" class="row g-3">
                <div class="col-12 col-md-4">
                    <label class="form-label small text-muted">ID користувача</label>
                    <input type="text" name="userId" value="@Model.UserId" class="form-control" placeholder="Пошук за ID..." />
                </div>
                <div class="col-12 col-md-5">
                    <label class="form-label small text-muted">Email адреса</label>
                    <div class="position-relative">
                        <input type="email" id="emailSearchInput" name="email" value="@Model.Email" class="form-control" placeholder="Пошук за email..." autocomplete="off" />
                        <ul id="emailAutocompleteList" class="list-group position-absolute w-100 shadow-lg d-none" style="z-index: 1000; top: 100%;"></ul>
                    </div>
                </div>
                <div class="col-12 col-md-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="bi bi-search me-2"></i>Пошук
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Скинути">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Таблиця користувачів -->
    <div class="card sf-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Користувач</th>
                            <th class="d-none d-lg-table-cell">Статус</th>
                            <th class="text-end pe-4">Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users.Items)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-light rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                            <i class="bi bi-person text-secondary"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold">@user.Email</div>
                                            <div class="small text-muted font-monospace">@user.UserId</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="d-none d-lg-table-cell">
                                    @if (!user.IsLocked)
                                    {
                                        <span class="badge bg-success-subtle text-success">Активний</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger">Заблокований</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-userId="@user.UserId" class="btn btn-outline-primary d-flex align-items-center gap-1" title="Деталі">
                                            <i class="bi bi-info-circle"></i>
                                            <span>Деталі</span>
                                        </a>
                                        <button type="button" class="btn btn-outline-secondary" title="Логи безпеки">
                                            <i class="bi bi-shield-check"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Пагінація -->
    @if (Model.Users.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center gap-2">
                <li class="page-item @(Model.Users.PageNumber == 1 ? "disabled" : "")">
                    <a class="page-link border-0 rounded-circle text-dark shadow-sm fs-5" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; line-height: 1;" asp-action="Index" asp-route-page="@(Model.Users.PageNumber - 1)" asp-route-userId="@Model.UserId" asp-route-email="@Model.Email">
                        &laquo;
                    </a>
                </li>

                @{
                    int start = Math.Max(1, Model.Users.PageNumber - 2);
                    int end = Math.Min(Model.Users.TotalPages, start + 4);
                    if (end - start < 4) start = Math.Max(1, end - 4);
                }

                @for (int i = start; i <= end; i++)
                {
                    <li class="page-item @(i == Model.Users.PageNumber ? "active" : "")">
                        <a class="page-link border-0 rounded-circle @(i == Model.Users.PageNumber ? "bg-primary text-white shadow" : "text-dark shadow-sm")" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;" asp-action="Index" asp-route-page="@i" asp-route-userId="@Model.UserId" asp-route-email="@Model.Email">@i</a>
                    </li>
                }

                <li class="page-item @(Model.Users.PageNumber == Model.Users.TotalPages ? "disabled" : "")">
                    <a class="page-link border-0 rounded-circle text-dark shadow-sm fs-5" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; line-height: 1;" asp-action="Index" asp-route-page="@(Model.Users.PageNumber + 1)" asp-route-userId="@Model.UserId" asp-route-email="@Model.Email">
                        &raquo;
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>

@section Scripts {
}