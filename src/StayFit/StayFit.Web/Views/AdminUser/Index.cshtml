@model StayFit.Web.Models.AdminUserSearchViewModel

@{
    ViewData["Title"] = "Керування користувачами";
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-people me-2 text-primary"></i>Керування користувачами</h2>
    </div>

    <!-- Фільтри -->
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body p-4">
            <form method="get" asp-action="Index" asp-controller="AdminUser" class="row g-3 align-items-end" id="searchForm">
                <div class="col-md-3">
                    <label asp-for="UserId" class="form-label text-muted small fw-bold">ID Користувача</label>
                    <input asp-for="UserId" class="form-control rounded-3" placeholder="Напр. 12" />
                </div>

                <div class="col-md-5 position-relative">
                    <label asp-for="Email" class="form-label text-muted small fw-bold">Електронна пошта</label>
                    <input asp-for="Email" class="form-control rounded-3" id="emailSearchInput" placeholder="Пошук за email..." autocomplete="off" />
                    <!-- Autocomplete dropdown placeholder -->
                    <ul class="list-group position-absolute w-100 mt-1 shadow-sm d-none z-3" id="emailAutocompleteList" style="max-height: 200px; overflow-y: auto;"></ul>
                </div>

                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary rounded-3 px-4"><i class="bi bi-search me-2"></i>Знайти</button>
                    <a asp-action="Index" asp-controller="AdminUser" class="btn btn-light rounded-3 px-4 border">Скинути</a>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Таблиця -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-4 py-3">Користувач</th>
                        <th class="py-3">Email</th>
                        <th class="py-3">Статус</th>
                        <th class="py-3">Блокування до</th>
                        <th class="text-end pe-4 py-3">Дії</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (!Model.Users.Items.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Немає результатів
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in Model.Users.Items)
                        {
                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary-subtle text-primary rounded-circle d-flex justify-content-center align-items-center me-3 fw-bold" style="width: 40px; height: 40px;">
                                            @(string.IsNullOrEmpty(user.UserName) ? "?" : user.UserName.Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@user.UserName</div>
                                            <div class="text-muted small">ID: @user.UserId</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@user.Email</td>
                                <td>
                                    @if (user.IsLocked)
                                    {
                                        <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill"><i class="bi bi-lock-fill me-1"></i> Заблокований</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i> Активний</span>
                                    }
                                </td>
                                <td class="text-muted">
                                    @(user.LockoutEnd?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—")
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-action="Details" asp-controller="AdminUser" asp-route-userId="@user.UserId" class="btn btn-sm btn-outline-primary rounded-3 px-3">
                                            <i class="bi bi-eye me-1"></i> Деталі
                                        </a>

                                        @if (user.IsLocked)
                                        {
                                            <form method="post" asp-action="UnblockUser" asp-controller="AdminUser" asp-route-userId="@user.UserId" class="m-0">
                                                <button type="submit" class="btn btn-sm btn-success rounded-3 px-3" title="Розблокувати">
                                                    <i class="bi bi-unlock-fill me-1"></i> Розблокувати
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form method="post" asp-action="BlockUser" asp-controller="AdminUser" asp-route-userId="@user.UserId" class="m-0">
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-3 px-3" title="Заблокувати" onclick="return confirm('Ви впевнені, що хочете заблокувати користувача?')">
                                                    <i class="bi bi-slash-circle me-1"></i> Заблокувати
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Пагінація -->
    @if (Model.Users.TotalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination justify-content-center gap-2">
                <li class="page-item @(Model.Users.PageNumber == 1 ? "disabled" : "")">
                    <a class="page-link border-0 rounded-circle text-dark shadow-sm fs-5" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; line-height: 1;" asp-action="Index" asp-route-page="@(Model.Users.PageNumber - 1)" asp-route-userId="@Model.UserId" asp-route-email="@Model.Email">
                        &laquo;
                    </a>
                </li>
                
                @for (int i = 1; i <= Model.Users.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Users.PageNumber ? "active" : "")">
                        <a class="page-link border-0 rounded-circle @(i == Model.Users.PageNumber ? "bg-primary text-white shadow" : "text-dark shadow-sm")" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;" asp-action="Index" asp-route-page="@i" asp-route-userId="@Model.UserId" asp-route-email="@Model.Email">@i</a>
                    </li>
                }

                <li class="page-item @(Model.Users.PageNumber == Model.Users.TotalPages ? "disabled" : "")">
                    <a class="page-link border-0 rounded-circle text-dark shadow-sm fs-5" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; line-height: 1;" asp-action="Index" asp-route-page="@(Model.Users.PageNumber + 1)" asp-route-userId="@Model.UserId" asp-route-email="@Model.Email">
                        &raquo;
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            let timeout = null;
            const emailInput = document.getElementById('emailSearchInput');
            const autocompleteList = document.getElementById('emailAutocompleteList');
            const searchForm = document.getElementById('searchForm');
            
            // Hide autocomplete list when clicking outside
            document.addEventListener('click', function(e) {
                if (e.target !== emailInput && e.target !== autocompleteList) {
                    autocompleteList.classList.add('d-none');
                }
            });

            emailInput.addEventListener('input', function() {
                clearTimeout(timeout);
                const query = emailInput.value.trim();
                
                if (query.length < 2) {
                    autocompleteList.classList.add('d-none');
                    autocompleteList.innerHTML = '';
                    
                    if (query.length === 0) {
                        // Optional: auto-submit if cleared completely
                        timeout = setTimeout(() => searchForm.submit(), 800);
                    }
                    return;
                }

                timeout = setTimeout(() => {
                    fetch(`/admin/users/autocomplete?q=${encodeURIComponent(query)}`)
                        .then(response => response.json())
                        .then(data => {
                            autocompleteList.innerHTML = '';
                            
                            if (data && data.length > 0) {
                                data.forEach(email => {
                                    const li = document.createElement('li');
                                    li.className = 'list-group-item list-group-item-action cursor-pointer';
                                    li.textContent = email;
                                    li.style.cursor = 'pointer';
                                    
                                    li.addEventListener('click', function() {
                                        emailInput.value = email;
                                        autocompleteList.classList.add('d-none');
                                        searchForm.submit();
                                    });
                                    
                                    autocompleteList.appendChild(li);
                                });
                                autocompleteList.classList.remove('d-none');
                            } else {
                                autocompleteList.classList.add('d-none');
                            }
                        })
                        .catch(err => console.error('Autocomplete error:', err));
                }, 300); // 300ms debounce for typing
            });
        });
    </script>
}