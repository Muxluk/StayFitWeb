@model StayFit.Application.DTOs.DashboardDto
@{
    ViewData["Title"] = "Дашборд";
}

<div class="container mt-4">
    <h2 class="mb-4">Дашборд</h2>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <p>@error.ErrorMessage</p>
            }
        </div>
    }

    @if (Model != null)
    {
        @* ── КБЖВ картки (4 cols ≥md, 2 cols xs/sm) ── *@
        <div class="sf-macro-grid mb-4">

            @* Калорії *@
            <div>
                <div class="card sf-card">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="sf-card-label">Калорії</span>
                        </div>
                        <div class="d-flex align-items-baseline gap-1">
                            <span class="sf-card-value">@Model.ActualCalories.ToString("F0")</span>
                            <span class="text-muted small">/ @Model.TargetCalories.ToString("F0") ккал</span>
                        </div>
                        @await Html.PartialAsync("_ProgressBar", null, new ViewDataDictionary(ViewData)
                        {
                            ["Actual"] = (double)Model.ActualCalories,
                            ["Target"] = (double)Model.TargetCalories
                        })
                    </div>
                </div>
            </div>

            @* Білки *@
            <div>
                <div class="card sf-card">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="sf-card-label">Білки</span>
                        </div>
                        <div class="d-flex align-items-baseline gap-1">
                            <span class="sf-card-value">@Model.ActualProtein.ToString("F1")</span>
                            <span class="text-muted small">/ @Model.TargetProtein.ToString("F0") г</span>
                        </div>
                        @await Html.PartialAsync("_ProgressBar", null, new ViewDataDictionary(ViewData)
                        {
                            ["Actual"] = (double)Model.ActualProtein,
                            ["Target"] = (double)Model.TargetProtein,
                            ["Color"]  = "info"
                        })
                    </div>
                </div>
            </div>

            @* Жири *@
            <div>
                <div class="card sf-card">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="sf-card-label">Жири</span>
                        </div>
                        <div class="d-flex align-items-baseline gap-1">
                            <span class="sf-card-value">@Model.ActualFat.ToString("F1")</span>
                            <span class="text-muted small">/ @Model.TargetFat.ToString("F0") г</span>
                        </div>
                        @await Html.PartialAsync("_ProgressBar", null, new ViewDataDictionary(ViewData)
                        {
                            ["Actual"] = (double)Model.ActualFat,
                            ["Target"] = (double)Model.TargetFat,
                            ["Color"]  = "warning"
                        })
                    </div>
                </div>
            </div>

            @* Вуглеводи *@
            <div>
                <div class="card sf-card">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="sf-card-label">Вуглеводи</span>
                        </div>
                        <div class="d-flex align-items-baseline gap-1">
                            <span class="sf-card-value">@Model.ActualCarbs.ToString("F1")</span>
                            <span class="text-muted small">/ @Model.TargetCarbs.ToString("F0") г</span>
                        </div>
                        @await Html.PartialAsync("_ProgressBar", null, new ViewDataDictionary(ViewData)
                        {
                            ["Actual"] = (double)Model.ActualCarbs,
                            ["Target"] = (double)Model.TargetCarbs,
                            ["Color"]  = "primary"
                        })
                    </div>
                </div>
            </div>
        </div>

        @* ── Картка водного балансу ── *@
        <div class="row mb-4">
            <div class="col-12 col-md-6">
                <div class="card sf-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="sf-card-label">Водний баланс</span>
                                </div>
                                <div class="d-flex align-items-baseline gap-1">
                                    <span class="sf-card-value" id="waterIntake">0</span>
                                    <span class="text-muted small">/ <span id="waterGoal">8</span> склянок</span>
                                </div>
                                <div id="waterDrops" class="sf-water-drops mt-2"></div>
                            </div>
                            <button class="btn btn-sm btn-outline-secondary" id="waterResetBtn" title="Скинути">↺</button>
                        </div>
                        @await Html.PartialAsync("_ProgressBar", null, new ViewDataDictionary(ViewData)
                        {
                            ["Actual"] = 0.0,
                            ["Target"] = 8.0,
                            ["Color"]  = "info",
                            ["ShowLabel"] = false
                        })
                        <small class="text-muted d-block mt-1">Натисніть крапельку щоб відзначити склянку</small>
                    </div>
                </div>
            </div>
        </div>

        @* ── Останні записи щоденника ── *@
        @if (Model.RecentDiaryEntries.Any())
        {
            <div class="card sf-card mb-4">
                <div class="card-body">
                    <h5 class="card-title mb-3">Останні записи</h5>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Продукт</th>
                                    <th class="text-end">г</th>
                                    <th class="text-end">ккал</th>
                                    <th class="text-end d-none d-sm-table-cell">Б</th>
                                    <th class="text-end d-none d-sm-table-cell">Ж</th>
                                    <th class="text-end d-none d-sm-table-cell">В</th>
                                    <th class="text-end text-muted">Час</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in Model.RecentDiaryEntries)
                                {
                                    <tr>
                                        <td>@entry.FoodName</td>
                                        <td class="text-end">@entry.AmountGrams.ToString("F0")</td>
                                        <td class="text-end fw-semibold">@entry.Calories.ToString("F0")</td>
                                        <td class="text-end d-none d-sm-table-cell text-info">@entry.Protein.ToString("F1")</td>
                                        <td class="text-end d-none d-sm-table-cell text-warning">@entry.Fat.ToString("F1")</td>
                                        <td class="text-end d-none d-sm-table-cell text-primary">@entry.Carbs.ToString("F1")</td>
                                        <td class="text-end text-muted small">@entry.LoggedAt.ToLocalTime().ToString("HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info">
            <strong>Цілі харчування не встановлені.</strong>
            <a asp-controller="NutritionGoal" asp-action="Index" class="alert-link">Встановити цілі →</a>
        </div>
    }
</div>

@section Scripts {
}

