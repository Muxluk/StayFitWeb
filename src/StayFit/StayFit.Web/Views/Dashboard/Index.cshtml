@model StayFit.Application.DTOs.DashboardDto
@{
    ViewData["Title"] = "Дашборд";
}

<div class="container mt-4">
    <h2>📊 Дашборд</h2>
    
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <p>@error.ErrorMessage</p>
            }
        </div>
    }

    @if (Model != null)
    {
        <div class="row mt-4">
            <!-- 1. Калорії -->
            <div class="col-md-4 mb-4">
                <div class="card h-100 card-elevated">
                    <div class="card-body">
                        <h5 class="card-title text-primary">🔥 Калорії</h5>
                        <hr />
                        <p class="mb-1"><strong>Спожито:</strong> @Model.ActualCalories.ToString("F1") ккал</p>
                        <p class="mb-1"><strong>Ціль:</strong> @Model.TargetCalories.ToString("F1") ккал</p>
                        @await Html.PartialAsync("_ProgressBar", new ProgressBarViewModel
                        {
                            Value = (decimal)Model.ActualCalories,
                            Max = (decimal)Model.TargetCalories,
                            ColorClass = "bg-primary",
                            ProgressClass = "progress-sm",
                            BarClass = "progress-bar-animated-width",
                            ContainerClass = "mt-2"
                        })
                    </div>
                </div>
            </div>

            <!-- 2. Білки -->
            <div class="col-md-4 mb-4">
                <div class="card h-100 card-elevated">
                    <div class="card-body">
                        <h5 class="card-title text-success">💪 Білки</h5>
                        <hr />
                        <p class="mb-1">@Model.ActualProtein.ToString("F1") / @Model.TargetProtein.ToString("F1") г</p>
                        @await Html.PartialAsync("_ProgressBar", new ProgressBarViewModel
                        {
                            Value = (decimal)Model.ActualProtein,
                            Max = (decimal)Model.TargetProtein,
                            ColorClass = "bg-success",
                            ProgressClass = "progress-sm",
                            BarClass = "progress-bar-animated-width",
                            ContainerClass = "mt-2"
                        })
                    </div>
                </div>
            </div>

            <!-- 3. Жири -->
            <div class="col-md-4 mb-4">
                <div class="card h-100 card-elevated">
                    <div class="card-body">
                        <h5 class="card-title text-warning">🧈 Жири</h5>
                        <hr />
                        <p class="mb-1">@Model.ActualFat.ToString("F1") / @Model.TargetFat.ToString("F1") г</p>
                        @await Html.PartialAsync("_ProgressBar", new ProgressBarViewModel
                        {
                            Value = (decimal)Model.ActualFat,
                            Max = (decimal)Model.TargetFat,
                            ColorClass = "bg-warning",
                            ProgressClass = "progress-sm",
                            BarClass = "progress-bar-animated-width",
                            ContainerClass = "mt-2"
                        })
                    </div>
                </div>
            </div>

            <!-- 4. Вуглеводи -->
            <div class="col-md-4 mb-4">
                <div class="card h-100 card-elevated">
                    <div class="card-body">
                        <h5 class="card-title text-danger">🍞 Вуглеводи</h5>
                        <hr />
                        <p class="mb-1">@Model.ActualCarbs.ToString("F1") / @Model.TargetCarbs.ToString("F1") г</p>
                        @await Html.PartialAsync("_ProgressBar", new ProgressBarViewModel
                        {
                            Value = (decimal)Model.ActualCarbs,
                            Max = (decimal)Model.TargetCarbs,
                            ColorClass = "bg-danger",
                            ProgressClass = "progress-sm",
                            BarClass = "progress-bar-animated-width",
                            ContainerClass = "mt-2"
                        })
                    </div>
                </div>
            </div>

            <!-- 5. ВОДА (Тепер займає 1/3 ряду, як і інші) -->
            <div class="col-md-4 mb-4">
                <div class="card bg-info text-white h-100 shadow-sm border-0 card-elevated">
                    <div class="card-body d-flex flex-column text-center justify-content-center p-3">
                        <h5 class="card-title fw-bold mb-2">
                            <i class="bi bi-droplet-fill"></i> Вода
                        </h5>
                        
                        <h3 class="fw-bold mb-0">
                            @ViewBag.WaterProgress.ConsumedMl 
                            <small class="fs-6 text-light">/ @ViewBag.WaterProgress.DailyGoalMl мл</small>
                        </h3>
                        
                        @await Html.PartialAsync("_ProgressBar", new ProgressBarViewModel
                        {
                            Value = (decimal)ViewBag.WaterProgress.Percentage,
                            Max = 100m,
                            ColorClass = "bg-white",
                            ProgressClass = "progress-xs",
                            TrackClass = "progress-track-soft",
                            BarClass = "progress-bar-animated-width",
                            ContainerClass = "mt-2 mb-3",
                            ShowPercentText = false
                        })

                        <a asp-controller="Hydration" asp-action="Index" class="btn btn-sm btn-light text-info fw-bold mt-auto rounded-pill">
                            <i class="bi bi-plus-circle"></i> Логувати воду
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

