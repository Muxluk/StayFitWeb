@{
    ViewData["Title"] = "Додати їжу до щоденника";
    var selectedFood = ViewBag.SelectedFood as StayFit.Domain.Entities.Food;
}

<div class="container mt-4">
    <div class="d-flex align-items-center gap-2 mb-4">
        <a asp-action="Index" asp-controller="Diary" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h2 class="mb-0">Додати їжу до щоденника</h2>
    </div>

    <div class="row g-4">
        <!-- LEFT: search -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    <h5 class="card-title mb-0"><i class="bi bi-search me-2 text-primary"></i>Пошук продукту</h5>
                </div>
                <div class="card-body d-flex flex-column gap-3">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" id="sf-atl-search" class="form-control" placeholder="Введіть назву продукту…" autocomplete="off" />
                    </div>
                    <div id="sf-atl-results" class="list-group overflow-auto" style="max-height:400px;">
                        <div class="text-muted small text-center py-4" id="sf-atl-hint">
                            <i class="bi bi-arrow-up-circle fs-4 d-block mb-2 opacity-25"></i>
                            Введіть мінімум 2 символи для пошуку
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT: selected product + form -->
        <div class="col-lg-6">
            <div class="card shadow-sm" id="sf-atl-form-card">
                <div class="card-header">
                    <h5 class="card-title mb-0"><i class="bi bi-plus-circle me-2 text-success"></i>Додати до щоденника</h5>
                </div>
                <div class="card-body">

                    @* No food selected state *@
                    <div id="sf-atl-no-selection" class="@(selectedFood == null ? "" : "d-none") text-muted text-center py-5">
                        <i class="bi bi-hand-index fs-1 opacity-25 d-block mb-2"></i>
                        Оберіть продукт зі списку ліворуч
                    </div>

                    @* Form (hidden until food selected) *@
                    <div id="sf-atl-form-container" class="@(selectedFood == null ? "d-none" : "")">
                        <form asp-action="AddToLog" asp-controller="Food" method="post" id="sf-atl-form">
                            @Html.AntiForgeryToken()

                            <input type="hidden" name="foodId" id="sf-atl-foodId"
                                   value="@(selectedFood?.Id)" />

                            <!-- Product summary card -->
                            <div class="bg-light rounded p-3 mb-3">
                                <h6 class="fw-bold mb-1" id="sf-atl-name">@(selectedFood?.Name ?? "")</h6>
                                <small class="text-muted" id="sf-atl-category">
                                    @(selectedFood?.Category.ToString() ?? "")
                                </small>
                                <div class="row g-2 mt-2">
                                    <div class="col-3 text-center">
                                        <div class="fw-bold text-primary" id="sf-atl-kcal">@(selectedFood?.CaloriesPer100g.ToString("0") ?? "—")</div>
                                        <small class="text-muted">ккал</small>
                                    </div>
                                    <div class="col-3 text-center">
                                        <div class="fw-bold text-success" id="sf-atl-protein">@(selectedFood?.ProteinPer100g.ToString("0.0") ?? "—")</div>
                                        <small class="text-muted">білки г</small>
                                    </div>
                                    <div class="col-3 text-center">
                                        <div class="fw-bold text-warning" id="sf-atl-fat">@(selectedFood?.FatPer100g.ToString("0.0") ?? "—")</div>
                                        <small class="text-muted">жири г</small>
                                    </div>
                                    <div class="col-3 text-center">
                                        <div class="fw-bold text-info" id="sf-atl-carbs">@(selectedFood?.CarbsPer100g.ToString("0.0") ?? "—")</div>
                                        <small class="text-muted">вугл. г</small>
                                    </div>
                                </div>
                                <div class="text-muted text-end" style="font-size:.75rem">на 100 г</div>
                            </div>

                            <!-- Quantity with live recalc -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold" for="sf-atl-qty">
                                    <i class="bi bi-scale me-1"></i>Кількість (г)
                                </label>
                                <div class="input-group">
                                    <input type="number" name="quantity" id="sf-atl-qty"
                                           class="form-control" value="100" min="1" max="5000" step="1" required />
                                    <span class="input-group-text">г</span>
                                </div>
                            </div>

                            <!-- Live KBZV preview -->
                            <div class="border rounded p-2 mb-3 bg-white">
                                <div class="text-muted small mb-1">Загалом для вказаної кількості:</div>
                                <div class="row g-1 text-center">
                                    <div class="col-3">
                                        <div class="fw-bold text-primary fs-6" id="sf-atl-calc-kcal">—</div>
                                        <small class="text-muted" style="font-size:.7rem">ккал</small>
                                    </div>
                                    <div class="col-3">
                                        <div class="fw-bold text-success fs-6" id="sf-atl-calc-protein">—</div>
                                        <small class="text-muted" style="font-size:.7rem">білки г</small>
                                    </div>
                                    <div class="col-3">
                                        <div class="fw-bold text-warning fs-6" id="sf-atl-calc-fat">—</div>
                                        <small class="text-muted" style="font-size:.7rem">жири г</small>
                                    </div>
                                    <div class="col-3">
                                        <div class="fw-bold text-info fs-6" id="sf-atl-calc-carbs">—</div>
                                        <small class="text-muted" style="font-size:.7rem">вугл. г</small>
                                    </div>
                                </div>
                            </div>

                            <!-- Meal type -->
                            <div class="mb-4">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-clock me-1"></i>Прийом їжі
                                </label>
                                <div class="d-flex flex-wrap gap-2">
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="mealType"
                                               id="meal-breakfast" value="breakfast" checked />
                                        <label class="form-check-label" for="meal-breakfast">🌅 Сніданок</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="mealType"
                                               id="meal-lunch" value="lunch" />
                                        <label class="form-check-label" for="meal-lunch">☀️ Обід</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="mealType"
                                               id="meal-dinner" value="dinner" />
                                        <label class="form-check-label" for="meal-dinner">🌙 Вечеря</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="mealType"
                                               id="meal-snack" value="snack" />
                                        <label class="form-check-label" for="meal-snack">🥜 Перекус</label>
                                    </div>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-success w-100" id="sf-atl-submit">
                                <i class="bi bi-plus-circle me-2"></i>Додати до щоденника
                            </button>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    // Per-100g values set when food is selected
    var per100 = {
        kcal: @(selectedFood?.CaloriesPer100g ?? 0),
        protein: @(selectedFood?.ProteinPer100g ?? 0),
        fat: @(selectedFood?.FatPer100g ?? 0),
        carbs: @(selectedFood?.CarbsPer100g ?? 0)
    };

    var searchEl   = document.getElementById('sf-atl-search');
    var resultsEl  = document.getElementById('sf-atl-results');
    var hintEl     = document.getElementById('sf-atl-hint');
    var noSelEl    = document.getElementById('sf-atl-no-selection');
    var formConEl  = document.getElementById('sf-atl-form-container');
    var qtyEl      = document.getElementById('sf-atl-qty');
    var searchTimer;

    function recalc() {
        var qty = parseFloat(qtyEl?.value) || 0;
        var factor = qty / 100;
        var fields = [
            ['sf-atl-calc-kcal',    per100.kcal   * factor, 0],
            ['sf-atl-calc-protein', per100.protein * factor, 1],
            ['sf-atl-calc-fat',     per100.fat     * factor, 1],
            ['sf-atl-calc-carbs',   per100.carbs   * factor, 1]
        ];
        fields.forEach(function(f) {
            var el = document.getElementById(f[0]);
            if (el) el.textContent = f[1].toFixed(f[2]);
        });
    }

    // Trigger initial recalc if food is pre-selected
    if (@(selectedFood != null ? "true" : "false")) {
        recalc();
    }

    if (qtyEl) qtyEl.addEventListener('input', recalc);

    function selectFood(food) {
        per100 = { kcal: food.caloriesPer100g, protein: food.proteinPer100g, fat: food.fatPer100g, carbs: food.carbsPer100g };
        document.getElementById('sf-atl-foodId').value   = food.id;
        document.getElementById('sf-atl-name').textContent = food.name;
        document.getElementById('sf-atl-category').textContent = food.category ?? '';
        document.getElementById('sf-atl-kcal').textContent    = Math.round(food.caloriesPer100g);
        document.getElementById('sf-atl-protein').textContent = food.proteinPer100g.toFixed(1);
        document.getElementById('sf-atl-fat').textContent     = food.fatPer100g.toFixed(1);
        document.getElementById('sf-atl-carbs').textContent   = food.carbsPer100g.toFixed(1);
        noSelEl.classList.add('d-none');
        formConEl.classList.remove('d-none');
        if (qtyEl) { qtyEl.value = 100; recalc(); }
    }

    function renderResults(items) {
        resultsEl.innerHTML = '';
        if (!items || items.length === 0) {
            resultsEl.innerHTML = '<div class="text-muted small text-center py-3">Нічого не знайдено</div>';
            return;
        }
        items.forEach(function (f) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-center';
            btn.innerHTML =
                '<div>' +
                  '<div class="fw-semibold">' + escHtml(f.name) + '</div>' +
                  '<small class="text-muted">' + Math.round(f.caloriesPer100g) + ' ккал / 100г</small>' +
                '</div>' +
                '<span class="badge bg-primary-subtle text-primary rounded-pill">' +
                  escHtml(f.category ?? '') +
                '</span>';
            btn.addEventListener('click', function () {
                selectFood(f);
                resultsEl.querySelectorAll('.list-group-item').forEach(function(el){ el.classList.remove('active'); });
                btn.classList.add('active');
            });
            resultsEl.appendChild(btn);
        });
    }

    function escHtml(str) {
        return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    if (searchEl) {
        searchEl.addEventListener('input', function () {
            clearTimeout(searchTimer);
            var q = searchEl.value.trim();
            if (q.length < 2) {
                resultsEl.innerHTML = '';
                if (hintEl) resultsEl.appendChild(hintEl);
                return;
            }
            searchTimer = setTimeout(function () {
                fetch('/Food/SearchJson?q=' + encodeURIComponent(q))
                    .then(function(r){ return r.json(); })
                    .then(renderResults)
                    .catch(function(){ resultsEl.innerHTML = '<div class="text-danger small text-center py-3">Помилка пошуку</div>'; });
            }, 300);
        });
    }
})();
</script>
