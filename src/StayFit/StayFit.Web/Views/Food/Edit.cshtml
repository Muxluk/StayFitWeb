@model StayFit.Domain.Entities.Food

@{
    ViewData["Title"] = "Редагувати продукт";
}

<div class="container mt-4">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
            <i class="bi bi-arrow-left"></i> Назад
        </a>
        <h2 class="mb-0">Редагувати продукт</h2>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-md-9 col-lg-7">
            <div class="card sf-card">
                <div class="card-body">
                    <form asp-action="Edit" asp-route-id="@Model.Id">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="OwnerUserId" />
                        <input type="hidden" asp-for="CreatedByEmail" />
                        <input type="hidden" asp-for="IsApproved" />
                        @await Html.PartialAsync("_FoodFormFields", Model)
                        <div class="d-grid gap-2 d-sm-flex mt-2">
                            <button type="submit" class="btn btn-primary btn-lg flex-grow-1">Зберегти зміни</button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Скасувати</a>
                        </div>
                    </form>
                </div>
            </div>
            @if (!Model.IsApproved)
            {
                <div class="alert alert-warning mt-3">
                    <small>Продукт на модерації. Після збереження змін продукт знову потрапить на перевірку.</small>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/food-form.js" asp-append-version="true"></script>
}
