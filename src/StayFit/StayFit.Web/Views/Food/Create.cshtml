@model StayFit.Domain.Entities.Food

@{
    ViewData["Title"] = "Додати продукт";
}

<div class="container mt-4">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
            <i class="bi bi-arrow-left"></i> Назад
        </a>
        <h2 class="mb-0">Додати продукт</h2>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-md-9 col-lg-7">
            <div class="card sf-card">
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        @await Html.PartialAsync("_FoodFormFields", Model)
                        <div class="d-grid gap-2 d-sm-flex mt-2">
                            <button type="submit" class="btn btn-primary btn-lg flex-grow-1">Додати продукт</button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Скасувати</a>
                        </div>
                    </form>
                </div>
            </div>
            <div class="alert alert-info mt-3">
                <small>Після додавання продукт перейде на модерацію адміністратора.</small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
