@model IEnumerable<StayFit.Domain.Entities.Food>

@{
    ViewData["Title"] = "Список продуктів";
}

<h1>Продукти харчування</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Додати новий продукт</a>
</p>

<table class="table table-striped">
    <thead>
    <tr>
        <th>Назва</th>
        <th>Калорії (на 100г)</th>
        <th>Білки</th>
        <th>Жири</th>
        <th>Вуглеводи</th>
        <th>Додано користувачем</th> <th>Дії</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.CaloriesPer100g</td>
            <td>@item.ProteinPer100g</td>
            <td>@item.FatPer100g</td>
            <td>@item.CarbsPer100g</td>
            <td>@(string.IsNullOrEmpty(item.CreatedByEmail) ? "Система" : item.CreatedByEmail)</td> <td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Редагувати</a>
                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Ви впевнені, що хочете видалити цей продукт?');">
                    <button type="submit" class="btn btn-sm btn-danger">Видалити</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
