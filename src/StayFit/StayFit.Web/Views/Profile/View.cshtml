@model StayFit.Application.DTOs.UserProfileDto

@{
    ViewData["Title"] = "Мій профіль";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0"><i class="bi bi-person-fill me-1"></i> Мій профіль</h3>
                </div>
                <div class="card-body">
                    @if (Model == null)
                    {
                        <div class="alert alert-warning" role="alert">
                            <i class="bi bi-info-circle"></i> Профіль не знайдено. <a href="@Url.Action("Edit", "Profile")">Створити профіль</a>
                        </div>
                    }
                    else
                    {
                        var profile = Model!;
                        <div class="row">
                            <div class="col-12 mb-4">
                                <h6 class="text-muted small">Фото профілю</h6>
                                @if (!string.IsNullOrWhiteSpace(profile.ProfilePhotoPath))
                                {
                                    <img src="@profile.ProfilePhotoPath" alt="Фото профілю" class="img-thumbnail shadow-sm image-cover-260" />
                                }
                                else
                                {
                                    <div class="text-muted">Фото ще не завантажено.</div>
                                }
                            </div>

                            <div class="col-md-6 mb-3">
                                <h6 class="text-muted small">Ім'я</h6>
                                <p class="fs-5 fw-bold">@profile.FullName</p>
                            </div>

                            <div class="col-md-6 mb-3">
                                <h6 class="text-muted small">Стать</h6>
                                <p class="fs-5">
                                    @if (!string.IsNullOrWhiteSpace(profile.Gender))
                                    {
                                        @profile.Gender
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </p>
                            </div>

                            <div class="col-md-6 mb-3">
                                <h6 class="text-muted small">Вага</h6>
                                <p class="fs-5">
                                    @if (profile.Weight.HasValue)
                                    {
                                        @profile.Weight.Value.ToString("F1") <span class="text-muted text-size-09">кг</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </p>
                            </div>

                            <div class="col-md-6 mb-3">
                                <h6 class="text-muted small">Зріст</h6>
                                <p class="fs-5">
                                    @if (profile.Height.HasValue)
                                    {
                                        @profile.Height.Value.ToString("F0") <span class="text-muted text-size-09">см</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </p>
                            </div>

                            <div class="col-md-6 mb-3">
                                <h6 class="text-muted small">Дата народження</h6>
                                <p class="fs-5">
                                    @if (profile.DateOfBirth.HasValue)
                                    {
                                        @profile.DateOfBirth.Value.ToString("dd.MM.yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </p>
                            </div>
                        </div>

                        <hr class="my-4">

                        <div class="row text-muted small mb-3">
                            <div class="col-md-6">
                                <strong>Дата створення:</strong> @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                            </div>
                            <div class="col-md-6 text-end">
                                <strong>Останнє оновлення:</strong> @Model.UpdatedAt.ToString("dd.MM.yyyy HH:mm")
                            </div>
                        </div>

                        <hr class="my-4">

                        <div class="d-flex gap-2">
                            <a href="@Url.Action("Edit", "Profile")" class="btn btn-primary btn-lg">
                                <i class="bi bi-pencil-square"></i> Редагувати
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
