@model StayFit.Application.DTOs.CreateUserProfileDto

@{
    ViewData["Title"] = "Створення профілю";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h3>Створення профілю</h3>
                </div>
                <div class="card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger" role="alert">
                            <h5>Помилки у формі:</h5>
                            <ul>
                                @foreach (var modelState in ViewData.ModelState.Values)
                                {
                                    @foreach (var error in modelState.Errors)
                                    {
                                        <li>@error.ErrorMessage</li>
                                    }
                                }
                            </ul>
                        </div>
                    }

                    <form method="post" action="@Url.Action("EditProfile", "Profile")">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="userId" value="@Model?.UserId">

                        <div class="mb-3">
                            <label for="FullName" class="form-label">Повне ім'я <span class="text-danger">*</span></label>
                            <input type="text" class="form-control @(ViewData.ModelState["FullName"]?.Errors.Count > 0 ? "is-invalid" : "")" 
                                   id="FullName" name="FullName" value="@(Model?.FullName ?? "")" placeholder="Введіть Ваше повне ім'я" required>
                            @if (ViewData.ModelState["FullName"]?.Errors.Count > 0)
                            {
                                <div class="invalid-feedback d-block">
                                    @foreach (var error in ViewData.ModelState["FullName"]!.Errors)
                                    {
                                        <span>@error.ErrorMessage</span>
                                    }
                                </div>
                            }
                        </div>

                        <div class="mb-3">
                            <label for="DateOfBirth" class="form-label">Дата народження</label>
                            <input type="date" class="form-control @(ViewData.ModelState["DateOfBirth"]?.Errors.Count > 0 ? "is-invalid" : "")" 
                                   id="DateOfBirth" name="DateOfBirth" value="@(Model?.DateOfBirth?.ToString("yyyy-MM-dd") ?? "")">
                            @if (ViewData.ModelState["DateOfBirth"]?.Errors.Count > 0)
                            {
                                <div class="invalid-feedback d-block">
                                    @foreach (var error in ViewData.ModelState["DateOfBirth"]!.Errors)
                                    {
                                        <span>@error.ErrorMessage</span>
                                    }
                                </div>
                            }
                            <small class="form-text text-muted">Вказати необов'язково</small>
                        </div>



                        <div class="alert alert-info" role="alert">
                            <strong>Порада:</strong> Заповніть свій профіль, щоб друзі могли дізнатися про Вас більше!
                        </div>

                        <div class="button-group mt-4">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-circle"></i> Створити профіль
                            </button>
                            <a href="javascript:history.back()" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> Скасувати
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .button-group {
        display: flex;
        gap: 10px;
    }

    .form-label {
        font-weight: 500;
    }

    .text-danger {
        color: #dc3545;
    }
</style>
