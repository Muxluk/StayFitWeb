@using StayFit.Domain.Entities
@model StayFit.Application.DTOs.UpdateUserProfileDto

@{
    ViewData["Title"] = "Редагування профілю";
    var activeTab = TempData["ActiveTab"]?.ToString();
    var isSecurityTabActive = string.Equals(activeTab, "Security", StringComparison.OrdinalIgnoreCase);
    var profilePhotoPath = ViewBag.ProfilePhotoPath as string;
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <!-- Успіх / Помилка повідомлення -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-circle"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-circle"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- TABS для переключення між Профілем та Безпекою -->
            <ul class="nav nav-tabs mb-4 profile-tabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(isSecurityTabActive ? "" : "active")" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile-tab-pane" type="button" role="tab" aria-controls="profile-tab-pane">
                        <i class="bi bi-person-circle"></i> Мій профіль
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(isSecurityTabActive ? "active" : "")" id="security-tab" data-bs-toggle="tab" data-bs-target="#security-tab-pane" type="button" role="tab" aria-controls="security-tab-pane">
                        <i class="bi bi-lock-fill"></i> Безпека акаунту
                    </button>
                </li>
            </ul>

            <div class="tab-content">
                <!-- TAB 1: ПРОФІЛЬ -->
                <div class="tab-pane fade @(isSecurityTabActive ? "" : "show active")" id="profile-tab-pane" role="tabpanel">
                    <div class="card shadow profile-card">
                        <div class="card-header profile-header">
                            <h3 class="mb-0"><i class="bi bi-person-fill"></i> Мій профіль</h3>
                        </div>
                        <div class="card-body">
                            <div class="row mb-4">
                                <div class="col-lg-6">
                                    <div class="border rounded p-3 h-100 bg-light-subtle">
                                        <h5 class="mb-3"><i class="bi bi-image"></i> Фото профілю</h5>

                                        @if (!string.IsNullOrWhiteSpace(profilePhotoPath))
                                        {
                                            <img src="@profilePhotoPath" alt="Фото профілю" class="img-fluid rounded shadow-sm mb-3 profile-photo-image" />
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center justify-content-center rounded border bg-white mb-3 profile-photo-placeholder">
                                                <div class="text-center">
                                                    <i class="bi bi-person-square text-muted" style="font-size: 3rem;"></i>
                                                    <div class="text-muted small">Фото ще не завантажено</div>
                                                </div>
                                            </div>
                                        }

                                        <form method="post" action="@Url.Action("UploadPhoto", "Profile")" enctype="multipart/form-data">
                                            @Html.AntiForgeryToken()
                                            <div class="mb-3">
                                                <input class="form-control" type="file" name="photo" accept=".jpg,.png,image/jpeg,image/png" required />
                                                <small class="text-muted">Дозволено: JPG, PNG | Макс. розмір: 5MB</small>
                                            </div>
                                            <button type="submit" class="btn btn-outline-success w-100">
                                                <i class="bi bi-upload"></i> Завантажити фото
                                            </button>
                                        </form>
                                    </div>
                                </div>
                                <div class="col-lg-6 mt-3 mt-lg-0">
                                    <div class="border rounded p-3 h-100 bg-light-subtle d-flex flex-column justify-content-center position-relative">
                                        <h5 class="mb-3">📊 Ваші показники <span id="auto-save-indicator" class="badge bg-success float-end d-none" style="font-size: 0.6rem;">Збережено</span></h5>
                                        <div class="d-flex justify-content-between mb-2 border-bottom pb-1">
                                            <span class="text-muted">Індекс маси тіла (ІМТ):</span>
                                            <strong id="calc-bmi" class="text-primary">-</strong>
                                        </div>
                                        <div class="d-flex justify-content-between mb-2 border-bottom pb-1">
                                            <span class="text-muted" title="Скільки калорій спалює тіло в стані спокою">Базовий метаболізм (BMR):</span>
                                            <strong id="calc-bmr" class="text-success">- ккал</strong>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span class="text-muted" title="Ваша загальна потреба в енергії на день">Денна норма (TDEE):</span>
                                            <strong id="calc-tdee" class="text-danger">- ккал</strong>
                                        </div>
                                        <small class="text-muted mt-2 text-center" style="font-size: 0.75rem;">Розрахунок відбуваєтcя автоматично при зміні параметрів.</small>
                                    </div>
                                </div>
                            </div>

                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <h5><i class="bi bi-exclamation-triangle"></i> Помилки у формі:</h5>
                                    <ul class="mb-0 small">
                                        @foreach (var modelState in ViewData.ModelState.Values)
                                        {
                                            @foreach (var error in modelState.Errors)
                                            {
                                                <li>@error.ErrorMessage</li>
                                            }
                                        }
                                    </ul>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                </div>
                            }

                            <form method="post" action="@Url.Action("Edit", "Profile")" novalidate>
                                @Html.AntiForgeryToken()

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="FullName" class="form-label"><strong>Ім'я</strong> <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control @(ViewData.ModelState["FullName"]?.Errors.Count > 0 ? "is-invalid" : "")" 
                                               id="FullName" name="FullName" value="@(Model?.FullName ?? "")" 
                                               placeholder="Вашу повне ім'я" required>
                                        @if (ViewData.ModelState["FullName"]?.Errors.Count > 0)
                                        {
                                            <div class="invalid-feedback d-block">
                                                @foreach (var error in ViewData.ModelState["FullName"]!.Errors)
                                                {
                                                    @error.ErrorMessage
                                                }
                                            </div>
                                        }
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label for="Gender" class="form-label"><strong>Стать</strong></label>
                                        <select class="form-select @(ViewData.ModelState["Gender"]?.Errors.Count > 0 ? "is-invalid" : "")" 
                                                id="Gender" name="Gender">
                                            <option value="">-- Виберіть стать --</option>
                                            @{
                                                string[] genders = { "Чоловік", "Жінка", "Інше" };
                                                foreach (var gender in genders)
                                                {
                                                    if (Model?.Gender == gender)
                                                    {
                                                        <option value="@gender" selected>@gender</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@gender">@gender</option>
                                                    }
                                                }
                                            }
                                        </select>
                                        @if (ViewData.ModelState["Gender"]?.Errors.Count > 0)
                                        {
                                            <div class="invalid-feedback d-block">
                                                @foreach (var error in ViewData.ModelState["Gender"]!.Errors)
                                                {
                                                    @error.ErrorMessage
                                                }
                                            </div>
                                        }
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label for="Weight" class="form-label"><strong>Вага (кг)</strong></label>
                                        <input type="number" class="form-control @(ViewData.ModelState["Weight"]?.Errors.Count > 0 ? "is-invalid" : "")" 
                                               id="Weight" name="Weight" value="@(Model?.Weight?.ToString("F1") ?? "")" 
                                               placeholder="60" step="0.1" min="20" max="500">
                                        @if (ViewData.ModelState["Weight"]?.Errors.Count > 0)
                                        {
                                            <div class="invalid-feedback d-block">
                                                @foreach (var error in ViewData.ModelState["Weight"]!.Errors)
                                                {
                                                    @error.ErrorMessage
                                                }
                                            </div>
                                        }
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label for="Height" class="form-label"><strong>Зріст (см)</strong></label>
                                        <input type="number" class="form-control @(ViewData.ModelState["Height"]?.Errors.Count > 0 ? "is-invalid" : "")" 
                                               id="Height" name="Height" value="@(Model?.Height?.ToString("F0") ?? "")" 
                                               placeholder="170" step="1" min="100" max="250">
                                        @if (ViewData.ModelState["Height"]?.Errors.Count > 0)
                                        {
                                            <div class="invalid-feedback d-block">
                                                @foreach (var error in ViewData.ModelState["Height"]!.Errors)
                                                {
                                                    @error.ErrorMessage
                                                }
                                            </div>
                                        }
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label for="DateOfBirth" class="form-label"><strong>Дата народження</strong></label>
                                        <input type="date" class="form-control @(ViewData.ModelState["DateOfBirth"]?.Errors.Count > 0 ? "is-invalid" : "")" 
                                               id="DateOfBirth" name="DateOfBirth" 
                                               value="@(Model?.DateOfBirth?.ToString("yyyy-MM-dd") ?? "")">
                                        <small class="text-muted">Необов'язково</small>
                                        @if (ViewData.ModelState["DateOfBirth"]?.Errors.Count > 0)
                                        {
                                            <div class="invalid-feedback d-block">
                                                @foreach (var error in ViewData.ModelState["DateOfBirth"]!.Errors)
                                                {
                                                    @error.ErrorMessage
                                                }
                                            </div>
                                        }
                                    </div>
                                    
                                    <div class="col-md-6 mb-3">
                                        <label for="ActivityLevel" class="form-label"><strong>Рівень активності</strong></label>
                                        <select class="form-select @(ViewData.ModelState["ActivityLevel"]?.Errors.Count > 0 ? "is-invalid" : "")" 
                                                id="ActivityLevel" name="ActivityLevel">
                                            <option value="">-- Виберіть активність --</option>
                                            <option value="Sedentary" selected="@(Model?.ActivityLevel == "Sedentary")">Сидячий (мало або немає вправ)</option>
                                            <option value="LightlyActive" selected="@(Model?.ActivityLevel == "LightlyActive")">Легка активність (1-3 дні/тиж)</option>
                                            <option value="ModeratelyActive" selected="@(Model?.ActivityLevel == "ModeratelyActive")">Помірна (3-5 днів/тиж)</option>
                                            <option value="VeryActive" selected="@(Model?.ActivityLevel == "VeryActive")">Висока (6-7 днів/тиж)</option>
                                            <option value="SuperActive" selected="@(Model?.ActivityLevel == "SuperActive")">Дуже висока (фіз. робота)</option>
                                        </select>
                                    </div>
                                </div>

                                <hr class="my-4">

                                <div class="d-flex gap-2">
                                    <a href="@Url.Action("View", "Profile")" class="btn btn-outline-secondary btn-lg">
                                        <i class="bi bi-arrow-left"></i> Скасувати
                                    </a>
                                    <button type="submit" class="btn btn-success btn-lg">
                                        <i class="bi bi-check-circle"></i> Зберегти профіль
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Зовнішній вигляд -->
                <div class="card shadow mt-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-palette-fill me-2"></i>Зовнішній вигляд</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between p-3 bg-body-secondary rounded">
                            <div>
                                <div class="fw-semibold"><i class="bi bi-moon-stars-fill me-2 text-primary"></i>Темна тема</div>
                                <div class="text-muted small">Перемикає темний/світлий інтерфейс. Вибір зберігається в браузері.</div>
                            </div>
                            <div class="form-check form-switch mb-0 ms-4">
                                <input class="form-check-input fs-5" type="checkbox" role="switch"
                                       id="sf-profile-theme-switch"
                                       onchange="sfToggleTheme()" />
                                <label class="form-check-label visually-hidden" for="sf-profile-theme-switch">Темна тема</label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TAB 2: БЕЗПЕКА -->
                <div class="tab-pane fade @(isSecurityTabActive ? "show active" : "")" id="security-tab-pane" role="tabpanel">
                    <div class="card shadow mb-4">
                        <div class="card-header security-header">
                            <h5 class="mb-0"><i class="bi bi-key-fill"></i> Змінення пароля</h5>
                        </div>
                        <div class="card-body">
                            <form method="post" action="/account-security/change-password">
                                @Html.AntiForgeryToken()

                                <div class="mb-3">
                                    <label for="currentPassword" class="form-label">Поточний пароль</label>
                                    <input type="password" class="form-control" name="CurrentPassword" id="currentPassword" placeholder="Введіть поточний пароль" required>
                                </div>

                                <div class="mb-3">
                                    <label for="newPassword" class="form-label">Новий пароль</label>
                                    <input type="password" class="form-control" name="NewPassword" id="newPassword" placeholder="Мінімум 8 символів" required minlength="8">
                                    <small class="form-text text-muted">Мінімум 8 символів, зі спеціальними символами</small>
                                </div>

                                <div class="mb-3">
                                    <label for="confirmPassword" class="form-label">Підтвердження пароля</label>
                                    <input type="password" class="form-control" name="ConfirmPassword" id="confirmPassword" placeholder="Повторіть новий пароль" required minlength="8">
                                </div>

                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-check-lg"></i> Змінити пароль
                                </button>
                            </form>
                        </div>
                    </div>

                    <div class="card shadow mb-4">
                        <div class="card-header sessions-header">
                            <h5 class="mb-0"><i class="bi bi-lightning-fill"></i> Активні сеанси</h5>
                        </div>
                        <div class="card-body">
                            @{
                                var activeSessions = ViewBag.ActiveSessions as IList<StayFit.Domain.Entities.UserSession> ?? new List<StayFit.Domain.Entities.UserSession>();
                                var currentSessionToken = ViewBag.CurrentSessionToken as string ?? string.Empty;
                            }
                            @if (!activeSessions.Any())
                            {
                                <p class="text-muted mb-0">Немає активних сеансів.</p>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Пристрій</th>
                                                <th>IP адреса</th>
                                                <th>Час входу</th>
                                                <th>Остання активність</th>
                                                <th>Статус</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var session in activeSessions)
                                            {
                                                var isCurrent = session.SessionToken == currentSessionToken;
                                                <tr class="@(isCurrent ? "table-success" : "")">
                                                    <td>
                                                        <i class="bi bi-laptop me-1"></i>
                                                        @session.GetDeviceSummary()
                                                    </td>
                                                    <td>@(session.IpAddress ?? "—")</td>
                                                    <td>@session.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                                    <td>@(session.LastActivityAt.HasValue ? session.LastActivityAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "—")</td>
                                                    <td>
                                                        @if (isCurrent)
                                                        {
                                                            <span class="badge bg-success">Поточний</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary">Активний</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (!isCurrent)
                                                        {
                                                            <form method="post" action="/sessions/terminate" class="d-inline">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="sessionId" value="@session.Id" />
                                                                <button type="submit" class="btn btn-outline-danger btn-sm"
                                                                            data-confirm-title="Завершити сеанс"
                                                                            data-confirm-message="Завершити цей сеанс?"
                                                                            data-confirm-button-text="Завершити"
                                                                            data-confirm-button-class="btn-danger">
                                                                    <i class="bi bi-x-lg"></i>
                                                                </button>
                                                            </form>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                @if (activeSessions.Count(s => s.SessionToken != currentSessionToken) > 0)
                                {
                                    <form method="post" action="/sessions/terminate-all" class="d-inline mt-3">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-warning btn-sm"
                                                data-confirm-title="Завершити всі інші сеанси"
                                                data-confirm-message="Завершити всі інші сеанси?"
                                                data-confirm-button-text="Завершити"
                                                data-confirm-button-class="btn-warning">
                                            <i class="bi bi-box-arrow-right me-1"></i> Вийти зі всіх інших сеансів
                                        </button>
                                    </form>
                                }
                            }
                        </div>
                    </div>

                    <div class="card shadow mb-4">
                        <div class="card-header profile-security-history-header">
                            <h5 class="mb-0"><i class="bi bi-shield-check"></i> Історія безпеки акаунту</h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-2 align-items-end mb-3">
                                <div class="col-md-5 col-lg-4">
                                    <label for="securityEventTypeFilter" class="form-label small">Фільтр за типом події</label>
                                    <select id="securityEventTypeFilter" class="form-select form-select-sm">
                                        <option value="">Всі події</option>
                                        <option value="Login">Вхід</option>
                                        <option value="Logout">Вихід</option>
                                        <option value="PasswordChange">Зміна пароля</option>
                                        <option value="SessionTerminated">Сеанс завершено</option>
                                    </select>
                                </div>
                            </div>
                            <div id="securityLogs">
                                <div class="text-center text-muted py-3">
                                    <div class="spinner-border spinner-border-sm" role="status">
                                        <span class="visually-hidden">Завантаження...</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card shadow border-danger">
                        <div class="card-header danger-header">
                            <h5 class="mb-0"><i class="bi bi-exclamation-triangle-fill"></i> Видалення акаунту</h5>
                        </div>
                        <div class="card-body">
                            <p class="text-danger mb-3"><strong><i class="bi bi-exclamation-circle"></i> Увага!</strong> Цю дію не можна відмінити. Усі ваші дані будуть видалені.</p>

                            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteAccountModal">
                                <i class="bi bi-trash"></i> Видалити акаунт
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal для підтвердження видалення -->
<div class="modal fade" id="deleteAccountModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header danger-header">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill"></i> Підтвердження видалення акаунту</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/account-security/delete-account">
                @Html.AntiForgeryToken()

                <div class="modal-body">
                    <p>Ви впевнені, що хочете видалити свій акаунт?</p>
                    <p class="text-danger"><strong><i class="bi bi-exclamation-circle"></i> Ця дія не може бути скасована! Всі ваші дані (профіль, цілі, щоденники) будуть назавжди видалені.</strong></p>

                    <div class="mb-3 mt-4">
                        <label for="deletePassword" class="form-label">
                            Введіть ваш пароль для підтвердження
                        </label>
                        <input type="password" class="form-control" name="Password" id="deletePassword" placeholder="Ваш поточний пароль" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Скасувати</button>
                    <button type="submit" class="btn btn-danger">Видалити назавжди</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Sync dark mode toggle switch with current theme
        (function() {
            var sw = document.getElementById('sf-profile-theme-switch');
            if (sw) sw.checked = document.documentElement.getAttribute('data-bs-theme') === 'dark';
        })();

        // Активуємо вкладку безпеки лише коли це явно запрошено контролером
        @if (isSecurityTabActive)
        {
            <text>
        document.addEventListener('DOMContentLoaded', function() {
            const securityTab = document.getElementById('security-tab');
            if (securityTab) {
                const tab = new bootstrap.Tab(securityTab);
                tab.show();
            }
        });
            </text>
        }

        // Валідація пароля при зміні
        const changePasswordForm = document.querySelector('form[action="/account-security/change-password"]');
        if (changePasswordForm) {
            changePasswordForm.addEventListener('submit', function (e) {
                const newPassword = document.getElementById('newPassword').value;
                const confirmPassword = document.getElementById('confirmPassword').value;

                if (newPassword !== confirmPassword) {
                    e.preventDefault();
                    alert('Паролі не збігаються!');
                    return false;
                }
            });
        }

        // Валідація токена видалення
        const deleteForm = document.querySelector('form[action="/account-security/delete-account"]');
        if (deleteForm) {
            deleteForm.addEventListener('submit', function (e) {
                const password = document.getElementById('deletePassword').value;
                if (!password || password.trim() === '') {
                    e.preventDefault();
                    alert('Будь ласка, введіть пароль для підтвердження.');
                    return false;
                }
                
                if (!confirm('ОСТАННЄ ПОПЕРЕДЖЕННЯ! Ви дійсно хочете видалити акаунт назавжди?')) {
                    e.preventDefault();
                    return false;
                }
            });
        }

        // Завантаження журналу безпеки
        async function loadSecurityLogs(page = 1) {
            try {
                const eventType = document.getElementById('securityEventTypeFilter')?.value || '';
                let requestUrl = '/security-log/logs?page=' + page;

                if (eventType) {
                    requestUrl += '&eventType=' + encodeURIComponent(eventType);
                }

                const response = await fetch(requestUrl);
                if (!response.ok) {
                    let errorMessage = 'Помилка при завантаженні журналу';
                    try {
                        const errorPayload = await response.json();
                        if (errorPayload?.message) {
                            errorMessage = errorPayload.message;
                        }
                    } catch (_) {
                        // Якщо бек повернув не-JSON, залишаємо дефолтний текст помилки.
                    }

                    throw new Error(errorMessage);
                }
                
                const data = await response.json();
                renderSecurityLogs(data);
            } catch (error) {
                console.error('Помилка завантаження логів:', error);
                document.getElementById('securityLogs').innerHTML = 
                    '<div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> Не вдалося завантажити історію безпеки: ' + (error?.message || 'невідома помилка') + '</div>';
            }
        }

        function renderSecurityLogs(pagedResult) {
            const container = document.getElementById('securityLogs');
            if (!pagedResult || typeof pagedResult !== 'object') {
                container.innerHTML = '<div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> Сервер повернув некоректні дані журналу безпеки.</div>';
                return;
            }

            const items = pagedResult.items || pagedResult.Items || [];
            const pageNumber = pagedResult.pageNumber || pagedResult.PageNumber || 1;
            const totalPages = pagedResult.totalPages || pagedResult.TotalPages || 1;
            const totalCount = pagedResult.totalCount || pagedResult.TotalCount || 0;
            
            if (!items.length) {
                container.innerHTML = '<p class="text-muted">Немає записів у журналі безпеки.</p>';
                return;
            }

            let html = '<div class="table-responsive">';
            html += '<table class="table table-sm table-hover align-middle mb-0">';
            html += '<thead class="table-light"><tr>';
            html += '<th>Дата/Час</th><th>Тип івенту</th><th>Опис</th><th>Пристрій</th><th>IP адреса</th><th>Статус</th>';
            html += '</tr></thead><tbody>';

            items.forEach(log => {
                const date = new Date(log.createdAt);
                const formattedDate = date.toLocaleDateString('uk-UA') + ' ' + date.toLocaleTimeString('uk-UA');
                const statusBadge = log.status === 'Success' 
                    ? '<span class="badge bg-success"><i class="bi bi-check-lg"></i> Успіх</span>'
                    : '<span class="badge bg-danger"><i class="bi bi-x-lg"></i> Помилка</span>';
                
                let eventBadge = '';
                switch(log.eventType) {
                    case 'Login': eventBadge = '<span class="badge bg-info"><i class="bi bi-box-arrow-in-right"></i> Вхід</span>'; break;
                    case 'Logout': eventBadge = '<span class="badge bg-secondary"><i class="bi bi-box-arrow-right"></i> Вихід</span>'; break;
                    case 'PasswordChange': eventBadge = '<span class="badge bg-warning"><i class="bi bi-key"></i> Зміна пароля</span>'; break;
                    case 'SessionTerminated': eventBadge = '<span class="badge bg-danger"><i class="bi bi-stop-circle"></i> Сеанс завершено</span>'; break;
                    default: eventBadge = '<span class="badge bg-dark">' + log.eventType + '</span>';
                }
                
                html += '<tr>';
                html += '<td>' + formattedDate + '</td>';
                html += '<td>' + eventBadge + '</td>';
                html += '<td>' + log.description + '</td>';
                html += '<td>' + (log.deviceSummary || 'Unknown') + '</td>';
                html += '<td>' + (log.ipAddress || '—') + '</td>';
                html += '<td>' + statusBadge + '</td>';
                html += '</tr>';
            });

            html += '</tbody></table></div>';
            
            // Додаємо пагінацію інформацію
            if (totalPages > 1) {
                html += '<p class="text-muted small mt-3">Сторінка ' + pageNumber + ' з ' + totalPages + 
                        ' (' + totalCount + ' записів)</p>';
            }
            
            container.innerHTML = html;
        }

        // Завантажуємо журнал при завантаженні сторінки
        document.addEventListener('DOMContentLoaded', function() {
            const eventTypeFilter = document.getElementById('securityEventTypeFilter');
            if (eventTypeFilter) {
                eventTypeFilter.addEventListener('change', function () {
                    loadSecurityLogs(1);
                });
            }

            loadSecurityLogs(1);
        });

        // --- ЛОГІКА РОЗРАХУНКІВ ТА АВТОЗБЕРЕЖЕННЯ ---
        document.addEventListener('DOMContentLoaded', function() {
            const inputs = ['Weight', 'Height', 'DateOfBirth', 'Gender', 'ActivityLevel', 'FullName'];
            const elements = {};
            inputs.forEach(id => {
                const el = document.getElementById(id);
                if (el) elements[id] = el;
            });

            const bmiEl = document.getElementById('calc-bmi');
            const bmrEl = document.getElementById('calc-bmr');
            const tdeeEl = document.getElementById('calc-tdee');
            const saveIndicator = document.getElementById('auto-save-indicator');

            function calculateMetrics() {
                const weight = parseFloat(elements.Weight?.value);
                const height = parseFloat(elements.Height?.value);
                const gender = elements.Gender?.value;
                const dob = elements.DateOfBirth?.value;
                const activity = elements.ActivityLevel?.value;

                if (!weight || !height) {
                    bmiEl.innerText = '-';
                    bmrEl.innerText = '- ккал';
                    tdeeEl.innerText = '- ккал';
                    return;
                }

                // ІМТ
                const heightM = height / 100;
                const bmi = weight / (heightM * heightM);
                bmiEl.innerText = bmi.toFixed(1);

                // Вік
                let age = 30; // дефолтний вік якщо не вказано
                if (dob) {
                    const birthDate = new Date(dob);
                    const today = new Date();
                    age = today.getFullYear() - birthDate.getFullYear();
                    const m = today.getMonth() - birthDate.getMonth();
                    if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) {
                        age--;
                    }
                }

                // BMR (Mifflin-St Jeor)
                let bmr = 0;
                if (gender === 'Чоловік') {
                    bmr = (10 * weight) + (6.25 * height) - (5 * age) + 5;
                } else if (gender === 'Жінка') {
                    bmr = (10 * weight) + (6.25 * height) - (5 * age) - 161;
                } else {
                    // Середнє для "Інше" або не вказано
                    bmr = (10 * weight) + (6.25 * height) - (5 * age) - 78;
                }
                bmrEl.innerText = Math.round(bmr) + ' ккал';

                // TDEE
                let activityMultiplier = 1.2; // Sedentary (default)
                switch(activity) {
                    case 'LightlyActive': activityMultiplier = 1.375; break;
                    case 'ModeratelyActive': activityMultiplier = 1.55; break;
                    case 'VeryActive': activityMultiplier = 1.725; break;
                    case 'SuperActive': activityMultiplier = 1.9; break;
                }

                const tdee = bmr * activityMultiplier;
                tdeeEl.innerText = Math.round(tdee) + ' ккал';
            }

            let saveTimeout = null;

            async function autoSave() {
                if (saveIndicator) {
                    saveIndicator.innerText = "Зберігається...";
                    saveIndicator.classList.remove('bg-success', 'd-none');
                    saveIndicator.classList.add('bg-warning', 'text-dark');
                }

                const payload = {
                    FullName: elements.FullName?.value || '',
                    Weight: parseFloat(elements.Weight?.value) || null,
                    Height: parseFloat(elements.Height?.value) || null,
                    DateOfBirth: elements.DateOfBirth?.value || null,
                    Gender: elements.Gender?.value || null,
                    ActivityLevel: elements.ActivityLevel?.value || null
                };

                try {
                    const response = await fetch('/profile/auto-save', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                        },
                        body: JSON.stringify(payload)
                    });

                    if (response.ok) {
                        if (saveIndicator) {
                            saveIndicator.innerText = "Збережено ✔️";
                            saveIndicator.classList.remove('bg-warning', 'text-dark');
                            saveIndicator.classList.add('bg-success');
                            
                            setTimeout(() => {
                                saveIndicator.classList.add('d-none');
                            }, 3000);
                        }
                    } else {
                        if (saveIndicator) {
                            saveIndicator.innerText = "Помилка";
                            saveIndicator.classList.remove('bg-warning', 'text-dark');
                            saveIndicator.classList.add('bg-danger');
                        }
                    }
                } catch (error) {
                    console.error("Помилка автозбереження", error);
                    if (saveIndicator) {
                        saveIndicator.innerText = "Помилка";
                        saveIndicator.classList.remove('bg-warning', 'text-dark');
                        saveIndicator.classList.add('bg-danger');
                    }
                }
            }

            inputs.forEach(id => {
                if (elements[id]) {
                    elements[id].addEventListener('input', function() {
                        calculateMetrics();
                        
                        clearTimeout(saveTimeout);
                        saveTimeout = setTimeout(autoSave, 1500); // автозбереження через 1.5 секунди після вводу
                    });
                }
            });

            // Початковий розрахунок
            calculateMetrics();
        });
    </script>
}
