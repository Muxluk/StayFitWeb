@using StayFit.Domain.Entities
@model StayFit.Application.DTOs.UpdateUserProfileDto

@{
    ViewData["Title"] = "Редагування профілю";
    var activeTab = TempData["ActiveTab"]?.ToString();
    var isSecurityTabActive = string.Equals(activeTab, "Security", StringComparison.OrdinalIgnoreCase);
    var profilePhotoPath = ViewBag.ProfilePhotoPath as string;
}

<style>
    .profile-header {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        border-radius: 0.5rem 0.5rem 0 0;
        transition: box-shadow 0.3s ease;
    }

    .profile-card {
        border: none;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .profile-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 0.75rem 1.5rem rgba(0, 0, 0, 0.18);
    }

    .nav-tabs .nav-link {
        border: none;
        border-bottom: 3px solid transparent;
        color: #6c757d;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .nav-tabs .nav-link:hover {
        color: #10b981;
        border-bottom-color: #10b981;
    }

    .nav-tabs .nav-link.active {
        color: #10b981;
        border-bottom-color: #10b981;
        background-color: transparent;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #10b981;
        box-shadow: 0 0 0 0.2rem rgba(16, 185, 129, 0.25);
    }

    .btn-primary {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        border: none;
        transition: transform 0.2s ease;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 0.5rem 1rem rgba(16, 185, 129, 0.4);
    }

    .security-header {
        background: linear-gradient(135deg, #16a34a 0%, #15803d 100%);
    }

    .sessions-header {
        background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
    }

    .danger-header {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
    }
</style>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <!-- Успіх / Помилка повідомлення -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    ✅ @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    ❌ @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    ✅ @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    ❌ @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- TABS для переключення між Профілем та Безпекою -->
            <ul class="nav nav-tabs mb-4 border-0" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link px-0 me-4 @(isSecurityTabActive ? "" : "active")" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile-tab-pane" type="button" role="tab">
                        👤 Мой профіль
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link px-0 me-4 @(isSecurityTabActive ? "active" : "")" id="security-tab" data-bs-toggle="tab" data-bs-target="#security-tab-pane" type="button" role="tab">
                        🔐 Безпека акаунту
                    </button>
                </li>
            </ul>

            <div class="tab-content">
                <!-- TAB 1: ПРОФІЛЬ -->
                <div class="tab-pane fade @(isSecurityTabActive ? "" : "show active")" id="profile-tab-pane" role="tabpanel">
                    <div class="card shadow profile-card">
                        <div class="card-header profile-header text-white">
                            <h3 class="mb-0">👤 Мій профіль</h3>
                        </div>
                        <div class="card-body">
                            <div class="row mb-4">
                                <div class="col-lg-6">
                                    <div class="border rounded p-3 h-100 bg-light-subtle">
                                        <h5 class="mb-3">Фото профілю</h5>

                                        @if (!string.IsNullOrWhiteSpace(profilePhotoPath))
                                        {
                                            <img src="@profilePhotoPath" alt="Фото профілю" class="img-fluid rounded shadow-sm mb-3" style="max-height: 220px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center justify-content-center rounded border bg-white mb-3" style="height: 220px;">
                                                <span class="text-muted">Фото ще не завантажено</span>
                                            </div>
                                        }

                                        <form method="post" action="@Url.Action("UploadPhoto", "Profile")" enctype="multipart/form-data">
                                            @Html.AntiForgeryToken()
                                            <div class="mb-3">
                                                <input class="form-control" type="file" name="photo" accept=".jpg,.png,image/jpeg,image/png" required />
                                                <small class="text-muted">Дозволено: JPG, PNG</small>
                                            </div>
                                            <button type="submit" class="btn btn-outline-success">
                                                <i class="bi bi-upload"></i> Завантажити фото
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>

                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <h5>⚠️ Помилки у формі:</h5>
                                    <ul class="mb-0">
                                        @foreach (var modelState in ViewData.ModelState.Values)
                                        {
                                            @foreach (var error in modelState.Errors)
                                            {
                                                <li>@error.ErrorMessage</li>
                                            }
                                        }
                                    </ul>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                </div>
                            }

                            <form method="post" action="@Url.Action("Edit", "Profile")" novalidate>
                                @Html.AntiForgeryToken()

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="FullName" class="form-label"><strong>Ім'я</strong> <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control @(ViewData.ModelState["FullName"]?.Errors.Count > 0 ? "is-invalid" : "")" 
                                               id="FullName" name="FullName" value="@(Model?.FullName ?? "")" 
                                               placeholder="Введіть Ваше ім'я" required>
                                        @if (ViewData.ModelState["FullName"]?.Errors.Count > 0)
                                        {
                                            <div class="invalid-feedback d-block">
                                                @foreach (var error in ViewData.ModelState["FullName"]!.Errors)
                                                {
                                                    @error.ErrorMessage
                                                }
                                            </div>
                                        }
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label for="Gender" class="form-label"><strong>Стать</strong></label>
                                        <select class="form-select @(ViewData.ModelState["Gender"]?.Errors.Count > 0 ? "is-invalid" : "")" 
                                                id="Gender" name="Gender">
                                            <option value="">-- Виберіть стать --</option>
                                            @{
                                                string[] genders = { "Чоловік", "Жінка", "Інше" };
                                                foreach (var gender in genders)
                                                {
                                                    if (Model?.Gender == gender)
                                                    {
                                                        <option value="@gender" selected>@gender</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@gender">@gender</option>
                                                    }
                                                }
                                            }
                                        </select>
                                        @if (ViewData.ModelState["Gender"]?.Errors.Count > 0)
                                        {
                                            <div class="invalid-feedback d-block">
                                                @foreach (var error in ViewData.ModelState["Gender"]!.Errors)
                                                {
                                                    @error.ErrorMessage
                                                }
                                            </div>
                                        }
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label for="Weight" class="form-label"><strong>Вага</strong> (кг)</label>
                                        <input type="number" class="form-control @(ViewData.ModelState["Weight"]?.Errors.Count > 0 ? "is-invalid" : "")" 
                                               id="Weight" name="Weight" value="@(Model?.Weight?.ToString("F1") ?? "")" 
                                               placeholder="Введіть Вашу вагу" step="0.1" min="20" max="500">
                                        @if (ViewData.ModelState["Weight"]?.Errors.Count > 0)
                                        {
                                            <div class="invalid-feedback d-block">
                                                @foreach (var error in ViewData.ModelState["Weight"]!.Errors)
                                                {
                                                    @error.ErrorMessage
                                                }
                                            </div>
                                        }
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label for="Height" class="form-label"><strong>Зріст</strong> (см)</label>
                                        <input type="number" class="form-control @(ViewData.ModelState["Height"]?.Errors.Count > 0 ? "is-invalid" : "")" 
                                               id="Height" name="Height" value="@(Model?.Height?.ToString("F0") ?? "")" 
                                               placeholder="Введіть Ваш зріст" step="1" min="100" max="250">
                                        @if (ViewData.ModelState["Height"]?.Errors.Count > 0)
                                        {
                                            <div class="invalid-feedback d-block">
                                                @foreach (var error in ViewData.ModelState["Height"]!.Errors)
                                                {
                                                    @error.ErrorMessage
                                                }
                                            </div>
                                        }
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label for="DateOfBirth" class="form-label"><strong>Дата народження</strong></label>
                                        <input type="date" class="form-control @(ViewData.ModelState["DateOfBirth"]?.Errors.Count > 0 ? "is-invalid" : "")" 
                                               id="DateOfBirth" name="DateOfBirth" 
                                               value="@(Model?.DateOfBirth?.ToString("yyyy-MM-dd") ?? "")">
                                        @if (ViewData.ModelState["DateOfBirth"]?.Errors.Count > 0)
                                        {
                                            <div class="invalid-feedback d-block">
                                                @foreach (var error in ViewData.ModelState["DateOfBirth"]!.Errors)
                                                {
                                                    @error.ErrorMessage
                                                }
                                            </div>
                                        }
                                        <small class="text-muted">Необов'язково</small>
                                    </div>
                                </div>

                                <hr class="my-4">

                                <div class="d-flex gap-2">
                                    <a href="@Url.Action("View", "Profile")" class="btn btn-outline-success btn-lg">
                                        <i class="bi bi-arrow-left"></i> Скасувати
                                    </a>
                                    <button type="submit" class="btn btn-success btn-lg">
                                        <i class="bi bi-check-circle"></i> Зберегти профіль
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- TAB 2: БЕЗПЕКА -->
                <div class="tab-pane fade @(isSecurityTabActive ? "show active" : "")" id="security-tab-pane" role="tabpanel">
                    <div class="card shadow mb-4">
                        <div class="card-header security-header text-white">
                            <h5 class="mb-0">Змінення пароля</h5>
                        </div>
                        <div class="card-body">
                            <form method="post" action="/account-security/change-password">
                                @Html.AntiForgeryToken()

                                <div class="mb-3">
                                    <label for="currentPassword" class="form-label">Поточний пароль</label>
                                    <input type="password" class="form-control" name="CurrentPassword" id="currentPassword" required>
                                </div>

                                <div class="mb-3">
                                    <label for="newPassword" class="form-label">Новий пароль</label>
                                    <input type="password" class="form-control" name="NewPassword" id="newPassword" required minlength="8">
                                    <small class="form-text text-muted">Мінімум 8 символів</small>
                                </div>

                                <div class="mb-3">
                                    <label for="confirmPassword" class="form-label">Підтвердження пароля</label>
                                    <input type="password" class="form-control" name="ConfirmPassword" id="confirmPassword" required minlength="8">
                                </div>

                                <button type="submit" class="btn btn-success">Змінити пароль</button>
                            </form>
                        </div>
                    </div>

                    <div class="card shadow mb-4">
                        <div class="card-header sessions-header text-white">
                            <h5 class="mb-0">Активні сеанси</h5>
                        </div>
                        <div class="card-body">
                            @{
                                var activeSessions = ViewBag.ActiveSessions as IList<StayFit.Domain.Entities.UserSession> ?? new List<StayFit.Domain.Entities.UserSession>();
                                var currentSessionToken = ViewBag.CurrentSessionToken as string ?? string.Empty;
                            }
                            @if (!activeSessions.Any())
                            {
                                <p class="text-muted">Немає активних сеансів.</p>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover align-middle">
                                        <thead>
                                            <tr>
                                                <th>Пристрій</th>
                                                <th>IP адреса</th>
                                                <th>Час входу</th>
                                                <th>Остання активність</th>
                                                <th>Статус</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var session in activeSessions)
                                            {
                                                var isCurrent = session.SessionToken == currentSessionToken;
                                                <tr class="@(isCurrent ? "table-success" : "")">
                                                    <td>
                                                        <i class="bi bi-laptop me-1"></i>
                                                        @session.GetDeviceSummary()
                                                    </td>
                                                    <td>@(session.IpAddress ?? "—")</td>
                                                    <td>@session.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                                    <td>@(session.LastActivityAt.HasValue ? session.LastActivityAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "—")</td>
                                                    <td>
                                                        @if (isCurrent)
                                                        {
                                                            <span class="badge bg-success">Поточний</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary">Активний</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (!isCurrent)
                                                        {
                                                            <form method="post" action="/sessions/terminate" style="display:inline;">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="sessionId" value="@session.Id" />
                                                                <button type="submit" class="btn btn-outline-danger btn-sm"
                                                                        onclick="return confirm('Завершити цей сеанс?')">
                                                                    <i class="bi bi-x-lg"></i> Завершити
                                                                </button>
                                                            </form>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            @if (activeSessions.Count(s => s.SessionToken != currentSessionToken) > 0)
                            {
                                <form method="post" action="/sessions/terminate-all" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-warning btn-sm mt-2"
                                            onclick="return confirm('Завершити всі інші сеанси?')">
                                        <i class="bi bi-box-arrow-right me-1"></i>Вийти зі всіх інших сеансів
                                    </button>
                                </form>
                            }
                        </div>
                    </div>

                    <div class="card shadow mb-4">
                        <div class="card-header" style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); color: white;">
                            <h5 class="mb-0">📋 Історія безпеки акаунту</h5>
                        </div>
                        <div class="card-body">
                            <div id="securityLogs">
                                <div class="text-center text-muted py-3">
                                    <div class="spinner-border spinner-border-sm" role="status">
                                        <span class="visually-hidden">Завантаження...</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card shadow border-danger">
                        <div class="card-header danger-header text-white">
                            <h5 class="mb-0">Видалення акаунту</h5>
                        </div>
                        <div class="card-body">
                            <p class="text-danger"><strong>⚠️ Увага!</strong> Цю дію не можна відмінити. Усі ваші дані будуть видалені.</p>

                            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteAccountModal">
                                Видалити акаунт
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal для підтвердження видалення -->
<div class="modal fade" id="deleteAccountModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Підтвердження видалення акаунту</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/account-security/delete-account">
                @Html.AntiForgeryToken()

                <div class="modal-body">
                    <p>Ви впевнені, що хочете видалити свій акаунт?</p>
                    <p class="text-danger"><strong>Ця дія не може бути скасована! Всі ваші дані (профіль, цілі, щоденники) будуть назавжди видалені.</strong></p>

                    <div class="mb-3 mt-4">
                        <label for="deletePassword" class="form-label">
                            Введіть ваш пароль для підтвердження
                        </label>
                        <input type="password" class="form-control" name="Password" id="deletePassword" placeholder="Ваш поточний пароль" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Скасувати</button>
                    <button type="submit" class="btn btn-danger">Видалити назавжди</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Активуємо вкладку безпеки лише коли це явно запрошено контролером безпеки
        @if (isSecurityTabActive)
        {
            <text>
        document.addEventListener('DOMContentLoaded', function() {
            const securityTab = document.getElementById('security-tab');
            if (securityTab) {
                const tab = new bootstrap.Tab(securityTab);
                tab.show();
            }
        });
            </text>
        }

        // Валідація пароля при зміні
        const changePasswordForm = document.querySelector('form[action="/account-security/change-password"]');
        if (changePasswordForm) {
            changePasswordForm.addEventListener('submit', function (e) {
                const newPassword = document.getElementById('newPassword').value;
                const confirmPassword = document.getElementById('confirmPassword').value;

                if (newPassword !== confirmPassword) {
                    e.preventDefault();
                    alert('Паролі не збігаються!');
                    return false;
                }
            });
        }

        // Валідація токена видалення
        const deleteForm = document.querySelector('form[action="/account-security/delete-account"]');
        if (deleteForm) {
            deleteForm.addEventListener('submit', function (e) {
                const password = document.getElementById('deletePassword').value;
                if (!password || password.trim() === '') {
                    e.preventDefault();
                    alert('Будь ласка, введіть пароль для підтвердження.');
                    return false;
                }
                
                if (!confirm('ОСТАННЄ ПОПЕРЕДЖЕННЯ! Ви дійсно хочете видалити акаунт назавжди?')) {
                    e.preventDefault();
                    return false;
                }
            });
        }

        // Завантаження журналу безпеки
        async function loadSecurityLogs() {
            try {
                const response = await fetch('/security-log/logs?page=1');
                if (!response.ok) throw new Error('Помилка при завантаженні журналу');
                
                const data = await response.json();
                renderSecurityLogs(data);
            } catch (error) {
                console.error('Помилка завантаження логів:', error);
                document.getElementById('securityLogs').innerHTML = 
                    '<div class="alert alert-warning">Не вдалося завантажити історію безпеки</div>';
            }
        }

        function renderSecurityLogs(pagedResult) {
            const container = document.getElementById('securityLogs');
            const items = pagedResult.items || [];
            
            if (!items.length) {
                container.innerHTML = '<p class="text-muted">Немає записів у журналі безпеки.</p>';
                return;
            }

            let html = '<div class="table-responsive">';
            html += '<table class="table table-sm table-hover align-middle">';
            html += '<thead><tr>';
            html += '<th>Дата/Час</th><th>Тип івенту</th><th>Опис</th><th>Пристрій</th><th>IP адреса</th><th>Статус</th>';
            html += '</tr></thead><tbody>';

            items.forEach(log => {
                const date = new Date(log.createdAt);
                const formattedDate = date.toLocaleDateString('uk-UA') + ' ' + date.toLocaleTimeString('uk-UA');
                const statusBadge = log.status === 'Success' 
                    ? '<span class="badge bg-success">Успіх</span>'
                    : '<span class="badge bg-danger">Помилка</span>';
                
                let eventBadge = '';
                switch(log.eventType) {
                    case 'Login': eventBadge = '<span class="badge bg-info">Вхід</span>'; break;
                    case 'Logout': eventBadge = '<span class="badge bg-secondary">Вихід</span>'; break;
                    case 'PasswordChange': eventBadge = '<span class="badge bg-warning">Зміна пароля</span>'; break;
                    case 'SessionTerminated': eventBadge = '<span class="badge bg-danger">Сеанс завершено</span>'; break;
                    default: eventBadge = '<span class="badge bg-dark">' + log.eventType + '</span>';
                }
                
                html += '<tr>';
                html += '<td>' + formattedDate + '</td>';
                html += '<td>' + eventBadge + '</td>';
                html += '<td>' + log.description + '</td>';
                html += '<td>' + (log.deviceSummary || 'Unknown') + '</td>';
                html += '<td>' + (log.ipAddress || '—') + '</td>';
                html += '<td>' + statusBadge + '</td>';
                html += '</tr>';
            });

            html += '</tbody></table></div>';
            
            // Додаємо пагінацію інформацію
            if (pagedResult.totalPages > 1) {
                html += '<p class="text-muted small mt-3">Сторінка ' + pagedResult.pageNumber + ' з ' + pagedResult.totalPages + 
                        ' (' + pagedResult.totalCount + ' записів)</p>';
            }
            
            container.innerHTML = html;
        }

        // Завантажуємо журнал при завантаженні сторінки
        document.addEventListener('DOMContentLoaded', function() {
            loadSecurityLogs();
        });
    </script>
}
