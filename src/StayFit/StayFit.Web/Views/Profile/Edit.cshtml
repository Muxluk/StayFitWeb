@model StayFit.Application.DTOs.UserProfileDto
@using StayFit.Domain.Enums

@{
    ViewData["Title"] = "Редагувати профіль";
    var isSecurityTabActive = (bool)(ViewData["ShowSecurityTab"] ?? false);
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card profile-card shadow-lg mb-4">
                <div class="card-header profile-header p-4">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <div class="bg-white rounded-circle p-2 me-3 shadow-sm">
                                <i class="bi bi-person-circle fs-1 text-secondary"></i>
                            </div>
                            <div class="text-white">
                                <h2 class="fw-bold mb-0">Мій профіль</h2>
                                <p class="mb-0 opacity-75">Керуйте своїми персональними даними та безпекою</p>
                            </div>
                        </div>
                        <div id="auto-save-indicator" class="badge bg-success d-none py-2 px-3 shadow-sm">
                            Збережено ✔️
                        </div>
                    </div>
                </div>

                <div class="card-body p-0">
                    <ul class="nav nav-tabs profile-tabs px-4 pt-3 bg-light" id="profileTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="personal-tab" data-bs-toggle="tab" data-bs-target="#personal" type="button" role="tab">
                                <i class="bi bi-person-vcard me-2"></i>Особисті дані
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="security-tab" data-bs-toggle="tab" data-bs-target="#security" type="button" role="tab">
                                <i class="bi bi-shield-lock me-2"></i>Безпека
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content p-4 p-md-5" id="profileTabsContent">
                        <!-- Особисті дані -->
                        <div class="tab-pane fade show active" id="personal" role="tabpanel">
                            <form id="profileForm">
                                @Html.AntiForgeryToken()
                                <div class="row g-4">
                                    <div class="col-md-7">
                                        <h4 class="fw-bold mb-4 text-secondary border-bottom pb-2">Основна інформація</h4>
                                        
                                        <div class="form-floating mb-3 profile-focus">
                                            <input asp-for="FullName" id="FullName" class="form-control" placeholder="Ім'я та Прізвище" />
                                            <label asp-for="FullName">Повне ім'я</label>
                                        </div>

                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <div class="form-floating mb-3 profile-focus">
                                                    <input asp-for="DateOfBirth" id="DateOfBirth" type="date" class="form-control" />
                                                    <label asp-for="DateOfBirth">Дата народження</label>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-floating mb-3 profile-focus">
                                                    <select asp-for="Gender" id="Gender" class="form-select">
                                                        <option value="Чоловік">Чоловік</option>
                                                        <option value="Жінка">Жінка</option>
                                                        <option value="Інше">Інше</option>
                                                    </select>
                                                    <label asp-for="Gender">Стать</label>
                                                </div>
                                            </div>
                                        </div>

                                        <h4 class="fw-bold mt-4 mb-4 text-secondary border-bottom pb-2">Фізичні параметри</h4>
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <div class="form-floating mb-3 profile-focus">
                                                    <input asp-for="Weight" id="Weight" type="number" step="0.1" class="form-control" placeholder="0.0" />
                                                    <label asp-for="Weight">Вага (кг)</label>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-floating mb-3 profile-focus">
                                                    <input asp-for="Height" id="Height" type="number" step="0.1" class="form-control" placeholder="0.0" />
                                                    <label asp-for="Height">Зріст (см)</label>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-floating mb-3 profile-focus">
                                            <select asp-for="ActivityLevel" id="ActivityLevel" class="form-select">
                                                <option value="Sedentary">Малорухливий (сидяча робота)</option>
                                                <option value="LightlyActive">Помірно активний (1-3 тренування)</option>
                                                <option value="ModeratelyActive">Активний (3-5 тренувань)</option>
                                                <option value="VeryActive">Дуже активний (щоденно)</option>
                                                <option value="SuperActive">Екстремально активний (проф. спорт)</option>
                                            </select>
                                            <label asp-for="ActivityLevel">Рівень активності</label>
                                        </div>
                                    </div>

                                    <div class="col-md-5">
                                        <div class="card bg-light border-0 rounded-4 p-4 shadow-sm h-100">
                                            <h4 class="fw-bold mb-4 text-secondary text-center">Аналітика здоров'я</h4>
                                            
                                            <div class="text-center mb-4">
                                                <div class="bg-white d-inline-block rounded-circle p-4 shadow-sm mb-3">
                                                    <div class="h2 fw-bold text-primary mb-0" id="calc-bmi">-</div>
                                                    <div class="small text-muted">ІМТ</div>
                                                </div>
                                            </div>

                                            <div class="list-group list-group-flush bg-transparent">
                                                <div class="list-group-item bg-transparent d-flex justify-content-between align-items-center px-0">
                                                    <span>Базовий метаболізм (BMR)</span>
                                                    <span class="fw-bold text-primary" id="calc-bmr">- ккал</span>
                                                </div>
                                                <div class="list-group-item bg-transparent d-flex justify-content-between align-items-center px-0">
                                                    <span>Витрати енергії (TDEE)</span>
                                                    <span class="fw-bold text-success" id="calc-tdee">- ккал</span>
                                                </div>
                                            </div>
                                            
                                            <div class="mt-4 p-3 bg-white rounded-3 small text-muted border">
                                                <i class="bi bi-info-circle me-2"></i>
                                                Ці дані розраховуються автоматично на основі ваших параметрів. Вони допомагають системі краще підбирати норму калорій.
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>

                        <!-- Безпека -->
                        <div class="tab-pane fade" id="security" role="tabpanel" data-active="@isSecurityTabActive">
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                                        <div class="card-header security-header text-white py-3">
                                            <h5 class="mb-0"><i class="bi bi-shield-lock-fill me-2"></i>Зміна пароля</h5>
                                        </div>
                                        <div class="card-body p-4">
                                            <form method="post" action="/account-security/change-password">
                                                @Html.AntiForgeryToken()
                                                <div class="mb-3">
                                                    <label class="form-label">Поточний пароль</label>
                                                    <input type="password" name="OldPassword" class="form-control" required />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Новий пароль</label>
                                                    <input type="password" id="newPassword" name="NewPassword" class="form-control" required />
                                                </div>
                                                <div class="mb-4">
                                                    <label class="form-label">Підтвердіть новий пароль</label>
                                                    <input type="password" id="confirmPassword" class="form-control" required />
                                                </div>
                                                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">Оновити пароль</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                                        <div class="card-header sessions-header text-white py-3">
                                            <h5 class="mb-0"><i class="bi bi-laptop me-2"></i>Активні сеанси</h5>
                                        </div>
                                        <div class="card-body p-4">
                                            <p class="text-muted small mb-4">Ви можете вийти з усіх пристроїв, окрім поточного, якщо помітили підозрілу активність.</p>
                                            <form method="post" action="/account-security/terminate-other-sessions">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger w-100 py-2 fw-bold">
                                                    <i class="bi bi-box-arrow-right me-2"></i>Завершити інші сеанси
                                                </button>
                                            </form>
                                            
                                            <div class="mt-4 p-3 bg-light rounded-3 border">
                                                <div class="d-flex align-items-center text-success mb-2">
                                                    <i class="bi bi-check-circle-fill me-2"></i>
                                                    <span class="fw-bold">Поточний сеанс активний</span>
                                                </div>
                                                <small class="text-muted">Останній вхід: @DateTime.Now.ToString("dd.MM.yyyy HH:mm")</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 mt-4">
                                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                                        <div class="card-header profile-security-history-header py-3 d-flex justify-content-between align-items-center">
                                            <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Останні події безпеки</h5>
                                            <div class="d-flex gap-2">
                                                <select id="securityEventTypeFilter" class="form-select form-select-sm bg-white border-0" style="width: auto;">
                                                    <option value="">Всі типи</option>
                                                    <option value="Login">Вхід</option>
                                                    <option value="Logout">Вихід</option>
                                                    <option value="PasswordChange">Зміна пароля</option>
                                                    <option value="SessionTerminated">Завершення сеансу</option>
                                                </select>
                                                <button class="btn btn-sm btn-light border-0" onclick="loadSecurityLogs(1)" title="Оновити">
                                                    <i class="bi bi-arrow-clockwise"></i>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="card-body p-0">
                                            <div id="securityLogs" class="p-4 text-center">
                                                <div class="spinner-border text-primary" role="status">
                                                    <span class="visually-hidden">Завантаження...</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 mt-5">
                                    <div class="card border-danger border-opacity-25 rounded-4 overflow-hidden">
                                        <div class="card-header danger-header text-white py-3">
                                            <h5 class="mb-0"><i class="bi bi-trash3-fill me-2"></i>Видалення акаунту</h5>
                                        </div>
                                        <div class="card-body p-4 bg-danger bg-opacity-10">
                                            <div class="d-flex align-items-start gap-3">
                                                <i class="bi bi-exclamation-triangle fs-2 text-danger"></i>
                                                <div>
                                                    <h6 class="fw-bold text-danger">Видалення акаунту є незворотним!</h6>
                                                    <p class="text-muted small mb-3">Всі ваші дані, включаючи історію харчування, цілі та параметри, будуть назавжди видалені з системи.</p>
                                                    <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteAccountModal">
                                                        Видалити мій акаунт
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal для підтвердження видалення -->
<div class="modal fade" id="deleteAccountModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header danger-header">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill"></i> Підтвердження видалення акаунту</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/account-security/delete-account">
                @Html.AntiForgeryToken()

                <div class="modal-body">
                    <p>Ви впевнені, що хочете видалити свій акаунт?</p>
                    <p class="text-danger"><strong><i class="bi bi-exclamation-circle"></i> Ця дія не може бути скасована! Всі ваші дані (профіль, цілі, щоденники) будуть назавжди видалені.</strong></p>

                    <div class="mb-3 mt-4">
                        <label for="deletePassword" class="form-label">
                            Введіть ваш пароль для підтвердження
                        </label>
                        <input type="password" class="form-control" name="Password" id="deletePassword" placeholder="Ваш поточний пароль" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Скасувати</button>
                    <button type="submit" class="btn btn-danger">Видалити назавжди</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
}
