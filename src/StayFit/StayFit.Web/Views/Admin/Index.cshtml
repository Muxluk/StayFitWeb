@{
    ViewData["Title"] = "Адміністрування";
}

<div class="container mt-4">
    <h2 class="mb-4">Адміністрування</h2>
    <p class="text-muted">Оберіть розділ, у який потрібно перейти.</p>

    @{ 
        var adminUsersUrl = Url.Action("Index", "AdminUser");
        var adminCategoriesUrl = Url.Action("Index", "AdminCategory");
        var adminProductsUrl = Url.Action("Index", "AdminProduct");
        var adminStatisticsUrl = Url.Action("Index", "AdminStatistics");
        var adminSupportUrl = Url.Action("Index", "AdminSupport");
    }

    <div class="row g-3 mt-1">
        <div class="col-md-4">
            @await Html.PartialAsync("_Card", new CardViewModel
            {
                Title = "Керування користувачами",
                ColorClass = "primary",
                CardClass = "h-100",
                BodyHtml = $"<p class='card-text text-muted'>Пошук, перегляд і зміна стану акаунтів.</p><a href='{adminUsersUrl}' class='btn btn-outline-primary mt-auto'>Відкрити</a>"
            })
        </div>

        <div class="col-md-4">
            @await Html.PartialAsync("_Card", new CardViewModel
            {
                Title = "Керування продуктами",
                ColorClass = "primary",
                CardClass = "h-100",
                BodyHtml = $"<p class='card-text text-muted'>Робота з категоріями продуктів і базовими довідниками.</p><a href='{adminCategoriesUrl}' class='btn btn-outline-primary mt-auto'>Відкрити</a>"
            })
        </div>

        <div class="col-md-4">
            @await Html.PartialAsync("_Card", new CardViewModel
            {
                Title = "Модерація продуктів",
                ColorClass = "danger",
                CardClass = "h-100 border-danger",
                BodyHtml = $"<p class='card-text text-muted'>Підтвердження або відхилення нових продуктів.</p><a href='{adminProductsUrl}' class='btn btn-danger mt-auto'>Відкрити</a>"
            })
        </div>

        <div class="col-md-4">
            @await Html.PartialAsync("_Card", new CardViewModel
            {
                Title = "Статистика системи",
                ColorClass = "primary",
                CardClass = "h-100",
                BodyHtml = $"<p class='card-text text-muted'>Загальна інформація про роботу додатка та активність користувачів.</p><a href='{adminStatisticsUrl}' class='btn btn-outline-primary mt-auto'>Відкрити</a>"
            })
        </div>

        <div class="col-md-4">
            @await Html.PartialAsync("_Card", new CardViewModel
            {
                Title = "Звернення користувачів",
                ColorClass = "warning",
                CardClass = "h-100",
                BodyHtml = $"<p class='card-text text-muted'>Обробка запитів у підтримку, відповіді та статуси.</p><a href='{adminSupportUrl}' class='btn btn-outline-primary mt-auto'>Відкрити</a>"
            })
        </div>
    </div>
</div>