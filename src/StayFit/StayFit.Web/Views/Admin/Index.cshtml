@{
    ViewData["Title"] = "Адміністрування";
}

<div class="container mt-4">
    <h2 class="mb-4">Адміністрування</h2>
    <p class="text-muted">Оберіть розділ, у який потрібно перейти.</p>

    <div class="row g-3 mt-1">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Керування користувачами</h5>
                    <p class="card-text text-muted">Пошук, перегляд і зміна стану акаунтів.</p>
                    <a asp-controller="AdminUser" asp-action="Index" class="btn btn-outline-primary mt-auto">Відкрити</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Керування продуктами</h5>
                    <p class="card-text text-muted">Робота з категоріями продуктів і базовими довідниками.</p>
                    <a asp-controller="AdminCategory" asp-action="Index" class="btn btn-outline-primary mt-auto">Відкрити</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-danger">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title text-danger">Модерація продуктів</h5>
                    <p class="card-text text-muted">Підтвердження або відхилення нових продуктів.</p>
                    <a asp-controller="AdminProduct" asp-action="Index" class="btn btn-danger mt-auto">Відкрити</a>
                </div>
            </div>
        </div>
    </div>
</div>
