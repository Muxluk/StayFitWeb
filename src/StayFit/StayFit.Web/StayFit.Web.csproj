<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UserSecretsId>StayFit.Web-1f312ad7-7ce3-4137-a9b3-7874b34126f8</UserSecretsId>
    <StaticWebAssetFingerprintingEnabled>false</StaticWebAssetFingerprintingEnabled>
    <!-- Виключаємо згенеровані файли з початкового сканування, щоб уникнути дублікатів -->
    <DefaultItemExcludes>$(DefaultItemExcludes);wwwroot/js/bundle.min.js;wwwroot/css/bundle.min.css</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StayFit.Application\StayFit.Application.csproj" />
    <ProjectReference Include="..\StayFit.Infrastructure\StayFit.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\css\bundle.min.css">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="wwwroot\js\bundle.min.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.2" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.Seq" Version="6.0.0" />
    <PackageReference Include="BuildBundlerMinifier" Version="3.2.449" />
  </ItemGroup>

  <Target Name="BundleAssetsBeforePublish" BeforeTargets="PrepareForPublish" DependsOnTargets="BundleMinify" />

  <Target Name="CopyBundledAssetsToPublish" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)wwwroot\css;$(PublishDir)wwwroot\js" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\wwwroot\css\bundle.min.css"
          DestinationFolder="$(PublishDir)wwwroot\css"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\wwwroot\js\bundle.min.js"
          DestinationFolder="$(PublishDir)wwwroot\js"
          SkipUnchangedFiles="true" />
  </Target>

</Project>